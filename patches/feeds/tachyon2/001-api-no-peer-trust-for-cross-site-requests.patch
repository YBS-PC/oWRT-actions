+/// True when a browser sends the request on behalf of a page from another
+/// site, or by a host name that does not belong to the router. Such a request
+/// is not trusted by the peer address (LAN, loopback or Tailscale): the page
+/// runs in a browser of a LAN client, and the address is that client's.
+/// - `Sec-Fetch-Site: cross-site`: the page is from another site.
+/// - `Origin` that is `null` or another host and port than `Host`.
+/// - `Host` that is a domain name outside the local names (IP literal,
+///   `localhost`, a single label, `.lan`, `.local`, `.home.arpa`,
+///   `.internal`, `.ts.net`): a name that resolves to the router after the
+///   page was loaded (DNS rebinding).
+///
+/// Requests without these headers (the CLI, curl, scripts) are not affected.
+fn is_foreign_browser_request(head: &str, host_hdr: Option<&str>) -> bool {
+    if parse_header(head, "sec-fetch-site")
+        .is_some_and(|v| v.trim().eq_ignore_ascii_case("cross-site"))
+    {
+        return true;
+    }
+    let host = host_hdr
+        .map(|h| h.trim().to_ascii_lowercase())
+        .unwrap_or_default();
+    if let Some(origin) = parse_header(head, "origin") {
+        let origin = origin.trim().to_ascii_lowercase();
+        let Some(rest) = origin
+            .strip_prefix("http://")
+            .or_else(|| origin.strip_prefix("https://"))
+        else {
+            return true;
+        };
+        let origin_host = rest.split('/').next().unwrap_or("");
+        let default_port = if origin.starts_with("https://") {
+            ":443"
+        } else {
+            ":80"
+        };
+        let same = origin_host == host
+            || format!("{origin_host}{default_port}") == host
+            || origin_host == format!("{host}{default_port}");
+        if !same {
+            return true;
+        }
+    }
+    if host.is_empty() {
+        return false;
+    }
+    if let Some(v6) = host.strip_prefix('[') {
+        let addr = v6.split(']').next().unwrap_or("");
+        return addr.parse::<std::net::Ipv6Addr>().is_err();
+    }
+    let name = host.rsplit_once(':').map_or(host.as_str(), |(h, _)| h);
+    let name = name.trim_end_matches('.');
+    if name.parse::<std::net::Ipv4Addr>().is_ok() || name == "localhost" || !name.contains('.') {
+        return false;
+    }
+    ![".lan", ".local", ".home.arpa", ".internal", ".ts.net"]
+        .iter()
+        .any(|sfx| name.ends_with(sfx))
+}
