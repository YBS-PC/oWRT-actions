     use super::*;
 
+    #[test]
+    fn test_foreign_browser_request() {
+        let req = |hdrs: &str| format!("POST /ubus HTTP/1.1\r\n{hdrs}\r\n");
+        // CLI, curl and the panel itself
+        assert!(!is_foreign_browser_request(
+            &req("Host: 127.0.0.1:1680\r\n"),
+            Some("127.0.0.1:1680")
+        ));
+        assert!(!is_foreign_browser_request(&req(""), None));
+        assert!(!is_foreign_browser_request(
+            &req(
+                "Host: 192.168.1.1:1680\r\nOrigin: http://192.168.1.1:1680\r\nSec-Fetch-Site: same-origin\r\n"
+            ),
+            Some("192.168.1.1:1680")
+        ));
+        assert!(!is_foreign_browser_request(
+            &req("Host: [fd00::1]:1680\r\n"),
+            Some("[fd00::1]:1680")
+        ));
+        assert!(!is_foreign_browser_request(
+            &req("Host: OpenWrt:1680\r\n"),
+            Some("OpenWrt:1680")
+        ));
+        assert!(!is_foreign_browser_request(
+            &req("Host: openwrt.lan:1680\r\n"),
+            Some("openwrt.lan:1680")
+        ));
+        assert!(!is_foreign_browser_request(
+            &req("Host: 192.168.1.1\r\nOrigin: http://192.168.1.1\r\n"),
+            Some("192.168.1.1")
+        ));
+        // LuCI on port 80 of the same address opens the panel: same-site
+        assert!(!is_foreign_browser_request(
+            &req("Host: 192.168.1.1:1680\r\nSec-Fetch-Site: same-site\r\n"),
+            Some("192.168.1.1:1680")
+        ));
+        // A page of another site in a LAN browser
+        assert!(is_foreign_browser_request(
+            &req(
+                "Host: 192.168.1.1:1680\r\nOrigin: https://example.com\r\nSec-Fetch-Site: cross-site\r\n"
+            ),
+            Some("192.168.1.1:1680")
+        ));
+        assert!(is_foreign_browser_request(
+            &req("Host: 192.168.1.1:1680\r\nOrigin: https://example.com\r\n"),
+            Some("192.168.1.1:1680")
+        ));
+        assert!(is_foreign_browser_request(
+            &req("Host: 192.168.1.1:1680\r\nOrigin: null\r\n"),
+            Some("192.168.1.1:1680")
+        ));
+        assert!(is_foreign_browser_request(
+            &req("Host: 192.168.1.1:1680\r\nSec-Fetch-Site: cross-site\r\n"),
+            Some("192.168.1.1:1680")
+        ));
+        // DNS rebinding: Origin and Host are the same foreign name
+        assert!(is_foreign_browser_request(
+            &req(
+                "Host: rebind.example.com:1680\r\nOrigin: http://rebind.example.com:1680\r\nSec-Fetch-Site: same-origin\r\n"
+            ),
+            Some("rebind.example.com:1680")
+        ));
+        assert!(is_foreign_browser_request(
+            &req("Host: [::ffff:x]:1680\r\n"),
+            Some("[::ffff:x]:1680")
+        ));
+    }
+
