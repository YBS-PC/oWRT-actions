+#######################################
+# Facts about the router that silently break the redirect: flow offloading
+# (established flows skip the netfilter hooks that carry podkop marks), a clock
+# far from the real time (TLS and Reality fail), a global IPv6 address (podkop
+# handles IPv4 only, IPv6 connections go around the tunnel).
+# Outputs a JSON object. The only network access is one HEAD request, to compare
+# the clock; without internet the skew is null.
+#######################################
+check_environment() {
+    local flow_software flow_hardware flow_active now plausible remote_date remote_epoch skew
+    local zone ntp_enabled ipv6_global
+
+    flow_software="$(uci -q get firewall.@defaults[0].flow_offloading)"
+    flow_hardware="$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
+    flow_active=0
+    nft list flowtables 2> /dev/null | grep -q 'flowtable' && flow_active=1
+
+    now="$(date +%s)"
+    plausible=1
+    [ "$now" -ge "$ENVIRONMENT_MIN_PLAUSIBLE_EPOCH" ] || plausible=0
+    skew=""
+    remote_date="$(curl -sI -m 5 "$ENVIRONMENT_CLOCK_PROBE_URL" 2> /dev/null |
+        sed -n 's/^[Dd]ate:[[:space:]]*//p' | tr -d '\r' | sed -n '1p')"
+    if [ -n "$remote_date" ]; then
+        remote_epoch="$(http_date_to_epoch "$remote_date")"
+        [ -n "$remote_epoch" ] && skew=$((remote_epoch - now))
+    fi
+    zone="$(uci -q get system.@system[0].zonename)"
+    [ -n "$zone" ] || zone="$(uci -q get system.@system[0].timezone)"
+    ntp_enabled="$(uci -q get system.ntp.enabled)"
+    [ "$ntp_enabled" = "0" ] || ntp_enabled=1
+
+    ipv6_global=0
+    if ip -6 addr show scope global 2> /dev/null | grep 'inet6' | grep -vqE 'inet6 f[cd]'; then
+        ipv6_global=1
+    fi
+
+    jq -n \
+        --argjson flow_software "$([ "$flow_software" = "1" ] && echo true || echo false)" \
+        --argjson flow_hardware "$([ "$flow_hardware" = "1" ] && echo true || echo false)" \
+        --argjson flow_active "$([ "$flow_active" -eq 1 ] && echo true || echo false)" \
+        --argjson plausible "$([ "$plausible" -eq 1 ] && echo true || echo false)" \
+        --arg skew "$skew" \
+        --arg zone "$zone" \
+        --argjson ntp "$([ "$ntp_enabled" = "1" ] && echo true || echo false)" \
+        --argjson ipv6_global "$([ "$ipv6_global" -eq 1 ] && echo true || echo false)" \
+        '{
+            flow_offloading: {software: $flow_software, hardware: $flow_hardware, active: $flow_active},
+            clock: {plausible: $plausible, skew_seconds: (if $skew == "" then null else ($skew | tonumber) end),
+                    ntp_enabled: $ntp, timezone: $zone},
+            ipv6: {router_has_global: $ipv6_global}
+        }'
+}
