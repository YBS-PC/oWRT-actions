+# Converts an HTTP Date header value ("Sun, 04 Oct 2026 09:13:05 GMT") to epoch
+# seconds; prints nothing when it cannot be parsed. busybox date does not read
+# this format, so the fields are rearranged for `date -u -d`.
+http_date_to_epoch() {
+    local month_number
+
+    # shellcheck disable=SC2046
+    set -- $(printf '%s' "$1" | tr -d ',')
+    [ "$#" -ge 5 ] || return 1
+
+    case "$3" in
+    Jan) month_number=01 ;;
+    Feb) month_number=02 ;;
+    Mar) month_number=03 ;;
+    Apr) month_number=04 ;;
+    May) month_number=05 ;;
+    Jun) month_number=06 ;;
+    Jul) month_number=07 ;;
+    Aug) month_number=08 ;;
+    Sep) month_number=09 ;;
+    Oct) month_number=10 ;;
+    Nov) month_number=11 ;;
+    Dec) month_number=12 ;;
+    *) return 1 ;;
+    esac
+
+    case "$4$2" in
+    *[!0-9]*) return 1 ;;
+    esac
+
+    date -u -d "$4-$month_number-$2 $5" +%s 2> /dev/null
+}
