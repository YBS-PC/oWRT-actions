diff --git a/podkop/files/usr/lib/helpers.sh b/podkop/files/usr/lib/helpers.sh
index 685c734..0abf9ee 100644
--- a/podkop/files/usr/lib/helpers.sh
+++ b/podkop/files/usr/lib/helpers.sh
@@ -463,3 +463,21 @@ http_date_to_epoch() {
 
     date -u -d "$4-$month_number-$2 $5" +%s 2> /dev/null
 }
+
+# A section with `option disabled '1'` is left out completely: no outbound,
+# routing, lists, cron job, mixed proxy or dashboard entry, but its settings
+# stay in UCI. Called right after config_load: it removes such sections from
+# the list config_foreach walks, so every per-section loop skips them.
+drop_disabled_sections() {
+    local section type disabled kept=""
+
+    for section in $CONFIG_SECTIONS; do
+        config_get type "$section" TYPE
+        if [ "$type" = "section" ]; then
+            config_get_bool disabled "$section" "disabled" 0
+            [ "$disabled" -eq 1 ] && continue
+        fi
+        kept="$kept $section"
+    done
+    CONFIG_SECTIONS="${kept# }"
+}
