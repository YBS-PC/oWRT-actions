+# Adds the outbound of one proxy link. An unusable link (unknown scheme, a
+# link the facade cannot decode) leaves $config as it was and returns 1: the
+# facade exits inside the command substitution, which used to empty $config.
+add_link_outbound() {
+    local new_config
+
+    new_config=$(sing_box_cf_add_proxy_outbound "$config" "$1" "$2" "$3") && [ -n "$new_config" ] || return 1
+    config="$new_config"
+}
+
+# A section left without an outbound (an empty or unusable link, no VPN
+# interface) does not stop podkop: the other sections keep working, and the
+# traffic of this one is rejected rather than sent around the tunnel.
+mark_section_unavailable() {
+    log "Section '$1' is not working: $2. Its traffic is blocked until the section is fixed" "error"
+    case " $PODKOP_UNAVAILABLE_SECTIONS " in
+    *" $1 "*) ;;
+    *) PODKOP_UNAVAILABLE_SECTIONS="$PODKOP_UNAVAILABLE_SECTIONS $1" ;;
+    esac
+}
+
+section_is_unavailable() {
+    case " $PODKOP_UNAVAILABLE_SECTIONS " in
+    *" $1 "*) return 0 ;;
+    esac
+    return 1
+}
+
 sing_box_configure_dns() {
