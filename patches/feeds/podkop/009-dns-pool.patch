+const validServers = [
+  'udp://8.8.8.8',
+  'udp://8.8.8.8:5353',
+  'tcp://1.1.1.1',
+  'dot://dns.quad9.net',
+  'dot://dns.quad9.net:853',
+  'doh://dns.google/dns-query',
+  'doh://Dns.Google/dns-query',
+  'doh://1.1.1.1:443/dns-query',
+  'doh3://cloudflare-dns.com/dns-query',
+  'doq://dns.adguard-dns.com',
+];
+
+const invalidServers = [
+  '',
+  '8.8.8.8',
+  'dns.google',
+  'smtp://8.8.8.8',
+  'DOH://dns.google/dns-query',
+  'udp://8.8.8.8/path',
+  'dot://dns.quad9.net/dns-query',
+  'udp://8.8.8.8:0',
+  'udp://8.8.8.8:65536',
+  'udp://',
+  'udp://8.8.8.8 ',
+  'doh://dns google/dns-query',
+  'udp://-bad-.com',
+];
+
+describe('validateDnsPoolServer', () => {
+  it.each(validServers)('accepts %s', (value) => {
+    expect(validateDnsPoolServer(value).valid).toBe(true);
+  });
+
+  it.each(invalidServers)('rejects "%s"', (value) => {
+    expect(validateDnsPoolServer(value).valid).toBe(false);
+  });
+
+  it.each(Object.keys(DNS_POOL_PRESETS))('accepts the preset %s', (value) => {
+    expect(validateDnsPoolServer(value).valid).toBe(true);
+  });
+
+  it('has a preset for every scheme', () => {
+    const schemes = new Set(
+      Object.keys(DNS_POOL_PRESETS).map((value) => value.split('://')[0]),
+    );
+    expect([...schemes].sort()).toEqual(
+      ['doh', 'doh3', 'doq', 'dot', 'tcp', 'udp'].sort(),
+    );
+  });
+});
+
+describe('validateDnsPoolTimeout', () => {
+  it.each(['500ms', '2s', '10s', '1500ms'])('accepts %s', (value) => {
+    expect(validateDnsPoolTimeout(value).valid).toBe(true);
+  });
+
+  it.each(['', '0s', '2', 's', '1.5s', '2m', ' 2s', '-1s'])(
+    'rejects "%s"',
+    (value) => {
+      expect(validateDnsPoolTimeout(value).valid).toBe(false);
+    },
+  );
+});
diff --git a/fe-app-podkop/src/validators/validateDnsPool.ts b/fe-app-podkop/src/validators/validateDnsPool.ts
new file mode 100644
index 0000000..60d05bc
--- /dev/null
+++ b/fe-app-podkop/src/validators/validateDnsPool.ts
@@ -0,0 +1,56 @@
+import { validateDNS } from './validateDns';
+import { ValidationResult } from './types';
+
+const DNS_POOL_SCHEMES = ['udp', 'tcp', 'dot', 'doh', 'doh3', 'doq'];
+const DNS_POOL_PATH_SCHEMES = ['doh', 'doh3'];
+
+// One of the additional DNS servers: scheme://host[:port][/path]
+export function validateDnsPoolServer(value: string): ValidationResult {
+  const separator = value.indexOf('://');
+
+  if (separator < 0 || /\s/.test(value)) {
+    return {
+      valid: false,
+      message: _(
+        'Use scheme://host[:port][/path], where scheme is udp, tcp, dot, doh, doh3 or doq. Example: doh://dns.google/dns-query',
+      ),
+    };
+  }
+
+  const scheme = value.slice(0, separator);
+  const rest = value.slice(separator + 3);
+
+  if (!DNS_POOL_SCHEMES.includes(scheme)) {
+    return {
+      valid: false,
+      message: _('Unknown DNS scheme. Use udp, tcp, dot, doh, doh3 or doq'),
+    };
+  }
+
+  if (!DNS_POOL_PATH_SCHEMES.includes(scheme) && rest.includes('/')) {
+    return {
+      valid: false,
+      message: _('A path is only allowed for doh and doh3'),
+    };
+  }
+
+  const port = rest.match(/:(\d+)(?=\/|$)/)?.[1];
+
+  if (port !== undefined && (Number(port) < 1 || Number(port) > 65535)) {
+    return { valid: false, message: _('Port must be between 1 and 65535') };
+  }
+
+  return validateDNS(rest.toLowerCase());
+}
+
+// How long one DNS server of the pool may take: 500ms, 2s
+export function validateDnsPoolTimeout(value: string): ValidationResult {
+  if (/^[1-9][0-9]*(ms|s)$/.test(value)) {
+    return { valid: true, message: _('Valid') };
+  }
+
+  return {
+    valid: false,
+    message: _('Invalid timeout. Examples: 500ms, 2s'),
+  };
+}
