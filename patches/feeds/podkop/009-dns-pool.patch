diff --git a/podkop/files/usr/bin/podkop b/podkop/files/usr/bin/podkop
index a5a358c..d54bd3b 100755
--- a/podkop/files/usr/bin/podkop
+++ b/podkop/files/usr/bin/podkop
@@ -908,6 +908,146 @@ sing_box_configure_dns() {
     config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "query_type" '["A","AAAA"]')
     service_domains=$(comma_string_to_json_array "$FAKEIP_TEST_DOMAIN,$CHECK_PROXY_IP_DOMAIN")
     config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "domain" "$service_domains")
+
+    # last: the pool answers the queries no rule above took
+    sing_box_configure_dns_pool
+}
+
+# Extra DNS servers next to the main one (list dns_pool_server
+# 'scheme://host[:port][/path]', scheme udp, tcp, dot, doh, doh3 or doq), used as
+# dns_pool_mode says:
+#   single   (default) the main server only, as before;
+#   fallback in order, the main server first: the next one is asked when the
+#            previous one fails, times out or answers other than NOERROR/NXDOMAIN;
+#   race     all of them at once, the first NOERROR/NXDOMAIN answer wins.
+# Domains of FakeIP and exclusion sections are not affected. Built from the
+# evaluate/respond DNS rules of sing-box 1.14.
+sing_box_configure_dns_pool() {
+    local mode version timeout last_tag index tag rcode
+
+    config_get mode "settings" "dns_pool_mode" "single"
+    case "$mode" in
+    fallback | race) ;;
+    *) return 0 ;;
+    esac
+
+    version="$(sing-box version 2> /dev/null | head -n 1 | awk '{print $3}')"
+    if ! is_min_package_version "${version%%-*}" "$SB_DNS_POOL_REQUIRED_VERSION"; then
+        log "Several DNS servers need sing-box $SB_DNS_POOL_REQUIRED_VERSION or newer (installed: $version), only the main DNS server is used" "warn"
+        return 0
+    fi
+
+    _dns_pool_tags="$SB_DNS_SERVER_TAG"
+    _dns_pool_count=1
+    config_list_foreach "settings" "dns_pool_server" _add_dns_pool_server
+    if [ "$_dns_pool_count" -eq 1 ]; then
+        log "No usable additional DNS server is set, only the main DNS server is used" "warn"
+        return 0
+    fi
+
+    config_get timeout "settings" "dns_pool_timeout" "$DNS_POOL_TIMEOUT_DEFAULT"
+    if ! echo "$timeout" | grep -qE '^[1-9][0-9]*(ms|s)$'; then
+        log "Invalid DNS server timeout '$timeout', $DNS_POOL_TIMEOUT_DEFAULT is used" "warn"
+        timeout="$DNS_POOL_TIMEOUT_DEFAULT"
+    fi
+    log "DNS servers: $_dns_pool_count, mode $mode, $timeout per query"
+
+    last_tag="${_dns_pool_tags##* }"
+    index=0
+    for tag in $_dns_pool_tags; do
+        index=$((index + 1))
+        [ "$mode" = "fallback" ] && [ "$tag" = "$last_tag" ] && break
+        config=$(sing_box_cm_add_dns_evaluate_rule "$config" "$tag" "$SB_DNS_POOL_RESPONSE_PREFIX$index" "$timeout")
+        [ "$mode" = "fallback" ] || continue
+        for rcode in NOERROR NXDOMAIN; do
+            config=$(sing_box_cm_add_dns_respond_rule "$config" "$SB_DNS_POOL_RESPONSE_PREFIX$index" "$rcode")
+        done
+    done
+
+    if [ "$mode" = "fallback" ]; then
+        # the last server answers whatever is left, errors included
+        config=$(sing_box_cm_set_dns_final "$config" "$last_tag")
+        return 0
+    fi
+    for rcode in NOERROR NXDOMAIN; do
+        index=0
+        for tag in $_dns_pool_tags; do
+            index=$((index + 1))
+            config=$(sing_box_cm_add_dns_respond_rule "$config" "$SB_DNS_POOL_RESPONSE_PREFIX$index" "$rcode" true)
+        done
+    done
+}
+
+# config_list_foreach callback: adds one dns_pool_server, skipping a broken one
+_add_dns_pool_server() {
+    local entry="$1"
+    local type server authority resolver tag
+
+    type="${entry%%://*}"
+    server="${entry#*://}"
+    authority="${server%%/*}"
+    server="$(echo "$authority" | tr 'A-Z' 'a-z')${server#"$authority"}"
+    if ! dns_pool_entry_is_valid "$type://$server"; then
+        log "DNS server '$entry' is skipped: expected scheme://host[:port][/path], the scheme is udp, tcp, dot, doh, doh3 or doq" "warn"
+        return 0
+    fi
+    if [ "$_dns_pool_count" -ge "$DNS_POOL_MAX_SERVERS" ]; then
+        log "DNS server '$entry' is skipped: at most $DNS_POOL_MAX_SERVERS DNS servers are used" "warn"
+        return 0
+    fi
+    if ! sing_box_supports_dns_type "$type"; then
+        log "DNS server '$entry' is skipped: the installed sing-box is built without $type" "warn"
+        return 0
+    fi
+
+    _dns_pool_count=$((_dns_pool_count + 1))
+    tag="$SB_DNS_SERVER_TAG-$_dns_pool_count"
+    resolver="$SB_BOOTSTRAP_SERVER_TAG"
+    is_ipv4 "$(url_get_host "$server")" && resolver=""
+    config=$(sing_box_cf_add_dns_server "$config" "$type" "$tag" "$server" "$resolver")
+    _dns_pool_tags="$_dns_pool_tags $tag"
+}
+
+# doh3 and doq need sing-box built with QUIC: podkop-engine is not, for one
+sing_box_supports_dns_type() {
+    local type file
+
+    case "$1" in
+    doh3) type="h3" ;;
+    doq) type="quic" ;;
+    *) return 0 ;;
+    esac
+    file="$(mktemp)"
+    echo "{\"dns\":{\"servers\":[{\"type\":\"$type\",\"tag\":\"t\",\"server\":\"127.0.0.1\"}]}}" > "$file"
+    sing-box check -c "$file" > /dev/null 2>&1
+    set -- $?
+    rm -f "$file"
+    return "$1"
+}
+
+# scheme://host[:port][/path], a path only for doh and doh3
+dns_pool_entry_is_valid() {
+    local scheme="${1%%://*}"
+    local server="${1#*://}"
+    local host port
+
+    [ "$server" != "$1" ] || return 1
+    case "$scheme:$server" in
+    *[[:space:]]*) return 1 ;;
+    doh:* | doh3:*) ;;
+    udp:*/* | tcp:*/* | dot:*/* | doq:*/*) return 1 ;;
+    udp:* | tcp:* | dot:* | doq:*) ;;
+    *) return 1 ;;
+    esac
+
+    host="$(url_get_host "$server")"
+    port="$(url_get_port "$server")"
+    is_ipv4 "$host" || is_domain "$host" || return 1
+    case "$port" in
+    "") ;;
+    *[!0-9]*) return 1 ;;
+    *) [ "$port" -ge 1 ] && [ "$port" -le 65535 ] ;;
+    esac
 }
 
