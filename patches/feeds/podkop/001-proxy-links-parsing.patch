@@ -0,0 +1,46 @@
+/**
+ * Splits the "host:port" part of a proxy link (the text between the last
+ * "@" and the query string). Accepts IPv6 literals in brackets
+ * ("[2001:db8::1]:443") and ignores a trailing path ("host:443/").
+ */
+export function parseHostPort(hostPortPart: string): {
+  host: string;
+  port: string;
+} {
+  const authority = hostPortPart.split('/')[0];
+
+  if (authority.startsWith('[')) {
+    const end = authority.indexOf(']');
+
+    if (end === -1) return { host: '', port: '' };
+
+    const host = authority.slice(1, end);
+    const rest = authority.slice(end + 1);
+
+    return { host, port: rest.startsWith(':') ? rest.slice(1) : '' };
+  }
+
+  const colon = authority.lastIndexOf(':');
+
+  if (colon === -1) return { host: authority, port: '' };
+
+  return { host: authority.slice(0, colon), port: authority.slice(colon + 1) };
+}
+
+/**
+ * Splits "userinfo@host:port" on the LAST "@": a password may contain an
+ * unescaped "@", the host never does.
+ */
+export function splitUserHost(userHostPort: string): {
+  userPart: string;
+  hostPortPart: string;
+} {
+  const at = userHostPort.lastIndexOf('@');
+
+  if (at === -1) return { userPart: '', hostPortPart: '' };
+
+  return {
+    userPart: userHostPort.slice(0, at),
+    hostPortPart: userHostPort.slice(at + 1),
+  };
+}
