index 0000000..36adf71
--- /dev/null
+++ b/fe-app-podkop/src/validators/unsupportedTransports.ts
@@ -0,0 +1,20 @@
+// Xray transports that sing-box (and therefore podkop) cannot use.
+// A link with one of them would produce an outbound that never connects.
+export const UNSUPPORTED_TRANSPORTS = [
+  'xhttp',
+  'splithttp',
+  'kcp',
+  'mkcp',
+  'quic',
+  'udp',
+];
+
+export const SUPPORTED_TRANSPORTS = [
+  'tcp',
+  'raw',
+  'ws',
+  'grpc',
+  'httpupgrade',
+  'http',
+  'h2',
+];
