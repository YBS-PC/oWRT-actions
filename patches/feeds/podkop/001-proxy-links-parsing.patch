+#######################################
+# Set HTTPUpgrade transport settings for an outbound in a sing-box JSON configuration.
+# Arguments:
+#   config: string (JSON), sing-box configuration to modify
+#   tag: string, identifier of the outbound to modify
+#   path: string, HTTP request path (optional)
+#   host: string, Host header (optional)
+# Outputs:
+#   Writes updated JSON configuration to stdout
+# Example:
+#   CONFIG=$(sing_box_cm_set_httpupgrade_transport_for_outbound "$CONFIG" "vless-out" "/path" "example.com")
+#######################################
+sing_box_cm_set_httpupgrade_transport_for_outbound() {
+    local config="$1"
+    local tag="$2"
+    local path="$3"
+    local host="$4"
+
+    echo "$config" | jq \
+        --arg tag "$tag" \
+        --arg path "$path" \
+        --arg host "$host" \
+        '.outbounds |= map(
+            if .tag == $tag then
+                . + {
+                    transport: (
+                        { type: "httpupgrade" }
+                        + (if $path != "" then {path: $path} else {} end)
+                        + (if $host != "" then {host: $host} else {} end)
+                    )
+                }
+            else
+                .
+            end
+        )'
+}
+
+#######################################
+# Set HTTP (h2) transport settings for an outbound in a sing-box JSON configuration.
+# Arguments:
+#   config: string (JSON), sing-box configuration to modify
+#   tag: string, identifier of the outbound to modify
+#   path: string, HTTP request path (optional)
+#   host: string, comma-separated list of hosts (optional)
+# Outputs:
+#   Writes updated JSON configuration to stdout
+# Example:
+#   CONFIG=$(sing_box_cm_set_http_transport_for_outbound "$CONFIG" "vless-out" "/path" "example.com")
+#######################################
+sing_box_cm_set_http_transport_for_outbound() {
+    local config="$1"
+    local tag="$2"
+    local path="$3"
+    local host="$4"
+
+    echo "$config" | jq \
+        --arg tag "$tag" \
+        --arg path "$path" \
+        --arg host "$host" \
+        '.outbounds |= map(
+            if .tag == $tag then
+                . + {
+                    transport: (
+                        { type: "http" }
+                        + (if $path != "" then {path: $path} else {} end)
+                        + (if $host != "" then {host: ($host | split(",") | map(select(. != "")))} else {} end)
+                    )
+                }
+            else
+                .
+            end
+        )'
+}
