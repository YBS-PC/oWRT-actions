--- a/trafira/files/usr/lib/subscription/parser.uc
+++ b/trafira/files/usr/lib/subscription/parser.uc
@@ -699,7 +699,9 @@ function add_transport(url) {
         return result;
     }
 
-    return null;
+    // kcp, quic and the like: sing-box has no such transport, and the node
+    // without it would only fail to connect
+    return false;
 }
 
 function valid_port(port) {
@@ -798,6 +800,8 @@ function process_vless(raw, url) {
         outbound.tls = tls_result[0];
 
     let transport = add_transport(url);
+    if (transport === false)
+        return null;
     if (transport)
         outbound.transport = transport;
     return outbound;
@@ -823,6 +827,8 @@ function process_trojan(raw, url) {
         outbound.tls = tls_result[0];
 
     let transport = add_transport(url);
+    if (transport === false)
+        return null;
     if (transport)
         outbound.transport = transport;
     return outbound;
