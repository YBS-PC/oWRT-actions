From: YBS-PC/oWRT-actions
Subject: [PATCH] trafira: битая ссылка не останавливает trafira, секция без
 выходов — блок

По мотивам podkop 008 / netshift #95. Раньше любая непригодная ручная
ссылка в секции — неизвестная схема (http://), неверные порты Hysteria2,
пустой пароль, XHTTP без sing-box-extended — завершала генератор (exit 2),
и trafira не запускался целиком, а секция, у которой не осталось ни
одного выхода (в том числе подписка только из XHTTP-узлов), давала то же.
Теперь:
- непригодная ручная ссылка пропускается с ошибкой в журнале («skipped
  manual link N 'имя' of section '…': причина»), остальные ссылки секции
  работают;
- секция «подключение» без единого рабочего выхода становится секцией
  «блок»: её списки получают reject (трафик не уходит мимо туннеля),
  mixed-прокси не создаётся, в журнале «section '…' is not working … its
  traffic is blocked»; все остальные секции и весь trafira работают;
- транспорт kcp/quic и прочие неизвестные в ручной ссылке — тоже пропуск
  (раньше предупреждение и нерабочий узел без транспорта); в подписках
  такой узел пропускается, а не создаётся без транспорта.
Ошибки в настройках самой секции (priority-группа без extended, JSON
outbound с XHTTP и т. п.) по-прежнему останавливают генерацию, как у
автора. Тесты manual_hysteria2_ports и sing_box_runtime приведены к новому
поведению; весь набор тестов trafira: 102 из 103 (installer_owner падает и
без патча — сторожевой таймер установщика в контейнере).
---
diff --git a/tests/manual_hysteria2_ports.sh b/tests/manual_hysteria2_ports.sh
index 98a06099..1aac090a 100644
--- a/tests/manual_hysteria2_ports.sh
+++ b/tests/manual_hysteria2_ports.sh
@@ -38,12 +38,22 @@ for (const name of ['range','authority','single']) {
   assert.equal(outbound.tls.enabled, true);
 }
 NODE
+# An invalid link is skipped; its section, left without outbounds, is blocked.
 for name in invalid zero huge empty; do
-  if ucode -L "$LIB" "$LIB/singbox/generator.uc" generate-config-fixture \
-    "$WORK_DIR/$name.json" "$WORK_DIR/$name.out" 127.0.0.1 0 >"$WORK_DIR/error" 2>&1; then
+  ucode -L "$LIB" "$LIB/singbox/generator.uc" generate-config-fixture \
+    "$WORK_DIR/$name.json" "$WORK_DIR/$name.out" 127.0.0.1 0 >"$WORK_DIR/error" 2>&1 || {
+    printf 'FAIL: invalid Hysteria2 ports stopped the generator: %s\n' "$name" >&2
+    exit 1
+  }
+  grep -Fq 'manual Hysteria2 proxy link is invalid' "$WORK_DIR/error"
+  if jq -e '.outbounds[] | select(.type == "hysteria2")' "$WORK_DIR/$name.out" >/dev/null; then
     printf 'FAIL: invalid Hysteria2 ports accepted: %s\n' "$name" >&2
     exit 1
   fi
-  grep -Fq 'manual Hysteria2 proxy link is invalid' "$WORK_DIR/error"
+  jq -e '.route.rules[] | select(.action == "reject" and (.domain_suffix | index("example.org")))' \
+    "$WORK_DIR/$name.out" >/dev/null || {
+    printf 'FAIL: section with invalid Hysteria2 ports is not blocked: %s\n' "$name" >&2
+    exit 1
+  }
 done
 printf 'Manual Hysteria2 port hopping checks passed\n'
diff --git a/tests/sing_box_runtime.sh b/tests/sing_box_runtime.sh
index 89c3ba7a..f6cc4184 100644
--- a/tests/sing_box_runtime.sh
+++ b/tests/sing_box_runtime.sh
@@ -1078,12 +1078,18 @@ generate_config "$WORK_DIR/server-inbound-fixture.json" "$WORK_DIR/server.json"
 generate_config "$WORK_DIR/runtime-matchers-fixture.json" "$WORK_DIR/matchers.json"
 generate_config "$WORK_DIR/dns-action-fixture.json" "$WORK_DIR/dns-action.json"
 generate_config "$WORK_DIR/urltest-filter-fixture.json" "$WORK_DIR/urltest.json"
-if generate_config "$WORK_DIR/manual-http-fixture.json" "$WORK_DIR/manual-http.json" \
-  >"$WORK_DIR/manual-http.stdout" 2>"$WORK_DIR/manual-http.stderr"; then
-  fail "generator should reject native HTTP connection URLs"
-fi
-grep -Fxq 'manual proxy link scheme is not supported by sing-box config generation yet' "$WORK_DIR/manual-http.stderr" ||
-  fail "native HTTP connection URL failure should identify the unsupported scheme"
+# An unsupported link is skipped and its section, left without outbounds, is
+# blocked: the rest of the configuration still generates.
+generate_config "$WORK_DIR/manual-http-fixture.json" "$WORK_DIR/manual-http.json" \
+  >"$WORK_DIR/manual-http.stdout" 2>"$WORK_DIR/manual-http.stderr" ||
+  fail "native HTTP connection URL should be skipped, not stop the generator"
+grep -Fq "skipped manual link 1 '127.0.0.1:8080' of section 'proxy': manual proxy link scheme is not supported by sing-box config generation yet" "$WORK_DIR/manual-http.stderr" ||
+  grep -Fq "of section 'proxy': manual proxy link scheme is not supported by sing-box config generation yet" "$WORK_DIR/manual-http.stderr" ||
+  fail "native HTTP connection URL skip should identify the unsupported scheme"
+grep -Fq "section 'proxy' is not working" "$WORK_DIR/manual-http.stderr" ||
+  fail "section without usable outbounds should be reported"
+jq -e '[.outbounds[].tag] | index("proxy-out") == null' "$WORK_DIR/manual-http.json" >/dev/null ||
+  fail "section without usable outbounds must not get an outbound"
 generate_config "$WORK_DIR/provider-actions-fixture.json" "$WORK_DIR/providers.json"
 generate_config "$WORK_DIR/manual-transport-fixture.json" "$WORK_DIR/manual.json"
 generate_config "$WORK_DIR/vpn-interface-fixture.json" "$WORK_DIR/vpn.json"
@@ -1103,20 +1109,27 @@ grep -Fq "Moscow XHTTP (XHTTP requires sing-box-extended)" "$WORK_DIR/subscripti
 grep -Fq "Recursive dependent (detour depends on unavailable outbound 'depends-on-xhttp')" "$WORK_DIR/subscription-xhttp-stable.stderr" ||
   fail "stable sing-box XHTTP filtering should report recursively pruned detours"
 
-if generate_config_with_subscription_cache "$WORK_DIR/subscription-only-xhttp-fixture.json" "$WORK_DIR/subscription-only-xhttp.json" 0 \
-  >"$WORK_DIR/subscription-only-xhttp.stdout" 2>"$WORK_DIR/subscription-only-xhttp.stderr"; then
-  fail "stable sing-box should reject a subscription section with only XHTTP outbounds"
-fi
+# Nothing usable is left in the section: it is blocked, the rest generates.
+generate_config_with_subscription_cache "$WORK_DIR/subscription-only-xhttp-fixture.json" "$WORK_DIR/subscription-only-xhttp.json" 0 \
+  >"$WORK_DIR/subscription-only-xhttp.stdout" 2>"$WORK_DIR/subscription-only-xhttp.stderr" ||
+  fail "stable sing-box should block, not stop on, a subscription section with only XHTTP outbounds"
 grep -Fq "Only XHTTP node (XHTTP requires sing-box-extended)" "$WORK_DIR/subscription-only-xhttp.stderr" ||
   fail "all-XHTTP subscription failure should identify the incompatible outbound"
-[ "$(tail -n 1 "$WORK_DIR/subscription-only-xhttp.stderr")" = 'connection section has no usable outbounds' ] ||
-  fail "all-XHTTP subscription failure should end with the actionable generator error"
+grep -Fq "is not working (connection section has no usable outbounds); its traffic is blocked" "$WORK_DIR/subscription-only-xhttp.stderr" ||
+  fail "all-XHTTP subscription section should be reported as blocked"
 
 for fixture in manual-xhttp json-xhttp; do
   if ucode -L "$TRAFIRA_LIB" "$SINGBOX_GENERATOR_UC" generate-config-fixture \
     "$WORK_DIR/$fixture-fixture.json" "$WORK_DIR/$fixture-stable.json" "127.0.0.1" "0" "0" \
     >"$WORK_DIR/$fixture-stable.stdout" 2>"$WORK_DIR/$fixture-stable.stderr"; then
-    fail "stable sing-box should reject explicit $fixture configuration"
+    # a manual link is skipped and its section blocked; a JSON outbound is a
+    # setting of the section and still stops the generation
+    [ "$fixture" = "manual-xhttp" ] ||
+      fail "stable sing-box should reject explicit $fixture configuration"
+    grep -Fq "is not working (connection section has no usable outbounds)" "$WORK_DIR/$fixture-stable.stderr" ||
+      fail "explicit $fixture section without usable outbounds should be reported"
+  elif [ "$fixture" = "manual-xhttp" ]; then
+    fail "stable sing-box should skip, not stop on, explicit $fixture configuration"
   fi
   grep -Fq "uses XHTTP transport, but sing-box-extended is not installed" "$WORK_DIR/$fixture-stable.stderr" ||
     fail "explicit $fixture XHTTP failure should explain the extended requirement"
diff --git a/trafira/files/usr/lib/singbox/generator.uc b/trafira/files/usr/lib/singbox/generator.uc
index 53cbad3e..04c30fb2 100644
--- a/trafira/files/usr/lib/singbox/generator.uc
+++ b/trafira/files/usr/lib/singbox/generator.uc
@@ -27,6 +27,9 @@ let runtime_supports_xhttp = true;
 let runtime_sing_box_version = "";
 let runtime_subscription_tags = {};
 let runtime_section_states = {};
+// While a manual link is turned into an outbound, an unusable link raises an
+// exception (the link is skipped) instead of stopping the generator.
+let runtime_soft_errors = false;
 let runtime_response_rulesets = {};
 
 let as_string = common.as_string;
@@ -176,6 +179,8 @@ function uci_cursor() {
 }
 
 function runtime_generate_unsupported(reason) {
+    if (runtime_soft_errors)
+        die(reason);
     warn(reason, "\n");
     exit(2);
 }
@@ -1664,8 +1669,8 @@ function apply_link_transport(outbound, query) {
         optional_query_string(result, "host", as_string(query.host || "") != "" ? query.host : query.sni);
     }
     else {
-        warn("unknown manual proxy link transport '", transport, "' ignored\n");
-        return;
+        // without its transport the node would only fail to connect
+        runtime_generate_unsupported("transport '" + transport + "' is not supported");
     }
 
     outbound.transport = result;
@@ -1964,11 +1969,25 @@ function add_manual_proxy_link(config, state, section_name, manual_index, link,
         tag_name = unique_tag(tag_name, taken);
     taken[tag_name] = true;
 
-    let outbound = manual_link_outbound(link, tag_name);
     let display_name = url_fragment(link);
     if (display_name == "")
         display_name = tag_name;
-    ensure_explicit_outbound_supported(outbound, "manual outbound", display_name);
+    let outbound;
+    let failure = null;
+    runtime_soft_errors = true;
+    try {
+        outbound = manual_link_outbound(link, tag_name);
+        ensure_explicit_outbound_supported(outbound, "manual outbound", display_name);
+    }
+    catch (e) {
+        failure = e.message;
+    }
+    runtime_soft_errors = false;
+    if (failure != null) {
+        warn("ERROR: skipped manual link ", manual_index, " '", display_name, "' of section '", section_name,
+            "': ", failure, "\n");
+        return null;
+    }
     push(config.outbounds, outbound);
     push(selector_tags, tag_name);
     push(urltest_candidate_tags, tag_name);
@@ -2167,8 +2186,9 @@ function add_connections_outbound(config, section, taken) {
     add_connection_interfaces(config, state, section, taken, selector_tags, urltest_candidate_tags);
     add_connection_json_outbounds(config, state, section, taken, selector_tags, urltest_candidate_tags);
 
+    // caught by add_connections_outbound_or_block: the section is blocked
     if (length(selector_tags) == 0)
-        runtime_generate_unsupported("connection section has no usable outbounds");
+        die("connection section has no usable outbounds");
 
     if (section_needs_country_is(section)) {
         let previous_state = read_json_file(runtime_subscription.section_cache_path(section_name));
@@ -2933,6 +2953,35 @@ function unsupported_matcher_key(section) {
     return "";
 }
 
+// A broken manual link (unknown scheme or transport, invalid port, XHTTP
+// without sing-box-extended) is skipped, and a connection section left without
+// a usable outbound does not stop trafira: it becomes a block section, so its
+// traffic is rejected instead of leaving around the tunnel, and every other
+// section keeps working. Before, one such link made the whole generation fail.
+// Errors in the section's own settings still stop the generation.
+function add_connections_outbound_or_block(config, section, taken) {
+    let outbounds_before = length(config.outbounds);
+    let failure = null;
+    try {
+        add_connections_outbound(config, section, taken);
+    }
+    catch (e) {
+        failure = e.message;
+    }
+    if (failure == null)
+        return;
+
+    splice(config.outbounds, outbounds_before);
+    delete runtime_section_states[section[".name"]];
+    warn("ERROR: section '", section[".name"], "' is not working (", failure,
+        "); its traffic is blocked until the section is fixed\n");
+    section.action = "block";
+    if (bool_option(section, "mixed_proxy_enabled", false)) {
+        warn("mixed proxy of section '", section[".name"], "' is not created: the section is not working\n");
+        section.mixed_proxy_enabled = "0";
+    }
+}
+
 function add_outbound_for_section(config, section, taken, sections) {
     let action = option(section, "action", "");
     let section_name = section[".name"];
@@ -2943,7 +2992,7 @@ function add_outbound_for_section(config, section, taken, sections) {
         runtime_generate_unsupported("section has unsupported matcher " + unsupported_matcher);
 
     if (connections.is_connections_action(action))
-        add_connections_outbound(config, section, taken);
+        add_connections_outbound_or_block(config, section, taken);
     else if (action == "zapret")
         add_zapret_outbound(config, section, sections);
     else if (action == "zapret2")
diff --git a/trafira/files/usr/lib/subscription/parser.uc b/trafira/files/usr/lib/subscription/parser.uc
