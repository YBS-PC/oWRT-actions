index 868a2d0a..28e56bb4 100755
--- a/build.sh
+++ b/build.sh
@@ -171,6 +171,8 @@ build_backend_root() {
   make_dir "$output_root/usr/lib/trafira"
 
   install -m 0755 "$ROOT_DIR/trafira/files/etc/init.d/trafira" "$output_root/etc/init.d/trafira"
+  make_dir "$output_root/etc/uci-defaults"
+  install -m 0755 "$ROOT_DIR/trafira/files/etc/uci-defaults/60_trafira-firewall" "$output_root/etc/uci-defaults/60_trafira-firewall"
   install -m 0644 "$ROOT_DIR/trafira/files/etc/config/trafira" "$output_root/etc/config/trafira"
   install -m 0755 "$ROOT_DIR/trafira/files/usr/bin/trafira" "$output_root/usr/bin/trafira"
   cp -a "$ROOT_DIR/trafira/files/usr/lib/." "$output_root/usr/lib/trafira/"
@@ -179,7 +181,7 @@ build_backend_root() {
     "$output_root/usr/lib/trafira/core/constants.uc"
 
   normalize_package_root_modes "$output_root"
-  chmod 0755 "$output_root/etc/init.d/trafira" "$output_root/usr/bin/trafira"
+  chmod 0755 "$output_root/etc/init.d/trafira" "$output_root/usr/bin/trafira" "$output_root/etc/uci-defaults/60_trafira-firewall"
 }
 
 build_app_root() {
diff --git a/tests/shell_inventory.sh b/tests/shell_inventory.sh
index c5cd46b7..63be4f0c 100644
--- a/tests/shell_inventory.sh
+++ b/tests/shell_inventory.sh
@@ -44,6 +44,7 @@ shell_scripts="$(
 expected_shell_scripts="$(
   printf '%s\n' \
     'luci-app-trafira/root/etc/uci-defaults/50_luci-trafira' \
+    'trafira/files/etc/uci-defaults/60_trafira-firewall' \
     'trafira/files/etc/init.d/trafira' |
     LC_ALL=C sort
 )"
@@ -87,4 +88,11 @@ if grep -n -E '(^|[^[:alnum:]_])(uci|rm|logger|rpcd|killall|jsonfilter|config_lo
   fail "LuCI uci-defaults must not own cache, rpcd, logging, or UCI logic"
 fi
 
+TRAFIRA_FIREWALL_DEFAULTS="$ROOT_DIR/trafira/files/etc/uci-defaults/60_trafira-firewall"
+grep -Fq '/usr/bin/trafira package_firewall' "$TRAFIRA_FIREWALL_DEFAULTS" ||
+  fail "backend uci-defaults must delegate firewall setup to ucode"
+if grep -n -E '(^|[^[:alnum:]_])(uci|nft|fw4|rm|logger|ucode)([[:space:]]|$)' "$TRAFIRA_FIREWALL_DEFAULTS" >/dev/null 2>&1; then
+  fail "backend uci-defaults must not own firewall or UCI logic"
+fi
+
 printf 'shell inventory checks passed\n'
diff --git a/trafira/Makefile b/trafira/Makefile
index 10335d00..c1faa082 100644
--- a/trafira/Makefile
+++ b/trafira/Makefile
@@ -64,6 +64,9 @@ define Package/trafira/install
 	$(INSTALL_DIR) $(1)/etc/init.d
 	$(INSTALL_BIN) ./files/etc/init.d/trafira $(1)/etc/init.d/trafira
 
+	$(INSTALL_DIR) $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./files/etc/uci-defaults/60_trafira-firewall $(1)/etc/uci-defaults/60_trafira-firewall
+
 	$(INSTALL_DIR) $(1)/etc/config
 	$(INSTALL_CONF) ./files/etc/config/trafira $(1)/etc/config/trafira
 
diff --git a/trafira/files/etc/uci-defaults/60_trafira-firewall b/trafira/files/etc/uci-defaults/60_trafira-firewall
new file mode 100644
index 00000000..598d242d
--- /dev/null
+++ b/trafira/files/etc/uci-defaults/60_trafira-firewall
@@ -0,0 +1,6 @@
+#!/bin/sh
+# Allow TPROXY-marked input through the firewall (#84). package_postinst does this
+# on a live install; firmware images skip postinst and run this instead.
+
+/usr/bin/trafira package_firewall >/dev/null 2>&1 || true
+exit 0
diff --git a/trafira/files/usr/bin/trafira b/trafira/files/usr/bin/trafira
index 94c9db53..060e6fb9 100755
--- a/trafira/files/usr/bin/trafira
+++ b/trafira/files/usr/bin/trafira
@@ -195,6 +195,7 @@ function command_spec(command) {
         validate_byedpi_strategy_json: [ "providers/byedpi/validator.uc", "validate-json", 1 ],
         package_prerm: [ "service/package.uc", "prerm", 1 ],
         package_postinst: [ "service/package.uc", "postinst", 0 ],
+        package_firewall: [ "service/package.uc", "ensure-tproxy-firewall", 0 ],
         luci_postinst: [ "service/package.uc", "luci-postinst", 0 ]
     };
 
diff --git a/trafira/files/usr/lib/service/package.uc b/trafira/files/usr/lib/service/package.uc
index 104b50f7..4b153a26 100644
--- a/trafira/files/usr/lib/service/package.uc
+++ b/trafira/files/usr/lib/service/package.uc
@@ -258,8 +258,10 @@ function postinst_restore() {
     if (env("IPKG_INSTROOT", "") != "")
         return true;
 
+    // A firewall reload failure must not fail the package install; the
+    // include is retried by /etc/uci-defaults/60_trafira-firewall.
     if (!ensure_tproxy_firewall_include())
-        return false;
+        warn("trafira: could not install the fw4 TPROXY input include\n");
 
     if (!path_exists(PACKAGE_UPGRADE_STATE))
         return true;
