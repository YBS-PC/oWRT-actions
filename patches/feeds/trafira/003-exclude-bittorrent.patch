diff --git a/trafira/files/usr/lib/singbox/route.uc b/trafira/files/usr/lib/singbox/route.uc
index c67212db..668a475f 100644
--- a/trafira/files/usr/lib/singbox/route.uc
+++ b/trafira/files/usr/lib/singbox/route.uc
@@ -45,6 +45,14 @@ function config(settings, runtime) {
     if (bool_option(settings, "disable_quic", false))
         push(result.rules, { action: "reject", inbound: runtime_constants.TPROXY_INBOUND_TAG, protocol: "quic" });
 
+    // Sniffed BitTorrent/DHT goes direct before any section rule (#72).
+    if (bool_option(settings, "exclude_bittorrent", false))
+        push(result.rules, {
+            action: "route",
+            protocol: "bittorrent",
+            outbound: runtime_constants.BYPASS_OUTBOUND_TAG
+        });
+
     return result;
