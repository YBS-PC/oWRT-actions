+#!/usr/bin/env bash
+set -eo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+TRAFIRA_LIB="$ROOT_DIR/trafira/files/usr/lib"
+WORK_DIR="$(mktemp -d)"
+
+cleanup() {
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+# Stubs for the commands the Environment check reads.
+mkdir -p "$WORK_DIR/bin"
+cat >"$WORK_DIR/bin/nft" <<'SH'
+#!/bin/sh
+[ -n "$FT" ] && echo "table inet fw4 { flowtable ft { hook ingress priority filter; } }"
+exit 0
+SH
+cat >"$WORK_DIR/bin/curl" <<'SH'
+#!/bin/sh
+[ -n "$NONET" ] && exit 6
+printf 'HTTP/2 200\r\ndate: %s\r\n' "$(date -u -d "@$(( $(date +%s) - ${SKEW:-0} ))" '+%a, %d %b %Y %H:%M:%S GMT')"
+SH
+cat >"$WORK_DIR/bin/ip" <<'SH'
+#!/bin/sh
+[ -n "$V6" ] && echo "    inet6 $V6/64 scope global dynamic"
+exit 0
+SH
+cat >"$WORK_DIR/bin/sysctl" <<'SH'
+#!/bin/sh
+echo "${V6OFF:-0}"
+SH
+chmod +x "$WORK_DIR"/bin/*
+
+check() {
+  printf '%s\n' "$1" >"$WORK_DIR/uci.state"
+  shift
+  env PATH="$WORK_DIR/bin:$PATH" TRAFIRA_UCI_STATE_FILE="$WORK_DIR/uci.state" "$@" \
+    ucode -L "$TRAFIRA_LIB" "$TRAFIRA_LIB/diagnostics/runtime.uc" check-environment
+}
+
+expect() {
+  local json="$1" filter="$2" what="$3"
+  printf '%s' "$json" | jq -e "$filter" >/dev/null || fail "$what: $json"
+}
+
+out="$(check 'system.@system[0].zonename=Europe/Moscow')"
+expect "$out" '.flow_offloading == {software: false, hardware: false, active: false}' "clean: flow offloading"
+expect "$out" '.clock.plausible and (.clock.skew_seconds | fabs) < 5 and .clock.ntp_enabled' "clean: clock"
+expect "$out" '.clock.timezone == "Europe/Moscow"' "clean: timezone"
+expect "$out" '.ipv6 == {router_has_global: false, trafira_handles: true}' "clean: ipv6"
+
+out="$(check "$(printf 'firewall.@defaults[0].flow_offloading=1\nfirewall.@defaults[0].flow_offloading_hw=1')" FT=1 SKEW=600 V6=2001:db8::1)"
+expect "$out" '.flow_offloading == {software: true, hardware: true, active: true}' "offloading"
+expect "$out" '.clock.skew_seconds >= 595 and .clock.skew_seconds <= 605' "clock skew"
+expect "$out" '.ipv6.router_has_global and .ipv6.trafira_handles' "global ipv6 handled"
+
+out="$(check 'system.ntp.enabled=0' NONET=1 V6=fd00::1 V6OFF=1)"
+expect "$out" '.clock.skew_seconds == null and (.clock.ntp_enabled | not)' "no network"
+expect "$out" '(.ipv6.router_has_global | not) and (.ipv6.trafira_handles | not)' "ULA is not global"
+
+printf 'check_environment: ok\n'
