diff --git a/fe-app-trafira/src/trafira/tabs/diagnostic/tests/getEnvironmentItems.test.ts b/fe-app-trafira/src/trafira/tabs/diagnostic/tests/getEnvironmentItems.test.ts
new file mode 100644
index 00000000..da146275
--- /dev/null
+++ b/fe-app-trafira/src/trafira/tabs/diagnostic/tests/getEnvironmentItems.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from 'vitest';
+import {
+  CLOCK_SKEW_WARNING_SECONDS,
+  getEnvironmentItems,
+} from '../helpers/getEnvironmentItems';
+import { Trafira } from '../../../types';
+
+function facts(
+  overrides: Partial<Trafira.EnvironmentCheckResult> = {},
+): Trafira.EnvironmentCheckResult {
+  return {
+    flow_offloading: { software: false, hardware: false, active: false },
+    clock: {
+      plausible: true,
+      skew_seconds: 0,
+      ntp_enabled: true,
+      timezone: 'Europe/Moscow',
+    },
+    ipv6: { router_has_global: false, trafira_handles: true },
+    ...overrides,
+  };
+}
+
+describe('getEnvironmentItems', () => {
+  it('reports a clean router as all success', () => {
+    const items = getEnvironmentItems(facts());
+    expect(items).toHaveLength(3);
+    expect(items.every((item) => item.state === 'success')).toBe(true);
+  });
+
+  it.each([
+    [{ software: true, hardware: false, active: false }],
+    [{ software: false, hardware: true, active: false }],
+    [{ software: false, hardware: false, active: true }],
+  ])('warns about flow offloading %j', (flow) => {
+    const items = getEnvironmentItems(facts({ flow_offloading: flow }));
+    expect(items[0].state).toBe('warning');
+  });
+
+  it('fails on a clock that was never set', () => {
+    const items = getEnvironmentItems(
+      facts({
+        clock: {
+          plausible: false,
+          skew_seconds: null,
+          ntp_enabled: true,
+          timezone: '',
+        },
+      }),
+    );
+    expect(items[1].state).toBe('error');
+  });
+
+  it('warns about a clock skew above the limit only', () => {
+    const clock = (skew: number | null) =>
+      getEnvironmentItems(
+        facts({
+          clock: {
+            plausible: true,
+            skew_seconds: skew,
+            ntp_enabled: true,
+            timezone: '',
+          },
+        }),
+      )[1].state;
+    expect(clock(CLOCK_SKEW_WARNING_SECONDS)).toBe('success');
+    expect(clock(CLOCK_SKEW_WARNING_SECONDS + 1)).toBe('warning');
+    expect(clock(-CLOCK_SKEW_WARNING_SECONDS - 1)).toBe('warning');
+    expect(clock(null)).toBe('success');
+  });
+
+  it('warns about global IPv6 only when trafira cannot intercept it', () => {
+    const ipv6 = (router_has_global: boolean, trafira_handles: boolean) =>
+      getEnvironmentItems(
+        facts({ ipv6: { router_has_global, trafira_handles } }),
+      )[2].state;
+    expect(ipv6(true, false)).toBe('warning');
+    expect(ipv6(true, true)).toBe('success');
+    expect(ipv6(false, false)).toBe('success');
+  });
+});
