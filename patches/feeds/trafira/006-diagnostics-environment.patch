+// "Date: Thu, 08 Oct 2026 19:22:55 GMT" -> seconds since the epoch, or null
+function http_date_epoch(value) {
+    let months = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };
+    let m = match(as_string(value), /([0-9]{1,2}) ([A-Za-z]{3}) ([0-9]{4}) ([0-9]{2}):([0-9]{2}):([0-9]{2})/);
+    if (m == null || months[lc(m[2])] == null)
