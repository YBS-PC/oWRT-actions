+
+// The "Environment" check: what silently breaks the redirection without being
+// a fault of trafira itself. Only reads; the one network access is a HEAD
+// request for the clock (no internet - no skew, which is not an error).
+//   flow offloading - established connections skip the marks trafira sets;
+//   the clock       - TLS and Reality fail with a wrong date;
+//   IPv6            - with IPv6 off in the kernel trafira cannot intercept it,
+//                     while a global address still lets clients use it.
+function check_environment() {
+    let software = uci_get("firewall.@defaults[0].flow_offloading") == "1";
+    let hardware = uci_get("firewall.@defaults[0].flow_offloading_hw") == "1";
+    let active = match(command_output_from_args([ "nft", "list", "flowtables" ]), /flowtable /) != null;
+
+    let now = time();
+    let date_line = "";
+    for (let line in split(command_output_from_args([ "curl", "-sI", "-m", "5", ENVIRONMENT_CLOCK_PROBE_URL ]), "\n"))
+        if (match(lc(line), /^date:/))
+            date_line = line;
+    let server_time = http_date_epoch(date_line);
+
+    let global_ipv6 = false;
+    for (let line in split(command_output_from_args([ "ip", "-6", "addr", "show", "scope", "global" ]), "\n")) {
+        let addr = match(line, /inet6 ([0-9a-fA-F:]+)\//);
+        if (addr && !match(lc(addr[1]), /^f[cd]/))
+            global_ipv6 = true;
+    }
+    let ipv6_off = trim(command_output_from_args([ "sysctl", "-n", "net.ipv6.conf.all.disable_ipv6" ])) == "1" ||
+        trim(command_output_from_args([ "sysctl", "-n", "net.ipv6.conf.lo.disable_ipv6" ])) == "1";
+
+    write_json({
+        flow_offloading: { software, hardware, active },
+        clock: {
+            plausible: now >= ENVIRONMENT_MIN_PLAUSIBLE_EPOCH,
+            skew_seconds: server_time == null ? null : now - server_time,
+            ntp_enabled: uci_get("system.ntp.enabled") != "0",
+            timezone: uci_get("system.@system[0].zonename")
+        },
+        ipv6: { router_has_global: global_ipv6, trafira_handles: !ipv6_off }
+    });
+    return 0;
+}
