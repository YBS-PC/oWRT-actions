diff --git a/tests/check_environment.sh b/tests/check_environment.sh
new file mode 100755
index 00000000..68ab770f
--- /dev/null
+++ b/tests/check_environment.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+set -eo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+TRAFIRA_LIB="$ROOT_DIR/trafira/files/usr/lib"
+WORK_DIR="$(mktemp -d)"
+
+cleanup() {
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
