From dfc6ea89ecac166cc443c2149cecc233486c858e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 26 Sep 2026 07:11:15 +0000
Subject: [PATCH] Declare updates_log before the tmpfs guard added by PR #105

Requires: 010-pr105-tmpfs-oom-guard

Declare ucode helpers before their first caller

ucode resolves identifiers when a file is compiled, so a top-level
function called before its declaration is looked up as a global and
fails at runtime with "left-hand side is not a function" (#62, #115).

Move the remaining helpers above their first caller:
- components/action.uc: updates_log/log_message (used by the tmpfs
  space guard, so a low-space install crashed instead of logging)
- server/service.uc: safe_filename_string (TLS defaults)
- service/initd.uc: release_runtime_dir_lock, owner_pid_value
- service/state.uc: release_runtime_dir_lock
- service/ui.uc: release_dir_lock

These paths only run on lock contention, low tmpfs space or TLS setup
without certificates, so the test suite did not reach them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HEQfjBzS7Wos7AvTk18TDQ
---
 forkop/files/usr/lib/components/action.uc | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/forkop/files/usr/lib/components/action.uc b/forkop/files/usr/lib/components/action.uc
index 65baf4d..a597ebc 100644
--- a/forkop/files/usr/lib/components/action.uc
+++ b/forkop/files/usr/lib/components/action.uc
@@ -162,6 +162,15 @@ function bytes_to_mib_ceil(value) {
     return value <= 0 ? 0 : int((value + 1048575) / 1048576);
 }
 
+function log_message(message, level) {
+    level = as_string(level || "info");
+    command_success_from_args([ "logger", "-t", "forkop", "[" + level + "] " + as_string(message) ]);
+}
+
+function updates_log(message, level) {
+    log_message("Updates: " + as_string(message), level || "info");
+}
+
 function ensure_tmp_download_capacity(asset_size, label) {
     asset_size = int(asset_size || 0);
     if (asset_size <= 0) {
@@ -210,15 +219,6 @@ function pid_running(pid) {
     return match(pid, /^[0-9]+$/) != null && command_success_from_args([ "kill", "-0", pid ]);
 }
 
-function log_message(message, level) {
-    level = as_string(level || "info");
-    command_success_from_args([ "logger", "-t", "forkop", "[" + level + "] " + as_string(message) ]);
-}
-
-function updates_log(message, level) {
-    log_message("Updates: " + as_string(message), level || "info");
-}
-
 function module_command(args) {
     let command_args = [ "ucode", "-L", LIB_DIR ];
     for (let arg in args)
