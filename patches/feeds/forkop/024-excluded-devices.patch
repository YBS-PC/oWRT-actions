diff --git a/forkop/files/usr/lib/config/exclusions.uc b/forkop/files/usr/lib/config/exclusions.uc
new file mode 100644
index 0000000..c3657f2
--- /dev/null
+++ b/forkop/files/usr/lib/config/exclusions.uc
@@ -0,0 +1,70 @@
+#!/usr/bin/env ucode
+
+// Devices excluded from Forkop routing (settings.routing_excluded_ips).
+// Entries are IPv4/IPv6 addresses or CIDRs, or MAC addresses. MAC entries
+// keep matching a device whose DHCP lease or IPv6 privacy address changes.
+
+let ip = require("core.ip");
+
+function as_string(value) {
+    return value == null ? "" : "" + value;
+}
+
+function valid_mac(value) {
+    return match(as_string(value), /^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$/) != null;
+}
+
+function list_values(value) {
+    if (type(value) == "array")
+        return value;
+    return split(as_string(value), /[ \t\r\n,]+/);
+}
+
+function parse(values) {
+    let result = { ipv4: [], ipv6: [], ips: [], macs: [], invalid: [] };
+    let seen = {};
+
+    for (let value in list_values(values)) {
+        value = trim(as_string(value));
+        if (value == "")
+            continue;
+
+        let key = lc(value);
+        if (seen[key])
+            continue;
+        seen[key] = true;
+
+        if (valid_mac(value)) {
+            push(result.macs, key);
+            continue;
+        }
+
+        let family = ip.ip_family(value);
+        if (family == 4)
+            push(result.ipv4, value);
+        else if (family == 6)
+            push(result.ipv6, value);
+        else {
+            push(result.invalid, value);
+            continue;
+        }
+        push(result.ips, value);
+    }
+
+    return result;
+}
+
+function from_settings(settings) {
+    return parse(type(settings) == "object" ? settings.routing_excluded_ips : null);
+}
+
+function has_entries(parsed) {
+    return type(parsed) == "object" && (length(parsed.ips) > 0 || length(parsed.macs) > 0);
+}
+
+return {
+    valid_mac,
+    parse,
+    from_settings,
+    has_entries
+};
