diff --git a/tests/excluded_devices.sh b/tests/excluded_devices.sh
new file mode 100755
index 0000000..472147e
--- /dev/null
+++ b/tests/excluded_devices.sh
@@ -0,0 +1,207 @@
+#!/usr/bin/env bash
+set -eo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+FORKOP_LIB="$ROOT_DIR/forkop/files/usr/lib"
+NFT_RUNTIME="$FORKOP_LIB/nft/apply.uc"
+GENERATOR="$FORKOP_LIB/singbox/generator.uc"
+VALIDATOR="$FORKOP_LIB/config/validator.uc"
+WORK_DIR="$(mktemp -d)"
+NFT_LOG="$WORK_DIR/nft.log"
+
+cleanup() {
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+line_of() {
+  grep -Fn "$1" "$NFT_LOG" | head -n 1 | cut -d: -f1
+}
+
+# --- nftables ---------------------------------------------------------------
+
+mkdir -p "$WORK_DIR/bin"
+for tool in nft ip logger sysctl; do
+  cat >"$WORK_DIR/bin/$tool" <<'SH'
+#!/usr/bin/env bash
+if [ "$(basename "$0")" = "nft" ]; then
+  { printf 'nft'; for arg in "$@"; do printf '\t%s' "$arg"; done; printf '\n'; } >>"$NFT_LOG"
+fi
+exit 0
+SH
+  chmod +x "$WORK_DIR/bin/$tool"
+done
+
+cat >"$WORK_DIR/uci.state" <<'EOF_UCI'
+forkop.settings=settings
+forkop.settings.source_network_interfaces=br-lan
+forkop.settings.routing_excluded_ips=192.168.1.50 2001:db8::50/128 AA:BB:CC:DD:EE:FF not-a-device
+EOF_UCI
+
+PATH="$WORK_DIR/bin:$PATH" NFT_LOG="$NFT_LOG" FORKOP_UCI_STATE_FILE="$WORK_DIR/uci.state" \
+  ucode -L "$FORKOP_LIB" "$NFT_RUNTIME" nft-create-runtime-base-from-uci \
+    ForkopTable localv4 forkop_subnets forkop_ports forkop_ip_ports forkop_interfaces \
+    0x00100000 0x00200000 198.18.0.0/15 1602 ||
+  fail "runtime base with excluded devices failed"
+
+for expected in \
+  $'add\tset\tinet\tForkopTable\tforkop_excluded_sources\t' \
+  $'add\tset\tinet\tForkopTable\tforkop_excluded_sources6\t' \
+  $'add\tset\tinet\tForkopTable\tforkop_excluded_macs\t{ type ether_addr; }' \
+  $'add\telement\tinet\tForkopTable\tforkop_excluded_sources\t{ 192.168.1.50 }' \
+  $'add\telement\tinet\tForkopTable\tforkop_excluded_sources6\t{ 2001:db8::50/128 }' \
+  $'add\telement\tinet\tForkopTable\tforkop_excluded_macs\t{ aa:bb:cc:dd:ee:ff }' \
+  $'dns_redirect\tiifname\t@forkop_interfaces\tether\tsaddr\t@forkop_excluded_macs\tudp\tdport\t53\tcounter\tredirect\tto\t:1605' \
+  $'dns_redirect\tiifname\t@forkop_interfaces\tip6\tsaddr\t@forkop_excluded_sources6\ttcp\tdport\t53\tcounter\tredirect\tto\t:1605' \
+  $'mangle\tiifname\t@forkop_interfaces\tether\tsaddr\t@forkop_excluded_macs\tcounter\treturn'; do
+  grep -Fq "$expected" "$NFT_LOG" || fail "missing nft command: $expected"
+done
+grep -Fq "not-a-device" "$NFT_LOG" && fail "invalid entries must not reach nft"
+
+excluded_dns="$(line_of $'saddr\t@forkop_excluded_sources\tudp\tdport\t53')"
+source_dns="$(line_of $'saddr\t@forkop_dns_sources\ttcp\tdport\t53')"
+[ "$excluded_dns" -lt "$source_dns" ] || fail "excluded DNS redirect must precede source-aware DNS redirect"
+excluded_return="$(line_of $'mangle\tiifname\t@forkop_interfaces\tip\tsaddr\t@forkop_excluded_sources\tcounter\treturn')"
+priority_jump="$(line_of $'mangle\tjump\tpriority_rules')"
+[ -n "$excluded_return" ] && [ "$excluded_return" -lt "$priority_jump" ] ||
+  fail "excluded devices must leave the mangle chain before section rules"
+
+# --- sing-box config --------------------------------------------------------
+
+cat >"$WORK_DIR/fixture.json" <<'JSON'
+{
+  "settings": {
+    ".name": "settings",
+    ".type": "settings",
+    "config_path": "/tmp/sing-box/config.json",
+    "dns_server": "1.1.1.1",
+    "bootstrap_dns_server": "1.1.1.1",
+    "service_listen_address": "127.0.0.1",
+    "routing_excluded_ips": [ "192.168.1.50", "2001:db8::50/128", "aa:bb:cc:dd:ee:ff" ]
+  },
+  "section": [
+    {
+      ".name": "proxy",
+      ".type": "section",
+      "enabled": "1",
+      "action": "outbound",
+      "outbound_json": "{\"type\":\"socks\",\"server\":\"127.0.0.1\",\"server_port\":1080,\"version\":\"5\"}",
+      "domain_suffix": [ "example.org" ]
+    }
+  ]
+}
+JSON
+
+generate_for_version() {
+  local version="$1" output="$2"
+  mkdir -p "$output.section-cache" "$output.rulesets"
+  ucode -L "$FORKOP_LIB" "$GENERATOR" generate-config-fixture \
+    "$WORK_DIR/fixture.json" "$output" "127.0.0.1" "0" "1" "" "$version"
+}
+
+check_config() {
+  ucode -e '
+let config = json(require("fs").readfile(ARGV[0]));
+let modern = ARGV[1] == "1";
+
+function assert(condition, message) {
+    if (!condition)
+        die(message + "\n");
+}
+
+function has_inbound(rule, tag) {
+    let inbound = rule.inbound;
+    if (type(inbound) == "array") {
+        for (let item in inbound)
+            if (item == tag)
+                return true;
+        return false;
+    }
+    return inbound == tag;
+}
+
+function mentions_excluded(rule) {
+    if (has_inbound(rule, "excluded-dns-in"))
+        return true;
+    for (let sub in rule.rules || [])
+        if (has_inbound(sub, "excluded-dns-in"))
+            return true;
+    return false;
+}
+
+let inbound = null;
+for (let item in config.inbounds)
+    if (item.tag == "excluded-dns-in")
+        inbound = item;
+assert(inbound && inbound.type == "direct" && inbound.listen_port == 1605, "excluded-dns-in inbound on port 1605");
+
+let dnsmasq = 0;
+for (let server in config.dns.servers)
+    if (server.tag == "dnsmasq-server")
+        dnsmasq++;
+assert(dnsmasq == 1, "exactly one dnsmasq DNS server");
+
+let sniff = null, safety = null, section = null;
+for (let i = 0; i < length(config.route.rules); i++) {
+    let rule = config.route.rules[i];
+    if (rule.action == "sniff" && has_inbound(rule, "excluded-dns-in"))
+        sniff = i;
+    if (rule.outbound == "bypass-out" && rule.source_ip_cidr != null)
+        safety = i;
+    if (section == null && rule.outbound == "proxy-out")
+        section = i;
+}
+assert(sniff != null, "excluded-dns-in must be sniffed so hijack-dns handles it");
+assert(safety != null && safety < section, "safety route for excluded IPs must precede section rules");
+let cidrs = config.route.rules[safety].source_ip_cidr;
+assert(type(cidrs) == "array" && length(cidrs) == 2, "safety route lists IP entries only (MACs are not visible to sing-box)");
+
+let first_excluded = null, first_section_dns = null, evaluate = null, respond = null;
+for (let i = 0; i < length(config.dns.rules); i++) {
+    let rule = config.dns.rules[i];
+    if (first_excluded == null && mentions_excluded(rule))
+        first_excluded = i;
+    if (first_section_dns == null && rule.server == "fakeip-server" && rule.domain_suffix != null)
+        first_section_dns = i;
+    if (rule.action == "evaluate" && has_inbound(rule, "excluded-dns-in"))
+        evaluate = i;
+    if (rule.action == "respond" && mentions_excluded(rule))
+        respond = i;
+}
+assert(first_excluded != null && first_excluded < first_section_dns, "excluded DNS rules must precede section FakeIP rules");
+if (modern)
+    assert(evaluate != null && respond != null && evaluate < respond, "1.14: evaluate dnsmasq, then respond");
+else
+    assert(evaluate == null && respond == null, "pre-1.14: legacy DNS rules");
+' "$1" "$2" || fail "$3"
+}
+
+generate_for_version "1.13.21" "$WORK_DIR/sb113.json"
+check_config "$WORK_DIR/sb113.json" 0 "sing-box 1.13 excluded devices config"
+generate_for_version "1.14.2" "$WORK_DIR/sb114.json"
+check_config "$WORK_DIR/sb114.json" 1 "sing-box 1.14 excluded devices config"
+
+for bin in ${FORKOP_TEST_SING_BOX_113:-} ${FORKOP_TEST_SING_BOX_114:-}; do
+  [ -x "$bin" ] || continue
+  case "$("$bin" version | head -n1)" in
+    *" 1.14."*) cfg="$WORK_DIR/sb114.json" ;;
+    *) cfg="$WORK_DIR/sb113.json" ;;
+  esac
+  "$bin" check -c "$cfg" || fail "sing-box check rejected $cfg ($bin)"
+done
+
+# --- validator --------------------------------------------------------------
+
+sed 's/"aa:bb:cc:dd:ee:ff"/"aa:bb:cc:dd:ee:ff", "printer.lan"/' "$WORK_DIR/fixture.json" >"$WORK_DIR/bad.json"
+if output="$(FORKOP_LIB="$FORKOP_LIB" ucode -L "$FORKOP_LIB" "$VALIDATOR" validate-runtime-fixture "$WORK_DIR/bad.json" "{}" 2>&1)"; then
+  fail "validator must reject a non IP/MAC excluded device"
+fi
+printf '%s' "$output" | grep -Fq "Invalid excluded device 'printer.lan'" ||
+  fail "validator message must name the invalid excluded device: $output"
+
+printf 'excluded devices checks passed\n'
-- 
