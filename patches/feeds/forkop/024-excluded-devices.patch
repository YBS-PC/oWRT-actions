 }
 
+// Excluded devices (settings.routing_excluded_ips): their DNS is answered
+// with real addresses by the excluded-dns-in inbound, and their traffic
+// leaves the mangle chain before any section rule, so section order does
+// not matter. Matching by MAC also covers changing IPv4 leases and IPv6
+// privacy addresses.
+function nft_add_excluded_device_rules(table, interface_set) {
+    let iif = [ "iifname", "@" + as_string(interface_set) ];
+    let port = ":" + as_string(runtime_constants.EXCLUDED_DNS_INBOUND_PORT);
+    let matchers = [
+        [ "ip", "saddr", "@" + EXCLUDED_SOURCE_SET ],
+        [ "ip6", "saddr", "@" + EXCLUDED_SOURCE6_SET ],
+        [ "ether", "saddr", "@" + EXCLUDED_MAC_SET ]
+    ];
+
+    for (let matcher in matchers)
+        for (let proto in [ "udp", "tcp" ])
+            if (!nft_add_rule(table, "dns_redirect", [ ...iif, ...matcher, proto, "dport", "53", "counter", "redirect", "to", port ]))
+                return false;
+
+    return true;
+}
+
+function nft_add_excluded_device_returns(table, interface_set) {
+    let iif = [ "iifname", "@" + as_string(interface_set) ];
+    return nft_add_rule(table, "mangle", [ ...iif, "ip", "saddr", "@" + EXCLUDED_SOURCE_SET, "counter", "return" ]) &&
+        nft_add_rule(table, "mangle", [ ...iif, "ip6", "saddr", "@" + EXCLUDED_SOURCE6_SET, "counter", "return" ]) &&
+        nft_add_rule(table, "mangle", [ ...iif, "ether", "saddr", "@" + EXCLUDED_MAC_SET, "counter", "return" ]);
+}
+
+function nft_add_excluded_devices(settings, table) {
+    let parsed = exclusions.from_settings(settings);
+    for (let value in parsed.invalid)
+        log_debug("Ignoring excluded device entry that is not an IP, CIDR or MAC: " + value);
+
+    if (length(parsed.ipv4) > 0 && !nft_add_set_elements(table, EXCLUDED_SOURCE_SET, join(",", parsed.ipv4)))
+        return false;
+    if (length(parsed.ipv6) > 0 && !nft_add_set_elements(table, EXCLUDED_SOURCE6_SET, join(",", parsed.ipv6)))
+        return false;
+    if (length(parsed.macs) > 0 && !nft_add_set_elements(table, EXCLUDED_MAC_SET, join(",", parsed.macs)))
+        return false;
+    return true;
+}
