diff --git a/tests/exclude_bittorrent.sh b/tests/exclude_bittorrent.sh
new file mode 100755
index 0000000..e5bf731
--- /dev/null
+++ b/tests/exclude_bittorrent.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+set -eo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+FORKOP_LIB="$ROOT_DIR/forkop/files/usr/lib"
+GENERATOR="$FORKOP_LIB/singbox/generator.uc"
+WORK_DIR="$(mktemp -d)"
+
+cleanup() {
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+generate() {
+  local flag="$1" output="$2"
+  cat >"$WORK_DIR/fixture-$flag.json" <<JSON
+{
+  "settings": {
+    ".name": "settings",
+    ".type": "settings",
+    "config_path": "/tmp/sing-box/config.json",
+    "dns_server": "1.1.1.1",
+    "bootstrap_dns_server": "1.1.1.1",
+    "service_listen_address": "127.0.0.1",
+    "exclude_bittorrent": "$flag"
+  },
+  "section": [
+    {
+      ".name": "proxy",
+      ".type": "section",
+      "enabled": "1",
+      "action": "outbound",
+      "outbound_json": "{\"type\":\"socks\",\"server\":\"127.0.0.1\",\"server_port\":1080,\"version\":\"5\"}",
+      "domain_suffix": [ "example.org" ]
+    }
+  ]
+}
+JSON
+  mkdir -p "$output.section-cache" "$output.rulesets"
+  ucode -L "$FORKOP_LIB" "$GENERATOR" generate-config-fixture \
+    "$WORK_DIR/fixture-$flag.json" "$output" "127.0.0.1"
+}
+
+check() {
+  ucode -e '
+let config = json(require("fs").readfile(ARGV[0]));
+let rules = config.route.rules;
+let torrent = null, sniff = null, section = null;
+for (let i = 0; i < length(rules); i++) {
+    if (rules[i].action == "sniff") sniff = i;
+    if (rules[i].protocol == "bittorrent") torrent = i;
+    if (section == null && rules[i].outbound == "proxy-out") section = i;
+}
+if (ARGV[1] == "1") {
+    if (torrent == null || rules[torrent].outbound != "bypass-out")
+        die("BitTorrent must be routed to bypass-out\n");
+    if (!(sniff < torrent && torrent < section))
+        die("BitTorrent rule must follow sniffing and precede section rules\n");
+}
+else if (torrent != null)
+    die("BitTorrent rule must be absent when the option is off\n");
+' "$1" "$2"
+}
+
+generate 1 "$WORK_DIR/on.json"
+check "$WORK_DIR/on.json" 1 || fail "exclude_bittorrent=1"
+generate 0 "$WORK_DIR/off.json"
+check "$WORK_DIR/off.json" 0 || fail "exclude_bittorrent=0"
+
+for bin in ${FORKOP_TEST_SING_BOX_113:-} ${FORKOP_TEST_SING_BOX_114:-}; do
+  [ -x "$bin" ] || continue
+  "$bin" check -c "$WORK_DIR/on.json" || fail "sing-box check rejected the BitTorrent rule ($bin)"
+done
+
+printf 'BitTorrent exclusion checks passed\n'
