diff --git a/forkop/files/usr/lib/singbox/constants.uc b/forkop/files/usr/lib/singbox/constants.uc
index 3e427b9..88474e2 100644
--- a/forkop/files/usr/lib/singbox/constants.uc
+++ b/forkop/files/usr/lib/singbox/constants.uc
@@ -22,6 +22,9 @@ const SOURCE_DNS_INBOUND_PORT = 1603;
 const EXCLUDED_DNS_INBOUND_TAG = "excluded-dns-in";
 const EXCLUDED_DNS_INBOUND_ADDRESS = "::";
 const EXCLUDED_DNS_INBOUND_PORT = 1605;
+const EXCLUDED_TPROXY_INBOUND_TAG = "excluded-tproxy-in";
+const EXCLUDED_TPROXY_INBOUND6_TAG = "excluded-tproxy6-in";
+const EXCLUDED_TPROXY_INBOUND_PORT = 1606;
 
 const SERVICE_MIXED_INBOUND_TAG = "service-mixed-in";
