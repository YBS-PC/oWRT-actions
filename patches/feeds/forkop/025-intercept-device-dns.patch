diff --git a/forkop/files/usr/lib/config/exclusions.uc b/forkop/files/usr/lib/config/exclusions.uc
index c3657f2..cd7b404 100644
--- a/forkop/files/usr/lib/config/exclusions.uc
+++ b/forkop/files/usr/lib/config/exclusions.uc
@@ -62,9 +62,20 @@ function has_entries(parsed) {
     return type(parsed) == "object" && (length(parsed.ips) > 0 || length(parsed.macs) > 0);
 }
 
+// settings.intercept_device_dns (default on). When off, Forkop does not
+// redirect the DNS of excluded or source-filtered devices to its own
+// inbounds, so a resolver in front of Forkop (AdGuard Home, dnsmasq) keeps
+// seeing every client. Their traffic to FakeIP addresses is then sorted by
+// sing-box, which still sees the source device.
+function device_dns_intercept(settings) {
+    let value = lc(as_string(type(settings) == "object" ? settings.intercept_device_dns : null));
+    return !(value == "0" || value == "false" || value == "no" || value == "off");
+}
+
 return {
     valid_mac,
     parse,
     from_settings,
-    has_entries
+    has_entries,
+    device_dns_intercept
 };
diff --git a/forkop/files/usr/lib/nft/apply.uc b/forkop/files/usr/lib/nft/apply.uc
index f64c416..512b4e8 100644
--- a/forkop/files/usr/lib/nft/apply.uc
+++ b/forkop/files/usr/lib/nft/apply.uc
@@ -16,6 +16,9 @@ const DNS_SOURCE6_SET = "forkop_dns_sources6";
 const EXCLUDED_SOURCE_SET = "forkop_excluded_sources";
 const EXCLUDED_SOURCE6_SET = "forkop_excluded_sources6";
 const EXCLUDED_MAC_SET = "forkop_excluded_macs";
+
+// settings.intercept_device_dns; set by the *_from_uci entry points.
+let device_dns_intercept = true;
 const BYEDPI_RUNTIME_USER = getenv("BYEDPI_RUNTIME_USER") || "forkopbyedpi";
 const BYEDPI_RUNTIME_UID_OVERRIDE = getenv("BYEDPI_RUNTIME_UID") || "";
 
@@ -827,7 +830,13 @@ function nft_add_section_priority_rules_from_sections(sections, table, interface
 // leaves the mangle chain before any section rule, so section order does
 // not matter. Matching by MAC also covers changing IPv4 leases and IPv6
 // privacy addresses.
+// With intercept_device_dns off their DNS goes to the router resolver
+// instead and may return FakeIP; that traffic goes to the dedicated
+// excluded-tproxy-in inbound, which sing-box routes directly.
 function nft_add_excluded_device_rules(table, interface_set) {
+    if (!device_dns_intercept)
+        return true;
+
     let iif = [ "iifname", "@" + as_string(interface_set) ];
     let port = ":" + as_string(runtime_constants.EXCLUDED_DNS_INBOUND_PORT);
     let matchers = [
@@ -844,6 +853,52 @@ function nft_add_excluded_device_rules(table, interface_set) {
     return true;
 }
 
+function nft_add_excluded_device_fakeip_marks(table, interface_set, fakeip_mark, fakeip_range, fakeip6_range) {
+    if (device_dns_intercept)
+        return true;
+
+    let iif = [ "iifname", "@" + as_string(interface_set) ];
+    let matchers = [
+        [ "ip", "saddr", "@" + EXCLUDED_SOURCE_SET, "ip", "daddr", fakeip_range ],
+        [ "ip6", "saddr", "@" + EXCLUDED_SOURCE6_SET, "ip6", "daddr", fakeip6_range ],
+        [ "ether", "saddr", "@" + EXCLUDED_MAC_SET, "ip", "daddr", fakeip_range ],
+        [ "ether", "saddr", "@" + EXCLUDED_MAC_SET, "ip6", "daddr", fakeip6_range ]
+    ];
+
+    for (let matcher in matchers)
+        for (let proto in [ "tcp", "udp" ])
+            if (!nft_add_rule(table, "mangle", [ ...iif, ...matcher, "meta", "l4proto", proto, "meta", "mark", "set", fakeip_mark, "counter", "accept" ]))
+                return false;
+
+    return true;
+}
+
+// Must precede the generic TPROXY rules: the last tproxy statement wins,
+// so these rules end the chain with accept.
+function nft_add_excluded_device_tproxy(table, interface_set, fakeip_mark, tproxy6_address) {
+    if (device_dns_intercept)
+        return true;
+
+    let iif = [ "iifname", "@" + as_string(interface_set) ];
+    let marked = [ "meta", "mark", "&", fakeip_mark, "==", fakeip_mark ];
+    let port = runtime_constants.EXCLUDED_TPROXY_INBOUND_PORT;
+    let target4 = [ "tproxy", "ip", "to", ":" + as_string(port) ];
+    let target6 = [ "tproxy", "ip6", "to", core_ip.format_ipv6_tproxy_target(tproxy6_address, port) ];
+    let matchers = [
+        [ [ "ip", "saddr", "@" + EXCLUDED_SOURCE_SET ], target4 ],
+        [ [ "ip6", "saddr", "@" + EXCLUDED_SOURCE6_SET ], target6 ],
+        [ [ "ether", "saddr", "@" + EXCLUDED_MAC_SET, "meta", "nfproto", "ipv4" ], target4 ],
+        [ [ "ether", "saddr", "@" + EXCLUDED_MAC_SET, "meta", "nfproto", "ipv6" ], target6 ]
+    ];
+
+    for (let item in matchers)
+        for (let proto in [ "tcp", "udp" ])
+            if (!nft_add_rule(table, "proxy", [ ...iif, ...marked, ...item[0], "meta", "l4proto", proto, ...item[1], "counter", "accept" ]))
+                return false;
+
+    return true;
+}
+
 function nft_add_excluded_device_returns(table, interface_set) {
     let iif = [ "iifname", "@" + as_string(interface_set) ];
     return nft_add_rule(table, "mangle", [ ...iif, "ip", "saddr", "@" + EXCLUDED_SOURCE_SET, "counter", "return" ]) &&
@@ -907,6 +962,7 @@ function nft_create_runtime_base(table, localv4_set, common_set, port_set, ip_po
         !nft_add_rule(table, "dns_redirect", [ "iifname", "@" + as_string(interface_set), "ip6", "saddr", "@" + DNS_SOURCE6_SET, "tcp", "dport", "53", "counter", "redirect", "to", ":" + as_string(runtime_constants.SOURCE_DNS_INBOUND_PORT) ]) ||
         !nft_add_rule(table, "dns_redirect", [ "iifname", "@" + as_string(interface_set), "ip6", "saddr", "@" + DNS_SOURCE6_SET, "udp", "dport", "53", "counter", "redirect", "to", ":" + as_string(runtime_constants.SOURCE_DNS_INBOUND_PORT) ]) ||
         !nft_add_rule(table, "mangle", [ "ct", "status", "dnat", "return" ]) ||
+        !nft_add_excluded_device_fakeip_marks(table, interface_set, fakeip_mark, fakeip_range, fakeip6_range) ||
         !nft_add_excluded_device_returns(table, interface_set) ||
         !nft_add_rule(table, "mangle", [ "iifname", "@" + as_string(interface_set), "ip", "daddr", "@" + as_string(localv4_set), "return" ]) ||
         !nft_add_rule(table, "mangle", [ "iifname", "@" + as_string(interface_set), "ip6", "daddr", "@" + as_string(localv6_set), "ip6", "daddr", "!=", fakeip6_range, "return" ]) ||
@@ -927,6 +983,7 @@ function nft_create_runtime_base(table, localv4_set, common_set, port_set, ip_po
         !nft_add_rule(table, "mangle", [ "iifname", "@" + as_string(interface_set), "ip", "daddr", fakeip_range, "meta", "l4proto", "udp", "meta", "mark", "set", fakeip_mark, "counter" ]) ||
         !nft_add_rule(table, "mangle", [ "iifname", "@" + as_string(interface_set), "ip6", "daddr", fakeip6_range, "meta", "l4proto", "tcp", "meta", "mark", "set", fakeip_mark, "counter" ]) ||
         !nft_add_rule(table, "mangle", [ "iifname", "@" + as_string(interface_set), "ip6", "daddr", fakeip6_range, "meta", "l4proto", "udp", "meta", "mark", "set", fakeip_mark, "counter" ]) ||
+        !nft_add_excluded_device_tproxy(table, interface_set, fakeip_mark, tproxy6_address) ||
         !nft_add_rule(table, "proxy", [ "meta", "mark", "&", fakeip_mark, "==", fakeip_mark, "meta", "l4proto", "tcp", "tproxy", "ip", "to", ":" + as_string(tproxy_port), "counter" ]) ||
         !nft_add_rule(table, "proxy", [ "meta", "mark", "&", fakeip_mark, "==", fakeip_mark, "meta", "l4proto", "udp", "tproxy", "ip", "to", ":" + as_string(tproxy_port), "counter" ]) ||
         !nft_add_rule(table, "proxy", [ "meta", "mark", "&", fakeip_mark, "==", fakeip_mark, "meta", "l4proto", "tcp", "tproxy", "ip6", "to", core_ip.format_ipv6_tproxy_target(tproxy6_address, tproxy_port), "counter" ]) ||
@@ -946,6 +1003,7 @@ function nft_create_runtime_base(table, localv4_set, common_set, port_set, ip_po
 
 function nft_create_runtime_base_from_uci(table, localv4_set, common_set, port_set, ip_port_set, interface_set, fakeip_mark, outbound_mark, fakeip_range, tproxy_port, localv6_set, common6_set, ip_port6_set, fakeip6_range, tproxy6_address) {
     let settings = uci_settings();
+    device_dns_intercept = exclusions.device_dns_intercept(settings);
 
     return nft_create_runtime_base(
         table,
@@ -1547,6 +1605,8 @@ function nft_runtime_signature_from_settings_and_sections(settings, sections) {
     let excluded = exclusions.from_settings(settings);
     if (exclusions.has_entries(excluded))
         body = signature_add_value(body, "settings.routing_excluded_ips", join(" ", [ ...excluded.ips, ...excluded.macs ]));
+    if (!exclusions.device_dns_intercept(settings))
+        body = signature_add_value(body, "settings.intercept_device_dns", "0");
 
     for (let section in sections)
         body = nft_rule_signature_body(body, object_or_empty(section));
@@ -1690,6 +1750,10 @@ function source_aware_dns_values(sections, deferred_sections) {
             continue;
 
         let action = section_action(section);
+        // Without DNS interception only DNS-action sections need the
+        // client address at DNS time; sing-box sorts the rest by source.
+        if (!device_dns_intercept && action != "dns")
+            continue;
 
         if (connections.has_dns_matchers(section)) {
             for (let value in nft_csv_values(section_source_ip_values(section))) {
@@ -1866,12 +1930,14 @@ function nft_populate_runtime_sets_from_uci(populate_enabled, deferred_section_n
     if (!arg_bool(populate_enabled))
         return true;
 
+    device_dns_intercept = exclusions.device_dns_intercept(uci_settings());
     return nft_populate_runtime_sets_from_sections(uci_sections("section"), populate_enabled, deferred_section_names, table, common_set, port_set, ip_port_set, interface_set, localv4_set, mark, common6_set, ip_port6_set, localv6_set);
 }
 
 function nft_populate_runtime_sets_fixture(path, populate_enabled, deferred_section_names, table, common_set, port_set, ip_port_set, interface_set, localv4_set, mark, common6_set, ip_port6_set, localv6_set) {
     let data = object_or_empty(common_read_json_file(path));
     connections.set_item_sections_from_data(data);
+    device_dns_intercept = exclusions.device_dns_intercept(object_or_empty(data.settings));
     return nft_populate_runtime_sets_from_sections(fixture_section_list(data, "section"), populate_enabled, deferred_section_names, table, common_set, port_set, ip_port_set, interface_set, localv4_set, mark, common6_set, ip_port6_set, localv6_set);
 }
 
