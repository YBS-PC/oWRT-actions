diff --git a/forkop/files/usr/lib/singbox/generator.uc b/forkop/files/usr/lib/singbox/generator.uc
index 4c308c4..435ac32 100644
--- a/forkop/files/usr/lib/singbox/generator.uc
+++ b/forkop/files/usr/lib/singbox/generator.uc
@@ -20,6 +20,8 @@ let exclusions = require("config.exclusions");
 let uci = null;
 let fixture_uci_data = null;
 let runtime_settings_cache = null;
+// settings.intercept_device_dns, see config/exclusions.uc.
+let runtime_device_dns_intercept = true;
 let runtime_ruleset_folder = runtime_constants.TMP_RULESET_FOLDER;
 let runtime_supports_xhttp = true;
 let runtime_sing_box_version = "";
@@ -502,6 +504,10 @@ function base_config(settings, service_address, runtime_context) {
         push(inbounds, { type: "direct", tag: runtime_constants.SOURCE_DNS_INBOUND_TAG, listen: runtime_constants.SOURCE_DNS_INBOUND_ADDRESS, listen_port: runtime_constants.SOURCE_DNS_INBOUND_PORT });
     if (runtime_context.excluded_devices_dns)
         push(inbounds, { type: "direct", tag: runtime_constants.EXCLUDED_DNS_INBOUND_TAG, listen: runtime_constants.EXCLUDED_DNS_INBOUND_ADDRESS, listen_port: runtime_constants.EXCLUDED_DNS_INBOUND_PORT });
+    if (runtime_context.excluded_devices_tproxy) {
+        push(inbounds, { type: "tproxy", tag: runtime_constants.EXCLUDED_TPROXY_INBOUND_TAG, listen: runtime_constants.TPROXY_INBOUND_ADDRESS, listen_port: runtime_constants.EXCLUDED_TPROXY_INBOUND_PORT, tcp_fast_open: true, udp_fragment: true });
+        push(inbounds, { type: "tproxy", tag: runtime_constants.EXCLUDED_TPROXY_INBOUND6_TAG, listen: runtime_constants.TPROXY_INBOUND6_ADDRESS, listen_port: runtime_constants.EXCLUDED_TPROXY_INBOUND_PORT, tcp_fast_open: true, udp_fragment: true });
+    }
     for (let inbound in dns_config.inbounds)
         push(inbounds, inbound);
 
@@ -2615,6 +2621,16 @@ function add_source_aware_bypass_dns_rules(config, matchers, rewrite_ttl) {
 
 function add_section_dns_matcher_rule(config, section, matchers, rewrite_ttl) {
     let source_ip_cidr = legacy_condition_values(section, "source_ip_cidr");
+    if (!runtime_device_dns_intercept && length(source_ip_cidr) > 0) {
+        // DNS arrives through the router resolver, so the client is unknown
+        // here: answer with FakeIP for everyone and let the route rule, which
+        // still matches the source address, decide per device.
+        matchers.action = "route";
