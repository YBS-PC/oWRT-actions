+    [EXCLUDED_TPROXY_INBOUND6_TAG]: true,
     [SERVICE_MIXED_INBOUND_TAG]: true,
     [DIRECT_OUTBOUND_TAG]: true,
     [BYPASS_OUTBOUND_TAG]: true
@@ -112,6 +117,9 @@ return {
     EXCLUDED_DNS_INBOUND_TAG,
     EXCLUDED_DNS_INBOUND_ADDRESS,
     EXCLUDED_DNS_INBOUND_PORT,
+    EXCLUDED_TPROXY_INBOUND_TAG,
+    EXCLUDED_TPROXY_INBOUND6_TAG,
+    EXCLUDED_TPROXY_INBOUND_PORT,
     SERVICE_MIXED_INBOUND_TAG,
