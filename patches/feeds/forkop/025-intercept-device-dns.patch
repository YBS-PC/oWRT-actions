diff --git a/tests/device_dns_intercept.sh b/tests/device_dns_intercept.sh
new file mode 100755
index 0000000..684b42a
--- /dev/null
+++ b/tests/device_dns_intercept.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+set -eo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+FORKOP_LIB="$ROOT_DIR/forkop/files/usr/lib"
+NFT_RUNTIME="$FORKOP_LIB/nft/apply.uc"
+GENERATOR="$FORKOP_LIB/singbox/generator.uc"
+WORK_DIR="$(mktemp -d)"
+NFT_LOG="$WORK_DIR/nft.log"
+
+cleanup() {
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+  exit 1
+}
+
+line_of() {
+  grep -Fn "$1" "$NFT_LOG" | head -n 1 | cut -d: -f1
+}
+
+mkdir -p "$WORK_DIR/bin"
+for tool in nft ip logger sysctl; do
+  cat >"$WORK_DIR/bin/$tool" <<'SH'
+#!/usr/bin/env bash
+if [ "$(basename "$0")" = "nft" ]; then
+  { printf 'nft'; for arg in "$@"; do printf '\t%s' "$arg"; done; printf '\n'; } >>"$NFT_LOG"
+fi
+exit 0
+SH
+  chmod +x "$WORK_DIR/bin/$tool"
+done
+
+runtime_base() {
+  : >"$NFT_LOG"
+  PATH="$WORK_DIR/bin:$PATH" NFT_LOG="$NFT_LOG" FORKOP_UCI_STATE_FILE="$1" \
+    ucode -L "$FORKOP_LIB" "$NFT_RUNTIME" nft-create-runtime-base-from-uci \
+      ForkopTable localv4 forkop_subnets forkop_ports forkop_ip_ports forkop_interfaces \
+      0x00100000 0x00200000 198.18.0.0/15 1602 ||
+    fail "runtime base failed for $1"
+}
+
+# --- nftables: default keeps intercepting ----------------------------------
+
+cat >"$WORK_DIR/default.state" <<'EOF_UCI'
+forkop.settings=settings
+forkop.settings.source_network_interfaces=br-lan
+forkop.settings.routing_excluded_ips=192.168.1.50 aa:bb:cc:dd:ee:ff
+EOF_UCI
+runtime_base "$WORK_DIR/default.state"
+grep -Fq $'redirect\tto\t:1605' "$NFT_LOG" || fail "default must redirect excluded DNS to :1605"
+grep -Fq ':1606' "$NFT_LOG" && fail "default must not use the excluded TPROXY inbound"
+
+# --- nftables: interception off --------------------------------------------
+
+sed 's/^forkop.settings=settings$/&\nforkop.settings.intercept_device_dns=0/' "$WORK_DIR/default.state" >"$WORK_DIR/off.state"
+runtime_base "$WORK_DIR/off.state"
+
+grep -Fq ':1605' "$NFT_LOG" && fail "interception off must not redirect excluded DNS"
+for expected in \
+  $'mangle\tiifname\t@forkop_interfaces\tip\tsaddr\t@forkop_excluded_sources\tip\tdaddr\t198.18.0.0/15\tmeta\tl4proto\ttcp\tmeta\tmark\tset\t0x00100000\tcounter\taccept' \
+  $'mangle\tiifname\t@forkop_interfaces\tether\tsaddr\t@forkop_excluded_macs\tip6\tdaddr\tfc00::/18\tmeta\tl4proto\tudp\tmeta\tmark\tset\t0x00100000\tcounter\taccept' \
+  $'proxy\tiifname\t@forkop_interfaces\tmeta\tmark\t&\t0x00100000\t==\t0x00100000\tip\tsaddr\t@forkop_excluded_sources\tmeta\tl4proto\ttcp\ttproxy\tip\tto\t:1606\tcounter\taccept' \
+  $'proxy\tiifname\t@forkop_interfaces\tmeta\tmark\t&\t0x00100000\t==\t0x00100000\tether\tsaddr\t@forkop_excluded_macs\tmeta\tnfproto\tipv6\tmeta\tl4proto\tudp\ttproxy\tip6\tto\t[::1]:1606\tcounter\taccept'; do
+  grep -Fq "$expected" "$NFT_LOG" || fail "missing nft command: $expected"
+done
+
+fakeip_mark="$(line_of $'@forkop_excluded_sources\tip\tdaddr\t198.18.0.0/15\tmeta\tl4proto\ttcp')"
+excluded_return="$(line_of $'ip\tsaddr\t@forkop_excluded_sources\tcounter\treturn')"
+[ "$fakeip_mark" -lt "$excluded_return" ] || fail "FakeIP traffic of excluded devices must be marked before their return"
+excluded_tproxy="$(line_of $'tproxy\tip\tto\t:1606')"
+generic_tproxy="$(line_of $'tproxy\tip\tto\t:1602')"
+[ "$excluded_tproxy" -lt "$generic_tproxy" ] || fail "excluded TPROXY must precede the generic TPROXY rule"
+
+# --- nftables: only DNS sections keep source-aware DNS ---------------------
+
+cat >"$WORK_DIR/populate.json" <<'JSON'
+{
+  "settings": { ".name": "settings", ".type": "settings", "intercept_device_dns": "0" },
+  "section": [
+    { ".name": "tv", ".type": "section", "enabled": "1", "action": "bypass", "fully_routed_ips": [ "192.168.1.60" ] },
+    { ".name": "kids", ".type": "section", "enabled": "1", "action": "connection",
+      "outbound_json": "{\"type\":\"socks\",\"server\":\"127.0.0.1\",\"server_port\":1080,\"version\":\"5\"}",
+      "source_ip_cidr": [ "192.168.1.61" ], "domain_suffix": [ "example.org" ] },
+    { ".name": "dnsonly", ".type": "section", "enabled": "1", "action": "dns", "dns_server": "9.9.9.9",
+      "fully_routed_ips": [ "192.168.1.70" ] }
+  ]
+}
+JSON
+: >"$NFT_LOG"
+PATH="$WORK_DIR/bin:$PATH" NFT_LOG="$NFT_LOG" \
+  ucode -L "$FORKOP_LIB" "$NFT_RUNTIME" nft-populate-runtime-sets-fixture "$WORK_DIR/populate.json" 1 "" \
+    ForkopTable forkop_subnets forkop_ports forkop_ip_ports forkop_interfaces localv4 0x00100000 ||
+  fail "populate with interception off failed"
+dns_sources="$(grep -F $'\tforkop_dns_sources\t' "$NFT_LOG" || true)"
+printf '%s' "$dns_sources" | grep -Fq '192.168.1.70' || fail "DNS section devices must still be intercepted"
+printf '%s' "$dns_sources" | grep -Eq '192\.168\.1\.6[01]' && fail "bypass/connection device filters must not intercept DNS"
+
+# --- sing-box config --------------------------------------------------------
+
+cat >"$WORK_DIR/fixture.json" <<'JSON'
+{
+  "settings": {
+    ".name": "settings",
+    ".type": "settings",
+    "config_path": "/tmp/sing-box/config.json",
+    "dns_server": "1.1.1.1",
+    "bootstrap_dns_server": "1.1.1.1",
+    "service_listen_address": "127.0.0.1",
+    "intercept_device_dns": "0",
+    "routing_excluded_ips": [ "192.168.1.50", "aa:bb:cc:dd:ee:ff" ]
+  },
+  "section": [
+    { ".name": "tv", ".type": "section", "enabled": "1", "action": "bypass",
+      "fully_routed_ips": [ "192.168.1.60" ], "domain_suffix": [ "tv.example" ] },
+    { ".name": "kids", ".type": "section", "enabled": "1", "action": "outbound",
+      "outbound_json": "{\"type\":\"socks\",\"server\":\"127.0.0.1\",\"server_port\":1080,\"version\":\"5\"}",
+      "source_ip_cidr": [ "192.168.1.61" ], "domain_suffix": [ "example.org" ] }
+  ]
+}
+JSON
+
+generate_for_version() {
+  local version="$1" output="$2"
+  mkdir -p "$output.section-cache" "$output.rulesets"
+  ucode -L "$FORKOP_LIB" "$GENERATOR" generate-config-fixture \
+    "$WORK_DIR/fixture.json" "$output" "127.0.0.1" "0" "1" "" "$version"
+}
+
+check_config() {
+  ucode -e '
+let config = json(require("fs").readfile(ARGV[0]));
+
+function assert(condition, message) {
+    if (!condition)
+        die(message + "\n");
+}
+
+function has(list, value) {
+    if (type(list) != "array")
+        return list == value;
+    for (let item in list)
+        if (item == value)
+            return true;
+    return false;
+}
+
+let tags = {};
+for (let inbound in config.inbounds)
+    tags[inbound.tag] = inbound;
+assert(tags["excluded-tproxy-in"] && tags["excluded-tproxy-in"].type == "tproxy" && tags["excluded-tproxy-in"].listen_port == 1606, "excluded-tproxy-in on 1606");
+assert(tags["excluded-tproxy6-in"] && tags["excluded-tproxy6-in"].listen == "::1", "excluded-tproxy6-in on ::1");
+assert(!tags["excluded-dns-in"] && !tags["source-dns-in"], "no DNS interception inbounds");
+
+let excluded_route = null, section_route = null;
+for (let i = 0; i < length(config.route.rules); i++) {
+    let rule = config.route.rules[i];
+    if (has(rule.inbound, "excluded-tproxy-in") && rule.outbound == "bypass-out")
+        excluded_route = i;
+    if (section_route == null && rule.source_ip_cidr != null && has(rule.inbound, "tproxy-in"))
+        section_route = i;
+}
+assert(excluded_route != null && excluded_route < section_route, "excluded TPROXY traffic goes direct before section rules");
+
+for (let server in config.dns.servers)
+    assert(server.tag != "dnsmasq-server", "no dnsmasq round trip without interception");
+let fakeip_for_filtered = false;
+for (let rule in config.dns.rules) {
+    assert(rule.source_ip_cidr == null && !has(rule.inbound, "source-dns-in") && !has(rule.inbound, "excluded-dns-in"),
+        "DNS rules must not depend on the client");
+    if (has(rule.domain_suffix, "example.org"))
+        fakeip_for_filtered = rule.server == "fakeip-server";
+}
+assert(fakeip_for_filtered, "device-filtered section domains resolve to FakeIP for everyone");
+' "$1" || fail "$2"
+}
+
+generate_for_version "1.13.21" "$WORK_DIR/sb113.json"
+check_config "$WORK_DIR/sb113.json" "sing-box 1.13 config without DNS interception"
+generate_for_version "1.14.2" "$WORK_DIR/sb114.json"
+check_config "$WORK_DIR/sb114.json" "sing-box 1.14 config without DNS interception"
+
+for bin in ${FORKOP_TEST_SING_BOX_113:-} ${FORKOP_TEST_SING_BOX_114:-}; do
+  [ -x "$bin" ] || continue
+  case "$("$bin" version | head -n1)" in
+    *" 1.14."*) cfg="$WORK_DIR/sb114.json" ;;
+    *) cfg="$WORK_DIR/sb113.json" ;;
+  esac
+  "$bin" check -c "$cfg" || fail "sing-box check rejected $cfg ($bin)"
+done
+
+printf 'device DNS interception checks passed\n'
