Forkop 1.0.5 (ushan0v/forkop): fix ucode forward references and
APK-incompatible prerm hook.

- ucode resolves identifiers at compile time: a top-level function called
  before its declaration fails at runtime with "left-hand side is not a
  function" (lock release, owner pid, mwan3 check, TLS defaults).
  Functions are moved above their first caller.
- Package/forkop/prerm was ucode; with CONFIG_USE_APK (OpenWrt 25.12)
  package-pack.mk inlines it into the /bin/sh pre-deinstall script.
  Rewritten in POSIX sh.

Apply with: patch -p1 -d feeds/forkop
---
diff --git a/forkop/Makefile b/forkop/Makefile
index 14c305b..98e6c0b 100644
--- a/forkop/Makefile
+++ b/forkop/Makefile
@@ -39,13 +39,14 @@ endef
 define Build/Compile
 endef
 
+# Must stay POSIX sh: with CONFIG_USE_APK (OpenWrt 25.12+) the buildroot
+# inlines this body into the /bin/sh pre-deinstall script.
 define Package/forkop/prerm
-#!/usr/bin/ucode
-
-if (getenv("IPKG_INSTROOT") == null || getenv("IPKG_INSTROOT") == "")
-	system("/usr/bin/forkop package_prerm " + (ARGV[0] || "") + " >/dev/null 2>&1");
+#!/bin/sh
 
-exit(0);
+[ -n "$${IPKG_INSTROOT}" ] && exit 0
+/usr/bin/forkop package_prerm "$${1:-remove}" >/dev/null 2>&1 || true
+exit 0
 endef
 
 define Package/forkop/postinst
