+/**
+ * Counters of an interface are ingress (up_*) and egress (down_*). On a LAN
+ * interface ingress is what devices send; on a WAN interface it is what comes
+ * from outside, so for WAN zones the two directions are swapped for display.
+ */
+function isWanZone(zone) {
+	return /^wan/.test(String(zone || ''));
+}
+
+function swapUpDown(x) {
+	if (!x || typeof x !== 'object') return x;
+	var o = {};
+	Object.keys(x).forEach(function (k) {
+		var m = /^(up|down)_(.*)$/.exec(k);
+		o[m ? (m[1] === 'up' ? 'down_' : 'up_') + m[2] : k] = x[k];
+	});
+	return o;
+}
+
+/** Interface name with its firewall zone, when the zone is known. */
+function ifaceLabel(o) {
+	var zone = o && o.zone != null ? String(o.zone) : '';
+	return o.ifname + (zone && zone !== 'unknown' ? ' (' + zone + ')' : '');
+}
+
 function formatEntriesPillText(n) {
-	return String(Math.max(0, asNum(n))) + ' ' + _('entries');
