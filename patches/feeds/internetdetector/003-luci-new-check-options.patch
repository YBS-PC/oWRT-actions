+++ b/luci-app-internet-detector/root/usr/libexec/rpcd/luci.internet-detector
@@ -76,8 +76,86 @@ local function uiPoll()
 	return InternetDetector:inetStatus()
 end
 
+local function jsonString(s)
+	return '"' .. tostring(s):gsub('[%c"\\]', function(c)
+		return string.format("\\u%04x", string.byte(c))
+	end) .. '"'
+end
+
+local function shellQuote(s)
+	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
+end
+
+-- Value of a string field from the JSON of rpcd call arguments
+local function jsonParam(input, key)
+	local s = input:match('"' .. key .. '"%s*:%s*"()')
+	if not s then
+		return ""
+	end
+	local out, i = {}, s
+	while i <= #input do
+		local c = input:sub(i, i)
+		if c == '"' then
+			break
+		elseif c == "\\" then
+			local n = input:sub(i + 1, i + 1)
+			if n == "u" then
+				out[#out + 1] = string.char(tonumber(input:sub(i + 2, i + 5), 16) % 256)
+				i = i + 6
+			else
+				out[#out + 1] = ({ n = "\n", t = "\t", r = "\r", b = "\b", f = "\f" })[n] or n
+				i = i + 2
+			end
+		else
+			out[#out + 1] = c
+			i = i + 1
+		end
+	end
+	return table.concat(out)
+end
+
+-- Outbounds of sing-box from its Clash API (GET /proxies). Empty url:
+-- homeproxy's controller and secret, as the daemon does.
+local function clashProxies(input)
+	local url    = jsonParam(input, "url")
+	local secret = jsonParam(input, "secret")
+	if url == "" then
+		local uciCursor = uci.cursor()
+		local ctl = uciCursor:get("homeproxy", "infra", "clash_api_controller")
+		if ctl and ctl ~= "" then
+			ctl = ctl:gsub("^0%.0%.0%.0:", "127.0.0.1:"):gsub("^%[::%]:", "[::1]:"):gsub("^:", "127.0.0.1:")
+			url = "http://" .. ctl
+			if secret == "" then
+				secret = uciCursor:get("homeproxy", "infra", "clash_api_secret") or ""
+			end
+		else
+			url = "http://127.0.0.1:9090"
+		end
+	end
+	url = url:gsub("/+$", "")
+	if not url:match("^https?://[%w%.%-]+:?%d*$") and not url:match("^https?://%[[%x:]+%]:?%d*$") then
+		return string.format('{"url":%s,"error":"invalid URL"}', jsonString(url))
+	end
+	if not unistd.access(curlExec, "x") then
