+function idErrorText(code) {
+	let m = String(code || '').match(/^([a-z-]+)(?::(\d+))?$/);
+	if(!m) {
+		return String(code || '');
+	};
+	let n = m[2];
+	switch(m[1]) {
+		case 'curl':
+			return ({ 6: _('name resolution failed'), 7: _('connection refused'),
+				28: _('timeout'), 35: _('TLS error'), 60: _('TLS error') })[n] || 'curl ' + n;
+		case 'http':
+			return 'HTTP ' + n;
+		case 'clash':
+			return ({ 401: _('Clash API: wrong secret'), 404: _('Clash API: no such outbound'),
+				503: _('outbound test failed'), 504: _('outbound test timeout') })[n] || 'Clash API: HTTP ' + n;
+		case 'clash-curl':
+			return (n == '7') ? _('Clash API is not available') : 'Clash API: curl ' + n;
+		case 'dns':
+			return _('name resolution failed');
+		case 'tcp':
+			return _('no TCP connection');
+		case 'ping':
+			return _('no ICMP reply');
+	};
+	return _('check error');
+}
+
+// instances: [{ instance, inet, latency, checked, error, mod_public_ip }]
+function idRenderCards(instances, describe, waiting) {
+	let lang = document.documentElement.lang || undefined;
+	let cards = [];
+	for(let i of instances) {
+		let cls   = 'id-wait', state = _('Checking...');
+		if(i.inet == 0) {
+			cls = 'id-ok';   state = _('Connected');
+		} else if(i.inet == 1) {
+			cls = 'id-down'; state = _('Disconnected');
+		};
+		let desc = describe ? describe(i.instance) : null;
+		let rows = [];
+		if(i.inet == 0 && i.latency !== undefined) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Latency')), E('b', {}, '%s %s'.format(i.latency, _('msec'))) ]));
+		};
+		if(i.inet == 1 && i.error) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Reason')), E('b', {}, idErrorText(i.error)) ]));
+		};
+		if(i.mod_public_ip !== undefined) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Public IP')),
+				E('b', { 'class': 'id-ip' }, (i.mod_public_ip == '') ? _('Undefined') : i.mod_public_ip) ]));
+		};
+		if(i.checked) {
+			let d = new Date(i.checked * 1000);
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Last check')), E('b', { 'title': d.toLocaleString(lang) }, d.toLocaleTimeString(lang)) ]));
+		};
+		cards.push(E('div', { 'class': 'id-card ' + cls }, [
+			E('div', { 'class': 'id-card-head' }, [
+				E('span', { 'class': 'id-dot' }),
+				E('span', { 'class': 'id-name' }, i.instance),
+				(desc && desc != i.instance) ? E('span', { 'class': 'id-desc', 'title': desc }, desc) : '',
+				E('span', { 'class': 'id-state' }, state),
+			]),
+		].concat(rows)));
+	};
+	if(cards.length == 0) {
+		cards.push(E('div', { 'class': 'id-card ' + (waiting ? 'id-wait' : '') }, [
+			E('div', { 'class': 'id-card-head' }, [
+				E('span', { 'class': 'id-dot' }),
+				E('span', { 'class': 'id-name' }, _('Internet')),
+				E('span', { 'class': 'id-state' }, waiting ? _('Checking...') : _('Undefined')),
+			]),
+		]));
+	};
+	return E('div', { 'class': 'id-cards' }, cards);
+}
