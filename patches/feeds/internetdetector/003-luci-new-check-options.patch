+		};
+		if(i.inet == 1 && i.error) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Reason')), E('b', {}, idErrorText(i.error)) ]));
+		};
+		if(i.mod_public_ip !== undefined) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Public IP')),
+				E('b', { 'class': 'id-ip' }, (i.mod_public_ip == '') ? _('Undefined') : i.mod_public_ip) ]));
+		};
+		if(i.checked) {
+			let d = new Date(i.checked * 1000);
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Last check')), E('b', { 'title': d.toLocaleString(lang) }, d.toLocaleTimeString(lang)) ]));
+		};
+		cards.push(E('div', { 'class': 'id-card ' + cls }, [
+			E('div', { 'class': 'id-card-head' }, [
+				E('span', { 'class': 'id-dot' }),
+				E('span', { 'class': 'id-name' }, i.instance),
+				(desc && desc != i.instance) ? E('span', { 'class': 'id-desc', 'title': desc }, desc) : '',
+				E('span', { 'class': 'id-state' }, state),
+			]),
+		].concat(rows)));
