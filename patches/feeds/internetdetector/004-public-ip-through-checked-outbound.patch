From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 12:00:00 +0000
Subject: [PATCH] internet-detector: public IP through the outbound of the
 outbound check
Requires: 001-check-fixes-ip-version-outbound-check 002-public-ip-dns-ipv6-providers 003-luci-new-check-options

With the check "sing-box outbound (Clash API)" the public IP module
requested the provider with curl from the router. On a router with
homeproxy such a connection goes through sing-box by the routing rules,
so the address was the one of the route to the provider, not of the
outbound that the instance checks.

Now, with the Clash API of homeproxy (empty address of the instance) and
the inbound check-in in the homeproxy config (patch 023 of homeproxy:
mixed on 127.0.0.1, user name and password - the tag of an outbound),
the HTTP request goes through that inbound as the user of the outbound
that answered the last check: sing-box sends it through this outbound,
before the routing rules.

- main.lua: the tag of the outbound that answered is kept; its port of
  check-in is read from /var/run/homeproxy/sing-box-c.json with
  jsonfilter (again when the file changes); the status file has the
  field "outbound" (the outbound as it is set in the instance).
- mod_public_ip: through check-in the interface and the proxy of the
  instance are not used (the connection is to 127.0.0.1), and neither
  --ipv4 / --ipv6: the IP version is the one the server of the outbound
  reaches the provider by (url6 - a host with IPv6 only). A DNS provider
  (UDP) is not asked then, a warning goes to the log once and the
  fallback provider is asked. The same address of both IP versions is
  shown once.
- LuCI: the row "Outbound" in the status card, a note at the provider.

Without check-in (other Clash API address, homeproxy without patch 023,
another check type) the requests go as before.

diff --git a/internet-detector/files/usr/lib/lua/internet-detector/main.lua b/internet-detector/files/usr/lib/lua/internet-detector/main.lua
index cafb8e24..c35f87ba 100644
--- a/internet-detector/files/usr/lib/lua/internet-detector/main.lua
+++ b/internet-detector/files/usr/lib/lua/internet-detector/main.lua
@@ -90,6 +90,12 @@ local InternetDetector = {
 	lastCheck        = nil,	-- time of the last completed check
 	lastError        = nil,	-- reason of the last failed check (shown in LuCI)
 	outboundTags     = {},
+	lastOutbound     = nil,	-- outbound check: the outbound that answered (as set)
+	lastOutboundTag  = nil,	-- and its sing-box tag
+	-- homeproxy config with the inbound check-in (patch 023 of homeproxy)
+	homeproxyConfig  = "/var/run/homeproxy/sing-box-c.json",
+	checkInMtime     = nil,
+	checkInPort      = nil,
 }
 InternetDetector.configDir      = string.format("/etc/%s", InternetDetector.appName)
 InternetDetector.modulesDir     = string.format(
@@ -182,6 +188,9 @@ function InternetDetector:statusJson(inet, instance, t)
 	if self.lastCheck then
 		lines[#lines + 1] = string.format('"checked":%d', self.lastCheck)
 	end
+	if inet == 0 and self.lastOutbound then
+		lines[#lines + 1] = string.format('"outbound":%s', self:jsonString(self.lastOutbound))
+	end
 	if inet == 1 and self.lastError then
 		lines[#lines + 1] = string.format('"error":%s', self:jsonString(self.lastError))
 	end
@@ -641,6 +650,7 @@ function InternetDetector:checkClashOutbound(tag)
 		os.time(), url, retCode, tostring(httpCode), tostring(delay)))
 
 	if retCode == 0 and httpCode == 200 and delay and delay > 0 then
+		self.lastOutboundTag = tag
 		return 0, delay
 	end
 	if retCode ~= 0 then
@@ -649,6 +659,42 @@ function InternetDetector:checkClashOutbound(tag)
 	return 1, nil, "clash:" .. tostring(httpCode)
 end
 
+-- Requests of the instance (public IP) through the outbound that answered
+-- the check: by the inbound check-in of homeproxy, mixed on 127.0.0.1, user
+-- name and password - the tag of the outbound. Only with homeproxy's Clash
+-- API (empty address) and if its config has this inbound; otherwise nil
+-- and the requests go as before, by the routing rules.
+function InternetDetector:checkInProxy()
+	local sc  = self.serviceConfig
+	local tag = self.lastOutboundTag
+	if sc.check_type ~= 3 or not tag or
+		(sc.clash_api_url and tostring(sc.clash_api_url) ~= "") then
+		return nil
+	end
+	local st = stat.stat(self.homeproxyConfig)
+	if not st then
+		self.checkInMtime, self.checkInPort = nil, nil
+		return nil
+	end
+	if st.st_mtime ~= self.checkInMtime then
+		self.checkInMtime = st.st_mtime
+		self.checkInPort  = nil
+		local fh = io.popen(string.format(
+			"jsonfilter -i %s -e '@.inbounds[@.tag=\"check-in\"].listen_port' 2>/dev/null",
+			self:shellQuote(self.homeproxyConfig)), "r")
+		if fh then
+			self.checkInPort = tonumber((fh:read("*a") or ""):match("^%s*(%d+)"))
+			fh:close()
+		end
+	end
+	if not self.checkInPort then
+		return nil
+	end
+	return string.format(" --proxy %s --proxy-user %s",
+		self:shellQuote(string.format("socks5h://127.0.0.1:%d", self.checkInPort)),
+		self:shellQuote(tag .. ":" .. tag))
+end
+
 function InternetDetector:exit()
 	for _, e in ipairs(self.modules) do
 		e:onExit()
@@ -743,6 +789,9 @@ function InternetDetector:mainLoop()
 						inetChecked = true
 						self.lastLatency = tonumber(latency)
 						self.lastError   = nil
+						if self.serviceConfig.check_type == 3 then
+							self.lastOutbound = addr
+						end
 					else
 						self.lastError = reason
 						attempt = attempt + 1
diff --git a/internet-detector/files/usr/lib/lua/internet-detector/modules/mod_public_ip.lua b/internet-detector/files/usr/lib/lua/internet-detector/modules/mod_public_ip.lua
index df422c1c..7f66199b 100644
--- a/internet-detector/files/usr/lib/lua/internet-detector/modules/mod_public_ip.lua
+++ b/internet-detector/files/usr/lib/lua/internet-detector/modules/mod_public_ip.lua
@@ -157,8 +157,18 @@ local Module = {
 	_IPFalseCounter      = 0,
 	_interval            = 600,
 	_DNSPackets          = {},
+	_dnsSkipLogged       = false,
 }
 
+-- curl arguments of the inbound check-in of homeproxy (the outbound that
+-- answered the check) or nil
+function Module:checkInProxy()
+	local c = self.config
+	if type(c) == "table" and type(c.checkInProxy) == "function" then
+		return c:checkInProxy()
+	end
+end
+
 function Module:shellQuote(s)
 	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
 end
@@ -479,6 +489,10 @@ end
 function Module:httpRequest(url, family, headers)
 	local retCode, data = 1, nil
 	local sc   = self.config.serviceConfig
+	-- Through check-in the IP version is the one the outbound reaches the
+	-- host by (url6 - a host with IPv6 only), the interface and the proxy
+	-- of the instance are not used: the connection is to 127.0.0.1.
+	local checkIn = self:checkInProxy()
 	local hdr  = {}
 	for _, h in ipairs(headers or {}) do
 		hdr[#hdr + 1] = " -H " .. self:shellQuote(h)
@@ -486,9 +500,9 @@ function Module:httpRequest(url, family, headers)
 	local curl = string.format(
 		'%s%s%s%s --connect-timeout %d --max-time %d %s%s %s; printf "\\n%%s" "$?"',
 		self.curlExec,
-		(family == 6) and " --ipv6" or " --ipv4",
-		sc.iface and (" --interface " .. self:shellQuote(sc.iface)) or "",
-		self.config.proxyString or "",
+		checkIn and "" or ((family == 6) and " --ipv6" or " --ipv4"),
+		(sc.iface and not checkIn) and (" --interface " .. self:shellQuote(sc.iface)) or "",
+		checkIn or self.config.proxyString or "",
 		self.timeout,
 		self.timeout * 2,
 		self.curlParams,
@@ -561,6 +575,16 @@ end
 
 function Module:requestIP(provider, family)
 	local ip
+	if provider.type == "dns" and self:checkInProxy() then
+		-- a DNS request (UDP) can not go through check-in
+		if not self._dnsSkipLogged then
+			self._dnsSkipLogged = true
+			self.syslog("warning", string.format(
+				"%s: %s (DNS) is not used with the outbound check, choose an HTTP provider",
+				self.name, provider.name))
+		end
+		return nil
+	end
 	if provider.type == "dns" then
 		ip = self:requestIPDNS(provider, family)
 	else
@@ -582,14 +606,19 @@ function Module:requestIP(provider, family)
 end
 
 -- One request per IP version (the fallback provider if the first one
--- gives nothing); the addresses joined by ", "
+-- gives nothing); the addresses joined by ", ". Through an outbound the
+-- version is the one its server reaches the provider by, so both requests
+-- can give the same address: it is shown once.
 function Module:requestIPs()
-	local ips = {}
+	local ips, seen = {}, {}
 	for _, family in ipairs(self._families) do
 		for _, provider in ipairs(self._providers) do
 			local ip = self:requestIP(provider, family)
 			if ip then
-				ips[#ips + 1] = ip
+				if not seen[ip] then
+					seen[ip]      = true
+					ips[#ips + 1] = ip
+				end
 				break
 			end
 		end
diff --git a/luci-app-internet-detector/htdocs/luci-static/resources/view/internet-detector.js b/luci-app-internet-detector/htdocs/luci-static/resources/view/internet-detector.js
