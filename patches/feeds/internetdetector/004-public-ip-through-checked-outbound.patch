 	return _('check error');
 }
 
-// instances: [{ instance, inet, latency, checked, error, mod_public_ip }]
+// instances: [{ instance, inet, latency, outbound, checked, error, mod_public_ip }]
 function idRenderCards(instances, describe, waiting) {
 	let lang = document.documentElement.lang || undefined;
 	let cards = [];
@@ -173,6 +173,10 @@ function idRenderCards(instances, describe, waiting) {
 			rows.push(E('div', { 'class': 'id-kv' }, [
 				E('span', {}, _('Latency')), E('b', {}, '%s %s'.format(i.latency, _('msec'))) ]));
 		};
+		if(i.inet == 0 && i.outbound) {
+			rows.push(E('div', { 'class': 'id-kv' }, [
+				E('span', {}, _('Outbound')), E('b', {}, i.outbound) ]));
+		};
 		if(i.inet == 1 && i.error) {
 			rows.push(E('div', { 'class': 'id-kv' }, [
 				E('span', {}, _('Reason')), E('b', {}, idErrorText(i.error)) ]));
@@ -1788,6 +1792,7 @@ return view.extend({
 				'mod_public_ip_provider', _('Provider'),
 				_('Service for determining the public IP address.') + '<br />' +
 				_('In brackets: the network that serves the provider. The address is that of the route to the provider: with routing by addresses of that network it is the address of that route.') + '<br />' +
+				_('With the check "sing-box outbound (Clash API)" and the Clash API of homeproxy (empty address) the request goes through the outbound that answered the check, by the inbound check-in of homeproxy, not by its routing rules. DNS providers are not used then; the IP version is the one the server of the outbound reaches the provider by: for IPv4 or IPv6 choose a provider with separate addresses for them.') + '<br />' +
 				((this.curlExec) ? '' :
 					_('To support HTTP services, you need to install curl.'))
 			);
