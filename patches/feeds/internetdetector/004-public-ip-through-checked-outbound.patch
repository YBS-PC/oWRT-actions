diff --git a/luci-app-internet-detector/po/ru/internet-detector.po b/luci-app-internet-detector/po/ru/internet-detector.po
index c8487542..3a757b3f 100644
--- a/luci-app-internet-detector/po/ru/internet-detector.po
+++ b/luci-app-internet-detector/po/ru/internet-detector.po
@@ -889,3 +889,20 @@ msgstr "узел маршрутизации"
 
 msgid "timeout"
 msgstr "таймаут"
+
+msgid "Outbound"
+msgstr "Выход"
+
+msgid ""
+"With the check \"sing-box outbound (Clash API)\" and the Clash API of "
+"homeproxy (empty address) the request goes through the outbound that "
+"answered the check, by the inbound check-in of homeproxy, not by its routing "
+"rules. DNS providers are not used then; the IP version is the one the server "
+"of the outbound reaches the provider by: for IPv4 or IPv6 choose a provider "
+"with separate addresses for them."
+msgstr ""
+"При проверке «Выход sing-box (Clash API)» с Clash API homeproxy (пустой "
+"адрес) запрос идёт через выход, ответивший на проверку, — через вход "
+"check-in homeproxy, а не по его правилам маршрутизации. DNS-провайдеры при "
+"этом не используются; версию IP выбирает сервер выхода: для IPv4 или IPv6 "
+"выбирайте провайдера с отдельными адресами для них."
