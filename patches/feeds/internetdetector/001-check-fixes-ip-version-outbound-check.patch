+-- The HTTP code comes from curl (-w), not from the first header line:
+-- through an HTTP proxy that line is the answer of the proxy itself
+-- ("200 Connection established").
+function InternetDetector:checkURL(url)
+	local method = (self.serviceConfig.http_method == "get") and "" or " --head"
+	local curl   = self:curlCommand(url, method .. " -o /dev/null -w '%{http_code} %{time_total}'")
+	local retCode, data = self:runCommand(curl)
+	local httpCode, total
+	if data then
+		httpCode, total = data:match("(%d+) ([%d.,]+)%s*$")
+		httpCode = tonumber(httpCode)
+		total    = tonumber((tostring(total or ""):gsub(",", ".")))
 	end
