+-- sing-box Clash API: GET /proxies/<tag>/delay runs the URL test of
+-- clash_api_test_url through this outbound only, whatever the routing
+-- rules say. Answer {"delay":N} (ms) with HTTP 200 means it works.
+-- Address and secret of the Clash API: the options of the instance, or
+-- homeproxy's controller if the address is empty (0.0.0.0 / :: -> loopback).
+function InternetDetector:resolveClashApi()
+	local sc     = self.serviceConfig
+	local url    = sc.clash_api_url and tostring(sc.clash_api_url) or ""
+	local secret = sc.clash_api_secret and tostring(sc.clash_api_secret) or ""
+	if url == "" then
+		local ctl = uciCursor:get("homeproxy", "infra", "clash_api_controller")
+		if ctl and ctl ~= "" then
+			ctl = ctl:gsub("^0%.0%.0%.0:", "127.0.0.1:"):gsub("^%[::%]:", "[::1]:"):gsub("^:", "127.0.0.1:")
+			url = "http://" .. ctl
+			if secret == "" then
+				secret = uciCursor:get("homeproxy", "infra", "clash_api_secret") or ""
+			end
+		else
+			url = "http://127.0.0.1:9090"
+		end
+	end
+	self.clashApiUrl    = (url:gsub("/+$", ""))
+	self.clashApiSecret = secret
+end
+
+-- Outbound tag: a tag as it is (cfg-...-out, direct-out), or the name or
+-- label of a homeproxy routing node or node. homeproxy names the outbound
+-- of a routing node after its node (cfg-<node>-out), of an urltest routing
+-- node after the routing node itself.
+function InternetDetector:resolveOutboundTag(tag)
+	tag = tostring(tag)
+	if self.outboundTags[tag] then
+		return self.outboundTags[tag]
 	end
-	return (not self.curlHttpOkCodes[httpCode]) and 1 or 0
+	local res = tag
+	if not tag:match("^cfg%-.+%-out$") and tag ~= "direct-out" and tag ~= "block-out" then
+		local function routingTag(name)
+			local node = uciCursor:get("homeproxy", name, "node")
+			if node == "urltest" then
+				return "cfg-" .. name .. "-out"
+			elseif node and node ~= "" then
+				return "cfg-" .. node .. "-out"
+			end
+		end
+		local stype = uciCursor:get("homeproxy", tag)
+		local found
+		if stype == "routing_node" then
+			found = routingTag(tag)
+		elseif stype == "node" then
+			found = "cfg-" .. tag .. "-out"
+		else
+			uciCursor:foreach("homeproxy", "routing_node", function(s)
+				if not found and s.label == tag then
+					found = routingTag(s[".name"])
+				end
+			end)
+			if not found then
+				uciCursor:foreach("homeproxy", "node", function(s)
+					if not found and s.label == tag then
+						found = "cfg-" .. s[".name"] .. "-out"
+					end
+				end)
+			end
+		end
+		res = found or tag
+	end
+	self.outboundTags[tag] = res
+	return res
+end
+
+function InternetDetector:checkClashOutbound(tag)
+	local sc   = self.serviceConfig
+	if not self.clashApiUrl then
+		self:resolveClashApi()
+	end
+	tag = self:resolveOutboundTag(tag)
+	local base = self.clashApiUrl
+	local url  = string.format("%s/proxies/%s/delay?url=%s&timeout=%d",
+		base,
+		self:urlEncode(tag),
+		self:urlEncode(sc.clash_api_test_url or "https://www.gstatic.com/generate_204"),
+		sc.connection_timeout * 1000)
+	local auth = ""
+	if self.clashApiSecret ~= "" then
+		auth = " -H " .. self:shellQuote("Authorization: Bearer " .. self.clashApiSecret)
+	end
+	local curl = string.format("%s -s -g --max-time %d%s -w '\\n%%{http_code}' %s",
+		self.curlExec, sc.connection_timeout + 3, auth, self:shellQuote(url))
+	local retCode, data = self:runCommand(curl)
+	local httpCode, delay
+	if data then
+		httpCode = tonumber(data:match("(%d+)%s*$"))
+		delay    = tonumber(data:match('"delay"%s*:%s*(%d+)'))
+	end
+
+	self:debugOutput(string.format(
+		"--- Clash API ---\ntime = %s\nurl = %s\nretCode = %s\nhttp_code = %s\ndelay = %s\n",
+		os.time(), url, retCode, tostring(httpCode), tostring(delay)))
+
+	if retCode == 0 and httpCode == 200 and delay and delay > 0 then
+		return 0, delay
+	end
+	if retCode ~= 0 then
+		return 1, nil, "clash-curl:" .. tostring(retCode)
+	end
+	return 1, nil, "clash:" .. tostring(httpCode)
 end
 
