+-- 16 bytes -> text form of RFC 5952 (lower case, no leading zeros, the
+-- longest run of two or more zero groups as "::").
+function Module:formatIPv6(bytes)
+	local groups = {}
+	for i = 1, 16, 2 do
+		groups[#groups + 1] = bytes:byte(i) * 256 + bytes:byte(i + 1)
+	end
+	local bestStart, bestLen, curStart, curLen = 0, 0, 0, 0
+	for i = 1, 8 do
+		if groups[i] == 0 then
+			if curLen == 0 then
+				curStart = i
+			end
+			curLen = curLen + 1
+			if curLen > bestLen then
+				bestStart, bestLen = curStart, curLen
+			end
+		else
+			curLen = 0
+		end
 	end
+	if bestLen < 2 then
+		bestStart = 0
+	end
+	local parts, i = {}, 1
+	while i <= 8 do
+		if i == bestStart then
+			parts[#parts + 1] = (i == 1) and ":" or ""
+			i = i + bestLen
+			if i > 8 then
+				parts[#parts + 1] = ""
+			end
+		else
+			parts[#parts + 1] = string.format("%x", groups[i])
+			i = i + 1
+		end
+	end
+	return table.concat(parts, ":")
+end
+
+-- Position after a domain name (with compression pointers) or nil
+function Module:skipName(msg, pos)
+	for _ = 1, 128 do
+		local len = msg:byte(pos)
+		if not len then
+			return nil
+		elseif len == 0 then
+			return pos + 1
+		elseif len >= 192 then
+			return pos + 2
+		end
+		pos = pos + 1 + len
+	end
+	return nil
 end
 
