+	local function u16(p)
+		local a, b = message:byte(p, p + 1)
+		return a and b and (a * 256 + b)
+	end
+	if type(message) ~= "string" or #message < 12 then
+		return retTable
+	end
+	local flags = u16(3)
+	if not flags or flags % 16 ~= 0 then	-- RCODE
+		return retTable
+	end
+	local qdcount, ancount = u16(5), u16(7)
+	local pos = 13
+	for _ = 1, qdcount do
+		pos = self:skipName(message, pos)
+		if not pos then
+			return retTable
+		end
+		pos = pos + 4
+	end
+	local seen = {}
+	for _ = 1, ancount do
+		pos = pos and self:skipName(message, pos)
+		if not pos or pos + 10 > #message + 1 then
+			break
+		end
+		local rtype, rdlen = u16(pos), u16(pos + 8)
+		local rdata = message:sub(pos + 10, pos + 9 + rdlen)
+		pos = pos + 10 + rdlen
+		if #rdata == rdlen then
+			local value
+			if rtype == 1 and rdlen == 4 then
+				value = string.format("%d.%d.%d.%d", rdata:byte(1, 4))
+			elseif rtype == 28 and rdlen == 16 then
+				value = self:formatIPv6(rdata)
+			elseif rtype == 16 then
+				local t, p = {}, 1
+				while p <= #rdata do
+					local l = rdata:byte(p)
+					t[#t + 1] = rdata:sub(p + 1, p + l)
+					p = p + 1 + l
 				end
+				value = table.concat(t)
+			end
+			if value and self:isIP(value) and not seen[value] then
+				seen[value]             = true
+				retTable[#retTable + 1] = value
 			end
 		end
 	end
 	return retTable
 end
 
