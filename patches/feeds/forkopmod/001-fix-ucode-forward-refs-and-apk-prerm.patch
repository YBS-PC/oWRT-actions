diff --git a/forkop/Makefile b/forkop/Makefile
index 50b01859..0e165db2 100644
--- a/forkop/Makefile
+++ b/forkop/Makefile
@@ -40,12 +40,12 @@ define Build/Compile
 endef
 
 define Package/forkop/prerm
-#!/usr/bin/ucode
-
-if (getenv("IPKG_INSTROOT") == null || getenv("IPKG_INSTROOT") == "")
-	system("/usr/bin/forkop package_prerm " + (ARGV[0] || "") + " >/dev/null 2>&1");
-
-exit(0);
+#!/bin/sh
+# Только POSIX sh: в OpenWrt 25.12+ (apk) тело prerm встраивается в общий
+# shell-скрипт жизненного цикла пакета, и ucode-код там — синтаксическая ошибка.
+[ -n "$${IPKG_INSTROOT}" ] && exit 0
+/usr/bin/forkop package_prerm "$${1:-}" >/dev/null 2>&1
+exit 0
 endef
 
 define Package/forkop/postinst
