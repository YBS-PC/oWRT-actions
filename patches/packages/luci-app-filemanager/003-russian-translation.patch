+
+msgid "Copied."
+msgstr "Скопировано."
+
+msgid "Items already exist"
+msgstr "Такие объекты уже есть"
+
+msgid "This folder already has an item with the same name:"
+msgid_plural "This folder already has items with the same names:"
+msgstr[0] "В этой папке уже есть объект с таким именем:"
+msgstr[1] "В этой папке уже есть объекты с такими именами:"
+msgstr[2] "В этой папке уже есть объекты с такими именами:"
+
+msgid "Replace deletes the existing items (whole folders) and puts the new ones in their place."
+msgstr "«Заменить» удалит существующие объекты (папки целиком) и положит новые на их место."
+
+msgid "Replace"
+msgstr "Заменить"
+
+msgid "Open"
+msgstr "Открыть"
+
+msgid "Open in hex editor"
+msgstr "Открыть в HEX-редакторе"
+
+msgid "Download as archive"
+msgstr "Скачать архивом"
+
+msgid "Rename"
+msgstr "Переименовать"
+
+msgid "Properties"
+msgstr "Свойства"
+
+msgid "Copy path"
+msgstr "Копировать путь"
+
+msgid "Path copied."
+msgstr "Путь скопирован."
+
+msgid "Wait until the current operation finishes."
+msgstr "Дождитесь окончания текущей операции."
+
+msgid "Command failed with code %d"
+msgstr "Команда завершилась с кодом %d"
+
+msgid "The operation could not be started."
+msgstr "Не удалось запустить операцию."
+
+msgid "Cancelled."
+msgstr "Отменено."
+
+msgid "Not enough free space in /tmp: about %s needed, %s free."
+msgstr "Мало места в /tmp: нужно около %s, свободно %s."
+
+msgid "An item with this name already exists."
+msgstr "Объект с таким именем уже есть."
+
+msgid "Failed to create \"%s\": %s"
+msgstr "Не удалось создать «%s»: %s"
+
+msgid "New name"
+msgstr "Новое имя"
+
+msgid "Failed to rename \"%s\": %s"
+msgstr "Не удалось переименовать «%s»: %s"
+
+msgid "Delete this item?"
