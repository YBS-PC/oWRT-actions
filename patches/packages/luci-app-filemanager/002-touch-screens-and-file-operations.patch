+function copyText(text) {
+	if (navigator.clipboard && window.isSecureContext)
+		return navigator.clipboard.writeText(text);
+
+	const ta = E('textarea', { 'style': 'position:fixed;top:0;left:0;opacity:0' }, [ text ]);
+	document.body.appendChild(ta);
+	ta.select();
+	const ok = document.execCommand('copy');
+	ta.remove();
+	return ok ? Promise.resolve() : Promise.reject(new Error(_('The browser did not allow copying')));
+}
+
+function copyName(name, taken) {
+	const dot = name.lastIndexOf('.');
+	const ext = (dot > 0 && dot < name.length - 1) ? name.substring(dot) : '';
+	const base = ext ? name.substring(0, dot) : name;
+	let candidate = `${base} (copy)${ext}`;
+
+	for (let n = 2; taken.has(candidate); n++)
+		candidate = `${base} (copy ${n})${ext}`;
+
+	return candidate;
+}
