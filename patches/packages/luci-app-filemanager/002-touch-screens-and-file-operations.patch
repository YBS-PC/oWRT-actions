+/* --- background jobs ---------------------------------------------------- */
+
+/*
+ * Long operations (copy, move, delete of folders, archives, recursive
+ * chmod/chown) run detached from rpcd: a call of file.exec ends after 20 s
+ * in the browser and after 120 s in rpcd, a copy of a large folder takes
+ * longer. The job writes its exit code to <dir>/rc; the page polls for it.
+ * Finished jobs older than an hour and all jobs older than a day are removed
+ * when the next one starts.
+ */
+const JOB_START = `
+base=$1; shift
+now=$(date +%s)
+mkdir -p "$base" || exit 1
+for d in "$base"/job-*; do
+	[ -d "$d" ] || continue
+	t=\${d##*-}
+	case $t in ''|*[!0-9]*) continue ;; esac
+	age=$((now - t))
+	if [ $age -gt 86400 ] || { [ -e "$d/rc" ] && [ $age -gt 3600 ]; }; then rm -rf "$d"; fi
+done
+d=$(mktemp -d "$base/job-XXXXXX") || exit 1
+mv "$d" "$d-$now" || exit 1
+d=$d-$now
+setsid /bin/sh -c 'd=$1; shift; export FM_JOB="$d"; echo $$ >"$d/pid"; "$@" >"$d/out" 2>"$d/err"; echo $? >"$d/rc.tmp"; mv "$d/rc.tmp" "$d/rc"' sh "$d" "$@" </dev/null >/dev/null 2>&1 &
