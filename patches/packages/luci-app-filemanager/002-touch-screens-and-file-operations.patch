+	]);
+
+	/* preselect the name without the extension */
+	window.setTimeout(() => {
+		const dot = input.value.lastIndexOf('.');
+		input.setSelectionRange(0, dot > 0 ? dot : input.value.length);
+	}, 60);
+
+	return p.then(ok => ok ? input.value : null);
