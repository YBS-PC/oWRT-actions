+function promptName(title, label, value, check, okLabel) {
+	const input = E('input', { 'type': 'text', 'class': 'cbi-input-text', 'value': value ?? '',
+		'autocapitalize': 'off', 'autocomplete': 'off', 'spellcheck': 'false' });
