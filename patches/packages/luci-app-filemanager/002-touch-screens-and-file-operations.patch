+/* --- transfers through cgi-io ------------------------------------------ */
+
+function cgiPost(applet, body, opts) {
+	return new Promise((resolve, reject) => {
+		const xhr = new XMLHttpRequest();
+
+		xhr.open('POST', `${L.env.cgi_base}/${applet}`, true);
+
+		if (opts.responseType)
+			xhr.responseType = opts.responseType;
+
+		if (opts.onUploadProgress)
+			xhr.upload.onprogress = ev => ev.lengthComputable && opts.onUploadProgress(ev.loaded, ev.total);
+
+		if (opts.onProgress)
+			xhr.onprogress = ev => opts.onProgress(ev.loaded, ev.lengthComputable ? ev.total : 0);
+
+		xhr.onload = () => resolve(xhr);
+		xhr.onerror = () => reject(new Error(_('Network error')));
+		xhr.onabort = () => reject(Object.assign(new Error(_('Cancelled')), { cancelled: true }));
+
+		if (opts.onStart)
+			opts.onStart(xhr);
+
+		xhr.send(body);
+	});
 }
