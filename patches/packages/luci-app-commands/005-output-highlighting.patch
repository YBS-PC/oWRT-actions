 		const btnStop = E('button', { 'class': 'btn cbi-button-negative', 'hidden': '',
 			'click': ui.createHandlerFn(this, () => callStop(session.job).catch(() => {})) }, _('Stop'));
@@ -694,7 +947,10 @@ return view.extend({
