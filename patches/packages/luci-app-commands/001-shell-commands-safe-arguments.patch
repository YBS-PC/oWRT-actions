+// Copyright 2012-2022 Jo-Philipp Wich <jow@openwrt.org>
+// Licensed to the public under the Apache License 2.0.
+
+'use strict';
+
+// Helpers shared by the web controller (run, download, public links) and
+// the rpcd plugin luci.commands (background jobs), so that both build the
+// command line the same way.
+
+// Decode a given string into arguments following shell quoting rules
+// [[abc\ def "foo\"bar" abc'def']] -> [[abc def]] [[foo"bar]] [[abcdef]]
+// Nothing is expanded: $, ` and * stay as typed.
+export function parse_args(str) {
+	let args = [];
+
+	function isspace(c) {
+		if (c == 9 || c == 10 || c == 11 || c == 12 || c == 13 || c == 32)
+			return c;
+	}
+
+	function isquote(c) {
+		if (c == 34 || c == 39)
+			return c;
+	}
+
+	function isescape(c) {
+		if (c == 92)
+			return c;
+	}
+
+	// Inside double quotes a backslash only escapes " $ \ and `
+	function isdqmeta(c) {
+		if (c == 34 || c == 36 || c == 92 || c == 96)
+			return c;
+	}
+
+	// Scan substring defined by the indexes [s, e] of the string "str",
+	// perform unquoting and de-escaping on the fly and store the result
+	function unquote(start, end) {
+		let esc = false, quote = null, res = [];
+
+		for (let off = start; off < end; off++) {
+			const byte = ord(str, off);
+			const q = isquote(byte);
+			const e = isescape(byte);
+
+			if (esc) {
+				if (quote == 34 && !isdqmeta(byte) && byte != 10)
+					push(res, 92);
+
+				// backslash-newline continues the line
+				if (byte != 10)
+					push(res, byte);
+
+				esc = false;
+			}
+			else if (e && quote != 39) {
+				esc = true;
+			}
+			else if (q && quote && q == quote) {
+				quote = null;
+			}
+			else if (q && !quote) {
+				quote = q;
+			}
+			else {
+				push(res, byte);
+			}
+		}
+
+		// a lone backslash at the very end is kept
+		if (esc)
+			push(res, 92);
+
+		push(args, chr(...res));
+	}
+
+	// Find substring boundaries in "str". Ignore escaped or quoted
+	// whitespace, pass found start- and end-index for each substring
+	// to unquote()
+	let esc = false, start = null, quote = null;
+
+	for (let off = 0; off <= length(str); off++) {
+		const byte = ord(str, off);
+		const q = isquote(byte);
+		const s = isspace(byte) ?? (byte === null);
+		const e = isescape(byte);
+
+		if (esc) {
+			esc = false;
+		}
+		else if (e && quote != 39) {
+			esc = true;
+			start ??= off;
+		}
+		else if (q && quote && q == quote) {
+			quote = null;
+		}
+		else if (q && !quote) {
+			start ??= off;
+			quote = q;
+		}
+		else if (s && !quote) {
+			if (start !== null) {
+				unquote(start, off);
+				start = null;
+			}
+		}
+		else {
+			start ??= off;
+		}
+	}
+
+	// If the "quote" is still set we encountered an unfinished string
+	if (quote)
+		unquote(start, length(str));
+
+	return args;
+}
+
+export function shellquote(s) {
+	return `'${replace(s, "'", "'\\''")}'`;
+}
+
+// Whether the command refers to its positional parameters ($1 ... $9,
+// ${10}, ${1:-default}, ${#1}, $@, $*, $#) anywhere outside of single
+// quotes, i.e. where the shell expands them. "awk '{ print $1 }'" does
+// not count.
+export function uses_positional(cmd) {
+	let squote = false, dquote = false, esc = false;
+
+	for (let off = 0; off < length(cmd); off++) {
+		const c = substr(cmd, off, 1);
+
+		if (esc) {
+			esc = false;
+		}
+		else if (squote) {
+			if (c == "'")
+				squote = false;
+		}
+		else if (c == '\\') {
+			esc = true;
+		}
+		else if (c == '"') {
+			dquote = !dquote;
+		}
+		else if (c == "'" && !dquote) {
+			squote = true;
+		}
+		else if (c == '$' && match(substr(cmd, off + 1, 16), /^([1-9@*#]|\{#?([0-9]|[@*#][}:#%=+?-]))/)) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+// "$@" may be appended to a one-line command that does not end with an
+// operator or a keyword: after ";", "|", "&&" or "then" the arguments
+// would run as a command of their own.
+function appendable(cmd) {
+	cmd = rtrim(cmd);
+
+	return length(cmd) && index(cmd, '\n') < 0 &&
+		!match(cmd, /[;&|(){!]$/) &&
+		!match(cmd, /(^|[ ;&|])(do|then|else|elif|time)$/);
+}
+
+// The configured command is a piece of shell script: pipes, redirections,
+// variables and several lines work as in a terminal. User supplied
+// arguments never reach the shell parser: they become the positional
+// parameters $1, $2, ... and are appended to a one-line command as "$@"
+// unless the command uses them itself.
+export function build_script(cmd, args) {
+	let script = cmd ?? '';
+
+	if (length(args)) {
+		if (!uses_positional(script) && appendable(script))
+			script = rtrim(script) + ' "$@"';
+
+		script = `set -- ${join(' ', map(args, shellquote))}\n${script}`;
+	}
+
+	return script;
+}
+
+// The command line as shown to the user
+export function display_cmdline(cmd, args) {
+	return join(' ', [ cmd ?? '', ...map(args ?? [], shellquote) ]);
+}
+
+// File name for downloads: the first word of the command
+export function download_name(cmd) {
+	const word = match(trim(cmd ?? ''), /^[^ \t\n;|&<>()]+/)?.[0] ?? 'command';
+	const parts = split(word, '/');
+
+	return replace(parts[length(parts) - 1], /[^A-Za-z0-9_-]+/g, '.') || 'command';
+}
+
+// Control characters other than the ones a terminal handles
+// (\a \b \t \n \v \f \r and ESC of color codes) mean binary data
+export function test_binary(str) {
+	for (let off = 0, byte = ord(str); off < length(str); byte = ord(str, ++off))
+		if (byte == 0 || (byte <= 6) || (byte >= 14 && byte <= 31 && byte != 27))
+			return true;
+
+	return false;
+}
