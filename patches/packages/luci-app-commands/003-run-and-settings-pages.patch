+			const name = (ascii.length >= 3 ? ascii : session.id) || 'output';
+			const d = new Date();
+			const pad = n => (n < 10 ? '0' : '') + n;
+			const stamp = '%d%s%s-%s%s%s'.format(d.getFullYear(), pad(d.getMonth() + 1), pad(d.getDate()), pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds()));
