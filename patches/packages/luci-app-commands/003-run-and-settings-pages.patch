index 0000000..5a25d0d
--- /dev/null
+++ b/htdocs/luci-static/resources/view/commands/dashboard.js
@@ -0,0 +1,868 @@
+'use strict';
+'require view';
+'require rpc';
+'require uci';
+'require ui';
+'require dom';
+
+/*
+ * Commands run as background jobs of the rpcd plugin luci.commands: the
+ * page polls their output, so slow commands are not cut by the HTTP time
+ * limit, keep running when the page is closed and can be stopped.
+ */
+
+const callStart = rpc.declare({
+	object: 'luci.commands',
+	method: 'start',
+	params: [ 'id', 'args' ],
+	reject: true
+});
+
+const callPoll = rpc.declare({
+	object: 'luci.commands',
+	method: 'poll',
+	params: [ 'job', 'offset' ],
+	reject: true
+});
+
+const callStop = rpc.declare({
+	object: 'luci.commands',
+	method: 'stop',
+	params: [ 'job' ],
+	reject: true
+});
+
+const callJobs = rpc.declare({
+	object: 'luci.commands',
+	method: 'jobs',
+	expect: { jobs: [] }
+});
+
+const MAX_CHARS = 1500000;   /* output kept on screen, the rest via "Save" */
+const MAX_BLOCKS = 4000;
+
+const css = `
+.cmd-toolbar { display: flex; flex-wrap: wrap; gap: .5em; align-items: center; margin: .5em 0 1em; }
+.cmd-toolbar input { flex: 1 1 14em; min-width: 0; max-width: 30em; }
+.cmd-group { margin-bottom: 1.2em; }
+.cmd-group-title { cursor: pointer; user-select: none; margin: .4em 0 .6em; font-size: 1.05em; }
+.cmd-group-title::before { content: "\\25BE\\00a0"; display: inline-block; width: 1em; }
+.cmd-group.collapsed .cmd-group-title::before { content: "\\25B8\\00a0"; }
+.cmd-group.collapsed .cmd-grid { display: none; }
+.cmd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19em), 1fr)); gap: .75em; }
+.cmd-card { display: flex; flex-direction: column; gap: .45em; min-width: 0; padding: .75em .85em;
+	border: 1px solid rgba(128,128,128,.35); border-radius: 6px; background: rgba(128,128,128,.04); }
+.cmd-card[hidden], .cmd-card [hidden], .cmd-modal [hidden] { display: none !important; }
+.cmd-head { display: flex; align-items: baseline; gap: .5em; min-width: 0; }
+.cmd-name { flex: 1 1 auto; min-width: 0; font-weight: bold; overflow-wrap: anywhere; }
+.cmd-descr { font-size: .85em; opacity: .8; white-space: pre-line; overflow-wrap: anywhere; }
+.cmd-line { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
+	font-size: .8em; padding: .3em .45em; border-radius: 4px; cursor: pointer;
+	background: rgba(128,128,128,.12); white-space: pre-wrap; overflow-wrap: anywhere; }
+.cmd-line.expanded { display: block; -webkit-line-clamp: none; }
+.cmd-args input { width: 100%; box-sizing: border-box; }
+.cmd-actions { display: flex; flex-wrap: wrap; gap: .4em; margin-top: auto; }
+.cmd-actions .btn, .cmd-actions .cbi-button { margin: 0; }
+.cmd-status { flex: 0 0 auto; font-size: .8em; white-space: nowrap; padding: .1em .45em; border-radius: 1em;
+	background: rgba(128,128,128,.15); cursor: pointer; }
+.cmd-status:empty { display: none; }
+.cmd-status.ok { background: rgba(46,160,67,.2); }
+.cmd-status.fail { background: rgba(218,54,51,.2); }
+.cmd-status.run { background: rgba(31,111,235,.2); }
+.cmd-empty { opacity: .75; font-style: italic; }
+.modal.cmd-modal { width: min(70em, 96vw); max-width: 96vw; box-sizing: border-box; }
+.cmd-out-meta { display: flex; flex-wrap: wrap; gap: .3em 1em; align-items: center; font-size: .85em; margin-bottom: .4em; }
+.cmd-out-meta code { flex: 1 1 20em; min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap; cursor: pointer;
+	display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
+.cmd-out-meta code.expanded { display: block; -webkit-line-clamp: none; }
+.cmd-out-tools { display: flex; flex-wrap: wrap; gap: .3em 1.2em; font-size: .85em; margin: .3em 0; }
+.cmd-out-tools label { display: inline-flex; align-items: center; gap: .3em; cursor: pointer; }
+.cmd-out-note { font-size: .8em; opacity: .8; margin: .2em 0; }
+pre.cmd-out { margin: 0; padding: .6em .7em; min-height: 6em; max-height: 62vh; overflow: auto;
+	font-size: 12px; line-height: 1.35; background: #1e1e1e; color: #d4d4d4; border-radius: 4px;
+	white-space: pre; tab-size: 8; -webkit-text-size-adjust: 100%; }
+pre.cmd-out.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
+@media (max-width: 600px) { pre.cmd-out { max-height: 52vh; } }
+.cmd-modal .right { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4em; margin-top: .6em; }
+.cmd-modal .right .btn { margin: 0; }
+.cmd-b { font-weight: bold; } .cmd-d { opacity: .7; } .cmd-i { font-style: italic; } .cmd-u { text-decoration: underline; }
+.cmd-f0 { color: #6e7681; } .cmd-f1 { color: #f14c4c; } .cmd-f2 { color: #23d18b; } .cmd-f3 { color: #e5e510; }
+.cmd-f4 { color: #3b8eea; } .cmd-f5 { color: #d670d6; } .cmd-f6 { color: #29b8db; } .cmd-f7 { color: #e5e5e5; }
+.cmd-f8 { color: #8b949e; } .cmd-f9 { color: #ff6e6e; } .cmd-f10 { color: #5af78e; } .cmd-f11 { color: #f4f99d; }
+.cmd-f12 { color: #6cb6ff; } .cmd-f13 { color: #ff92df; } .cmd-f14 { color: #9aedfe; } .cmd-f15 { color: #ffffff; }
+.cmd-g0 { background: #000; } .cmd-g1 { background: #a3201e; } .cmd-g2 { background: #0d7a3c; } .cmd-g3 { background: #8a7a00; }
+.cmd-g4 { background: #1f4f99; } .cmd-g5 { background: #7d2e7d; } .cmd-g6 { background: #0b6f80; } .cmd-g7 { background: #9a9a9a; color: #000; }
+`;
+
+/* 0:07, 3:05, 1:02:03 */
+function clock(sec) {
+	sec = Math.max(0, Math.floor(sec || 0));
+
+	const h = Math.floor(sec / 3600), m = Math.floor(sec / 60) % 60, s = sec % 60;
+	const pad = n => (n < 10 ? '0' : '') + n;
+
+	return h ? '%d:%s:%s'.format(h, pad(m), pad(s)) : '%d:%s'.format(m, pad(s));
+}
+
+function storage(key, value) {
+	try {
+		if (value === undefined)
+			return JSON.parse(window.localStorage.getItem('luci-commands.' + key));
+
+		window.localStorage.setItem('luci-commands.' + key, JSON.stringify(value));
+	}
+	catch (e) {}
+
+	return null;
+}
+
+/*
+ * Output renderer: plain text with the parts of a terminal that command
+ * output uses — SGR colors, \r (progress lines redraw themselves), \b and
+ * erase-line; other escape sequences are dropped.
+ */
+const Terminal = L.Class.extend({
+	__init__(pre) {
+		this.pre = pre;
+		this.reset();
+	},
+
+	reset() {
+		dom.content(this.pre, null);
+		this.cur = E('span');
+		this.pre.appendChild(this.cur);
+		this.line = [];        /* segments of the current line: [ text, class, style ] */
+		this.cr = false;
+		this.pending = '';
+		this.sgr = {};
+		this.chars = 0;
+		this.blocks = [];
+		this.dropped = 0;
+		this.text = [];        /* plain text of finished lines, for "Copy" */
+		this.textlen = 0;
+	},
+
+	style() {
+		const s = this.sgr, cls = [], st = [];
+		let fg = s.fg, bg = s.bg;
+
+		if (s.inverse) {
+			[ fg, bg ] = [ bg ?? 0, fg ?? 7 ];
+		}
+
+		if (typeof(fg) == 'number')
+			cls.push('cmd-f' + ((s.bold && fg < 8) ? fg + 8 : fg));
+		else if (fg)
+			st.push('color:' + fg);
+
+		if (typeof(bg) == 'number')
+			cls.push('cmd-g' + (bg % 8));
+		else if (bg)
+			st.push('background:' + bg);
+
+		if (s.bold) cls.push('cmd-b');
+		if (s.dim) cls.push('cmd-d');
+		if (s.italic) cls.push('cmd-i');
+		if (s.underline) cls.push('cmd-u');
+
+		return [ cls.join(' '), st.join(';') ];
+	},
+
+	color256(n) {
+		if (n < 16)
+			return n;
+
+		if (n >= 232) {
+			const v = 8 + (n - 232) * 10;
+			return 'rgb(%d,%d,%d)'.format(v, v, v);
+		}
+
+		n -= 16;
+
+		const c = v => v ? 55 + v * 40 : 0;
+		return 'rgb(%d,%d,%d)'.format(c(Math.floor(n / 36)), c(Math.floor(n / 6) % 6), c(n % 6));
+	},
+
+	applySGR(params) {
+		const p = params.length ? params.split(';').map(v => +v || 0) : [ 0 ];
+		const s = this.sgr;
+
+		for (let i = 0; i < p.length; i++) {
+			const v = p[i];
+
+			if (v == 0) { for (const k in s) delete s[k]; }
+			else if (v == 1) s.bold = true;
+			else if (v == 2) s.dim = true;
+			else if (v == 3) s.italic = true;
+			else if (v == 4) s.underline = true;
+			else if (v == 7) s.inverse = true;
+			else if (v == 22) s.bold = s.dim = false;
+			else if (v == 23) s.italic = false;
+			else if (v == 24) s.underline = false;
+			else if (v == 27) s.inverse = false;
+			else if (v >= 30 && v <= 37) s.fg = v - 30;
+			else if (v >= 90 && v <= 97) s.fg = v - 90 + 8;
+			else if (v == 39) delete s.fg;
+			else if (v >= 40 && v <= 47) s.bg = v - 40;
+			else if (v >= 100 && v <= 107) s.bg = v - 100;
+			else if (v == 49) delete s.bg;
+			else if ((v == 38 || v == 48) && p[i + 1] == 5 && i + 2 < p.length) {
+				s[v == 38 ? 'fg' : 'bg'] = this.color256(p[i + 2]);
+				i += 2;
+			}
+			else if ((v == 38 || v == 48) && p[i + 1] == 2 && i + 4 < p.length) {
+				s[v == 38 ? 'fg' : 'bg'] = 'rgb(%d,%d,%d)'.format(p[i + 2], p[i + 3], p[i + 4]);
+				i += 4;
+			}
+		}
+	},
+
+	put(text) {
+		if (this.cr) {
+			this.line = [];
+			this.cr = false;
+		}
+
+		const [ cls, st ] = this.style();
+		const last = this.line[this.line.length - 1];
+
+		if (last && last[1] == cls && last[2] == st)
+			last[0] += text;
+		else
+			this.line.push([ text, cls, st ]);
+	},
+
+	backspace() {
+		const last = this.line[this.line.length - 1];
+
+		if (last) {
+			last[0] = last[0].slice(0, -1);
+
+			if (!last[0].length)
+				this.line.pop();
+		}
+	},
+
+	renderLine(frag, segs) {
+		for (const [ text, cls, st ] of segs) {
+			if (!cls && !st)
+				frag.appendChild(document.createTextNode(text));
+			else
+				frag.appendChild(E('span', { 'class': cls || null, 'style': st || null }, text));
+		}
+	},
+
+	/* feed a chunk of output; returns true when something changed */
+	feed(data) {
+		data = this.pending + data;
+		this.pending = '';
+
+		/* an escape sequence cut at the end of the chunk waits */
+		const tail = data.match(/\x1b(\[[0-9;?]*|\][^\x07\x1b]*|)$/);
+
+		if (tail) {
+			this.pending = tail[0];
+			data = data.slice(0, tail.index);
+		}
+
+		if (!data.length)
+			return false;
+
+		const frag = document.createDocumentFragment();
+		const plain = [];
+		let chars = 0;
+		const re = /\x1b\[([0-9;?]*)([@-~])|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-_]|\r\n|\r|\n|\x08|\x07|[^\x1b\r\n\x08\x07]+/g;
+		let m;
+
+		while ((m = re.exec(data)) != null) {
+			const t = m[0];
+
+			if (t == '\n' || t == '\r\n') {
+				if (this.cr)
+					this.cr = false;
+
+				this.renderLine(frag, this.line);
+				frag.appendChild(document.createTextNode('\n'));
+
+				const s = this.line.map(x => x[0]).join('');
+				plain.push(s, '\n');
+				chars += s.length + 1;
+				this.line = [];
+			}
+			else if (t == '\r') {
+				this.cr = true;
+			}
+			else if (t == '\x08') {
+				this.backspace();
+			}
+			else if (t == '\x07') {
+				/* bell */
+			}
+			else if (t.charCodeAt(0) == 27) {
+				if (m[2] == 'm' && m[1].indexOf('?') < 0)
+					this.applySGR(m[1]);
+				else if (m[2] == 'K' && this.cr) {
+					this.line = [];
+					this.cr = false;
+				}
+			}
+			else {
+				this.put(t);
+			}
+		}
+
+		if (frag.childNodes.length) {
+			const block = E('span', {}, [ frag ]);
+			this.pre.insertBefore(block, this.cur);
+			this.blocks.push([ block, chars ]);
+			this.chars += chars;
+			this.text.push(plain.join(''));
+			this.textlen += chars;
+			this.trim();
+		}
+
+		dom.content(this.cur, null);
+		this.renderLine(this.cur, this.line);
+
+		return true;
+	},
+
+	/* keep the screen light: the oldest blocks go when there are too many */
+	trim() {
+		while (this.blocks.length > 1 && (this.chars > MAX_CHARS || this.blocks.length > MAX_BLOCKS)) {
+			const [ block, chars ] = this.blocks.shift();
+
+			block.remove();
+			this.chars -= chars;
+			this.dropped += chars;
+		}
+
+		while (this.text.length > 1 && this.textlen > MAX_CHARS) {
+			this.textlen -= this.text.shift().length;
+		}
+	},
+
+	plainText() {
+		return this.text.join('') + this.line.map(x => x[0]).join('');
+	}
+});
+
+return view.extend({
+	load() {
+		return Promise.all([
+			uci.load('luci'),
+			L.resolveDefault(callJobs(), [])
+		]);
+	},
+
+	/* the latest job of every command */
+	indexJobs(jobs) {
+		const last = {};
+
+		for (const j of (Array.isArray(jobs) ? jobs : []))
+			if (!last[j.id] || (last[j.id].start ?? 0) <= (j.start ?? 0))
+				last[j.id] = j;
+
+		return last;
+	},
+
+	render([ , jobs ]) {
+		this.cards = {};
+		this.jobs = this.indexJobs(jobs);
+		this.collapsed = storage('collapsed') || {};
+
+		const commands = uci.sections('luci', 'command');
+
