+'use strict';
+'require view';
+'require form';
+'require uci';
+
+const css = `
+.cmd-cfg-descr { display: block; font-size: .85em; opacity: .8; white-space: pre-line; overflow-wrap: anywhere; }
+.cmd-cfg-line { display: block; font-size: .85em; white-space: pre-wrap; overflow-wrap: anywhere;
+	max-height: 2.8em; overflow: hidden; }
+`;
+
+return view.extend({
+	load() {
+		return uci.load('luci');
+	},
+
+	render() {
+		let m, s, o;
+
+		m = new form.Map('luci', _('Custom Commands'),
+			_('Shell commands and scripts to run from the web interface on the "Commands" tab. Drag the rows to change their order.'));
+
+		s = m.section(form.GridSection, 'command');
+		s.anonymous = true;
+		s.addremove = true;
+		s.sortable = true;
+		s.nodescriptions = true;
+		s.modaltitle = section_id => uci.get('luci', section_id, 'name') || _('Command');
+
+		o = s.option(form.Value, 'name', _('Name'),
+			_('A short name for the configured command'));
+		o.rmempty = false;
+		o.textvalue = function(section_id) {
+			const descr = uci.get('luci', section_id, 'description');
+
+			return E('div', {}, [
+				E('strong', {}, this.cfgvalue(section_id) || section_id),
+				descr ? E('small', { 'class': 'cmd-cfg-descr' }, descr) : ''
+			]);
+		};
+
+		o = s.option(form.TextValue, 'description', _('Description'),
+			_('Shown in small type under the name: what the command does, what to enter as arguments.'));
+		o.modalonly = true;
+		o.rows = 2;
+		o.wrap = true;
+		o.optional = true;
+
+		o = s.option(form.Value, 'group', _('Group'),
+			_('Commands with the same group are shown together under its heading; the groups follow the order of their first command.'));
+		o.modalonly = true;
+		o.optional = true;
+
+		for (const name of new Set(uci.sections('luci', 'command').map(c => (c.group || '').trim()).filter(g => g)))
+			o.value(name);
+
+		o = s.option(form.TextValue, 'command', _('Command'),
+			_('A shell command or a whole script: pipes, redirections, variables and several lines work as in a terminal. Arguments typed on the run page become $1, $2, …; a one-line command gets them at its end as "$@" unless it uses $1…$9 or "$@" itself.'));
+		o.rmempty = false;
+		o.monospace = true;
+		o.rows = 4;
+		o.wrap = true;
+		o.textvalue = function(section_id) {
+			return E('code', { 'class': 'cmd-cfg-line' }, this.cfgvalue(section_id) || '');
+		};
+
+		o = s.option(form.Flag, 'param', _('Custom arguments'),
+			_('Allow the user to provide additional command line arguments'));
+
+		o = s.option(form.Value, 'args_hint', _('Argument hint'),
+			_('Shown in the empty argument field, e.g. "host name or IP address".'));
+		o.modalonly = true;
+		o.optional = true;
+		o.depends('param', '1');
+
+		o = s.option(form.Value, 'args_default', _('Default arguments'),
+			_('Filled into the argument field, can be changed before the run.'));
+		o.modalonly = true;
+		o.optional = true;
+		o.depends('param', '1');
+
+		o = s.option(form.Flag, 'confirm', _('Ask before running'),
+			_('For commands such as a reboot: the run page asks for confirmation.'));
+		o.modalonly = true;
+
+		o = s.option(form.Value, 'timeout', _('Time limit'),
+			_('Seconds; the command is stopped when it runs longer. Empty: no limit, the command can be stopped by hand.'));
+		o.modalonly = true;
+		o.optional = true;
+		o.datatype = 'uinteger';
+		o.placeholder = _('no limit');
+
+		o = s.option(form.Flag, 'public', _('Public access'),
+			_('Allow executing the command and downloading its output without prior authentication'));
+
+		return m.render().then(node => {
+			node.insertBefore(E('style', {}, css), node.firstChild);
+
+			return node;
+		});
+	}
+});
diff --git a/htdocs/luci-static/resources/view/commands/dashboard.js b/htdocs/luci-static/resources/view/commands/dashboard.js
