+				'autocapitalize': 'off',
+				'autocorrect': 'off',
+				'spellcheck': 'false',
+				'enterkeyhint': 'go',
+				'placeholder': cmd.args_hint || _('Arguments'),
+				'value': cmd.args_default || '',
+				'aria-label': _('Arguments'),
+				'keydown': ev => { if (ev.key == 'Enter') { ev.preventDefault(); this.run(id); } }
+			});
+		}
+
+		const actions = [
+			E('button', {
+				'class': 'btn cbi-button cbi-button-action important',
+				'click': ui.createHandlerFn(this, 'run', id)
+			}, _('Run')),
+			E('button', {
+				'class': 'btn cbi-button cmd-show',
+				'click': ev => this.openOutput(id),
+				'hidden': this.jobs[id] ? null : ''
+			}, _('Output')),
+			E('button', {
+				'class': 'btn cbi-button cbi-button-neutral',
+				'title': _('Run the command and download its output as a file, also binary data'),
+				'click': ev => this.download(id)
+			}, _('Download'))
+		];
+
+		if (cmd.public == '1')
+			actions.push(E('button', {
+				'class': 'btn cbi-button cbi-button-neutral',
+				'click': ev => this.showLink(id)
+			}, _('Public link')));
+
+		dom.content(card, [
+			E('div', { 'class': 'cmd-head' }, [ E('span', { 'class': 'cmd-name' }, cmd.name || id), status ]),
+			cmd.description ? E('div', { 'class': 'cmd-descr' }, cmd.description) : '',
+			E('code', {
+				'class': 'cmd-line',
+				'title': _('Tap to show the whole command'),
+				'click': ev => ev.currentTarget.classList.toggle('expanded')
+			}, cmd.command || ''),
+			args ? E('div', { 'class': 'cmd-args' }, [ args ]) : '',
+			E('div', { 'class': 'cmd-actions' }, actions)
+		]);
+
+		this.cards[id] = {
+			cmd: cmd,
+			card: card,
+			status: status,
+			args: args,
+			show: actions[1],
+			search: [ cmd.name, cmd.description, cmd.command, cmd.group ].join('\n').toLowerCase()
+		};
+
+		this.updateCard(id);
+
+		return card;
+	},
+
+	filter(query) {
+		const words = (query || '').toLowerCase().split(/\s+/).filter(w => w.length);
+
+		for (const id in this.cards) {
+			const c = this.cards[id];
+			c.card.hidden = !words.every(w => c.search.indexOf(w) >= 0);
+		}
+
+		for (const node of this.groups) {
+			const any = node.querySelector('.cmd-card:not([hidden])');
+			node.style.display = any ? '' : 'none';
+
+			/* a match inside a collapsed group should be visible; without a
+			 * query the groups fold back as they were */
+			if (words.length && any)
+				node.classList.remove('collapsed');
+			else if (!words.length && node.dataset.group)
+				node.classList.toggle('collapsed', !!this.collapsed[node.dataset.group]);
+		}
+	},
+
+	toggleGroup(node, name) {
+		node.classList.toggle('collapsed');
+		this.collapsed[name] = node.classList.contains('collapsed');
+
+		if (!this.collapsed[name])
+			delete this.collapsed[name];
+
+		storage('collapsed', this.collapsed);
+	},
+
+	statusOf(j) {
+		if (!j)
+			return [ '', '' ];
+
+		const elapsed = (j.running ? (j.now - j.start) + (Date.now() / 1000 - (j.seen || Date.now() / 1000)) : (j.end ?? j.now) - j.start);
+
+		if (j.running)
+			return [ 'run', '⏳ ' + clock(elapsed) ];
+
+		if (j.interrupted)
+			return [ 'fail', '⚠ ' + _('interrupted') ];
+
+		if (j.timedout)
+			return [ 'fail', '⏱ ' + _('time limit') ];
+
+		if (j.limited && j.rc != 0)
+			return [ 'fail', '⚠ ' + _('output limit') ];
+
+		if (j.stopped)
+			return [ 'fail', '■ ' + _('stopped') ];
+
+		if (j.rc == 0)
+			return [ 'ok', '✓ ' + clock(elapsed) ];
+
+		return [ 'fail', '✗ ' + _('code %d').format(j.rc) ];
+	},
+
+	updateCard(id) {
+		const c = this.cards[id];
+
+		if (!c)
+			return;
+
+		const j = this.jobs[id];
+		const [ cls, text ] = this.statusOf(j);
+
+		c.status.className = 'cmd-status' + (cls ? ' ' + cls : '');
+		c.status.textContent = text;
+		c.show.hidden = !j;
+
+		if (j && j.start)
+			c.status.title = _('Last run: %s').format(new Date(j.start * 1000).toLocaleString());
+	},
+
+	/* card status while something runs in the background */
+	pollStatus() {
+		window.clearTimeout(this.statusTimer);
+
+		const running = Object.keys(this.jobs).some(id => this.jobs[id].running);
+
+		if (!running)
+			return;
+
+		this.statusTimer = window.setTimeout(() => {
+			L.resolveDefault(callJobs(), null).then(jobs => {
+				if (jobs) {
+					const last = this.indexJobs(jobs);
