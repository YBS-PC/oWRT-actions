+		window.clearTimeout(this.outTimer);
+
+		const session = { id: id, job: j.job, offset: 0, closed: false };
+		const pre = E('pre', { 'class': 'cmd-out' + (storage('wrap') !== false ? ' wrap' : ''), 'tabindex': '0' });
+		const term = new Terminal(pre);
+		const note = E('div', { 'class': 'cmd-out-note', 'hidden': '' });
+		const state = E('span');
+		const follow = E('input', { 'type': 'checkbox', 'checked': '' });
+		const wrap = E('input', { 'type': 'checkbox', 'checked': (storage('wrap') !== false) ? '' : null,
+			'change': ev => { pre.classList.toggle('wrap', ev.target.checked); storage('wrap', ev.target.checked); } });
+
+		const btnStop = E('button', { 'class': 'btn cbi-button-negative', 'hidden': '',
+			'click': ui.createHandlerFn(this, () => callStop(session.job).catch(() => {})) }, _('Stop'));
+		const btnCopy = E('button', { 'class': 'btn cbi-button', 'click': ev => this.copy(term, ev.currentTarget) }, _('Copy'));
+		const btnSave = E('button', { 'class': 'btn cbi-button', 'click': ui.createHandlerFn(this, 'save', session) }, _('Save'));
+		const btnAgain = E('button', { 'class': 'btn cbi-button-action', 'hidden': '',
+			'click': ev => { session.closed = true; this.run(id); } }, _('Run again'));
+		const btnClose = E('button', { 'class': 'btn', 'click': ev => { session.closed = true; window.clearTimeout(this.outTimer); ui.hideModal(); } }, _('Close'));
+
+		/* scrolling up pauses "follow", scrolling to the end resumes it */
+		pre.addEventListener('scroll', () => {
+			const atEnd = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 8;
+
+			if (atEnd != follow.checked && !session.autoscroll)
+				follow.checked = atEnd;
+
+			session.autoscroll = false;
+		});
+
+		ui.showModal(c ? (c.cmd.name || id) : id, [
+			E('div', { 'class': 'cmd-out-meta' }, [
