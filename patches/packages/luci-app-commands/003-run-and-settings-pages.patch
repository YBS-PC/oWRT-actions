+			document.body.appendChild(a);
+			a.click();
+			a.remove();
+			window.setTimeout(() => URL.revokeObjectURL(url), 10000);
+		}).catch(err => {
+			ui.addNotification(null, E('p', _('Failed to read the output: %s').format(err.message || err)), 'danger');
+		});
+	},
+
+	download(id) {
+		const args = this.argsOf(id);
+
+		location.href = L.url('admin/system/commands/download', id) + (args ? '?args=' + encodeURIComponent(args) : '');
+	},
+
+	showLink(id) {
+		const args = this.argsOf(id);
+		const base = location.protocol + '//' + location.host + L.url('command') + '/';
+		const suffix = args ? '?args=' + encodeURIComponent(args) : '';
+		const row = (label, link) => E('p', {}, [
+			label, E('br'),
+			E('a', { 'href': link, 'target': '_blank', 'rel': 'noopener', 'style': 'overflow-wrap:anywhere' }, link)
+		]);
+
+		ui.showModal(_('Public link'), [
+			E('p', {}, _('These links run the command without logging in, anyone who knows them can use them.')),
+			E('p', { 'class': 'cmd-out-note' }, _('A link changes when the command is edited or moved: the router names unnamed settings sections by their position and contents.')),
+			row(_('Download the output:'), base + id + suffix),
+			row(_('Show the output in the browser:'), base + id + 's' + suffix),
+			E('div', { 'class': 'right' }, [ E('button', { 'class': 'btn', 'click': ui.hideModal }, _('Close')) ])
+		], 'cbi-modal');
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
