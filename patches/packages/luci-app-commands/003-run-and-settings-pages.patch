+		document.body.appendChild(ta);
+		ta.select();
+
+		let ok = false;
+		try { ok = document.execCommand('copy'); } catch (e) {}
+
+		ta.remove();
+		done(ok);
+	},
+
+	/* the whole output, also the part no longer shown */
+	save(session) {
+		const parts = [];
+
+		const fetch = offset => callPoll(session.job, offset).then(st => {
+			if (!st || st.error)
+				throw new Error(st && st.error ? st.error : _('No response'));
+
+			parts.push(st.data);
+
+			return (st.offset < st.size && st.data.length) ? fetch(st.offset) : null;
+		});
+
+		return fetch(0).then(() => {
+			const c = this.cards[session.id];
+			/* browsers drop file names they dislike, keep it ASCII */
