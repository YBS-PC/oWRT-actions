+					for (const id in last) {
+						last[id].seen = Date.now() / 1000;
+						this.jobs[id] = last[id];
+						this.updateCard(id);
+					}
+				}
+
+				this.pollStatus();
+			});
+		}, 2000);
+	},
+
+	argsOf(id) {
+		const c = this.cards[id];
+
+		return (c && c.args) ? c.args.value : '';
+	},
+
+	run(id) {
+		const c = this.cards[id];
+		const go = () => callStart(id, this.argsOf(id)).then(res => {
+			if (!res || res.error || !res.job)
+				throw new Error(res && res.error ? res.error : _('No response'));
+
+			this.jobs[id] = { job: res.job, id: id, args: res.args, running: true, start: Date.now() / 1000, now: Date.now() / 1000, seen: Date.now() / 1000 };
+			this.updateCard(id);
+			this.pollStatus();
+			this.openOutput(id);
+		}).catch(err => {
+			ui.addNotification(null, E('p', _('Failed to start the command: %s').format(err.message || err)), 'danger');
+		});
+
+		if (c && c.cmd.confirm == '1') {
+			return new Promise(resolve => {
+				ui.showModal(_('Run the command?'), [
+					E('p', {}, E('strong', {}, c.cmd.name || id)),
+					E('pre', { 'style': 'white-space:pre-wrap;overflow-wrap:anywhere' },
+						[ c.cmd.command, c.args && c.args.value ? ' ' + c.args.value : '' ].join('')),
+					E('div', { 'class': 'right' }, [
+						E('button', { 'class': 'btn', 'click': ev => { ui.hideModal(); resolve(); } }, _('Cancel')),
+						' ',
+						E('button', { 'class': 'btn cbi-button-action important', 'click': ev => { ui.hideModal(); resolve(go()); } }, _('Run'))
