+		return view;
+	},
+
+	renderCard(cmd) {
+		const id = cmd['.name'];
+		const card = E('div', { 'class': 'cmd-card', 'data-id': id });
+		const status = E('span', { 'class': 'cmd-status', 'title': _('Show output'), 'click': ev => this.openOutput(id) });
