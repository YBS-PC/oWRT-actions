@@ -213,6 +213,46 @@ return view.extend({
 
 			return true;
 		}
+		const dns_server_validate = o.validate;
+
+		o = s.taboption('routing', form.ListValue, 'dns_fallback_mode', _('Backup DNS servers'),
+			_('Ask more DNS servers when the DNS server does not answer in time or answers with an error. Needs sing-box 1.14 or newer.'));
+		o.value('', _('None'));
+		o.value('fallback', _('One after another'));
+		o.value('race', _('All at once, the first answer wins'));
