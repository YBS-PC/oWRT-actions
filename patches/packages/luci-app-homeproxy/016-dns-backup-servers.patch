diff --git a/root/etc/homeproxy/scripts/generate_client.uc b/root/etc/homeproxy/scripts/generate_client.uc
index b306af1..db4ccbf 100755
--- a/root/etc/homeproxy/scripts/generate_client.uc
+++ b/root/etc/homeproxy/scripts/generate_client.uc
@@ -7,7 +7,7 @@
 
 'use strict';
 
-import { popen, readfile, writefile } from 'fs';
+import { popen, readfile, unlink, writefile } from 'fs';
 import { isnan } from 'math';
 import { connect } from 'ubus';
 import { cursor } from 'uci';
@@ -191,6 +191,8 @@ function parse_dnsserver(server_addr, default_protocol) {
 	if (!match(server_addr, /:\/\//))
 		server_addr = (default_protocol || 'udp') + '://' + (validation('ip6addr', server_addr) ? `[${server_addr}]` : server_addr);
 	server_addr = parseURL(server_addr);
+	if (!server_addr)
+		return null;
 
 	return {
 		type: server_addr.protocol,
@@ -633,6 +635,89 @@ if (!isEmpty(main_node)) {
 
 	config.dns.final = get_resolver(dns_default_server);
 }
+
+/* Backup DNS servers (sing-box 1.14+, its evaluate and respond DNS rules).
+ * What no DNS rule above answers goes to the DNS server and the backup ones:
+ * - fallback: one after another, the next one is asked when the previous
+ *   one does not answer in time or answers other than NOERROR or NXDOMAIN;
+ *   the last one answers whatever it gets;
+ * - race: all at once, the first NOERROR or NXDOMAIN answer wins; if none
+ *   comes, the DNS server answers as before.
+ * Without it (the default) the configuration is as before. */
+let dns_pool = null;
+if (config.dns.final) {
+	const custom = (routing_mode === 'custom'),
+	      pool_section = custom ? ucidnssetting : ucimain,
+	      pool_prefix = custom ? '' : 'dns_',
+	      pool_mode = uci.get(uciconfig, pool_section, pool_prefix + 'fallback_mode');
+
+	if (!(pool_mode in ['fallback', 'race'])) {
+		/* off */
+	} else if (sing_box_version && legacy_dns_cache) {
+		foreign_warn('Backup DNS servers', 'they need sing-box 1.14 or newer, only the DNS server is used');
+	} else {
+		let tags = [ config.dns.final ], servers = [];
+
+		for (let entry in (uci.get(uciconfig, pool_section, pool_prefix + 'fallback_server') || [])) {
+			let tag;
+			if (custom) {
+				tag = get_resolver(entry);
+			} else {
+				const server = parse_dnsserver((entry === 'wan') ? wan_dns : entry, 'tcp');
+				if (!server?.type || !server?.server) {
+					foreign_warn(`Backup DNS server "${entry}"`, 'not a DNS server address, left out');
+					continue;
+				}
+
+				tag = 'main-dns-' + (length(servers) + 2);
+				push(servers, {
+					tag: tag,
+					domain_resolver: {
+						server: 'default-dns',
+						strategy: (ipv6_support !== '1') ? 'ipv4_only' : null
+					},
+					detour: (uci.get(uciconfig, ucimain, 'dns_fallback_direct') === '1') ?
+						(self_mark ? 'direct-out' : null) : 'main-out',
+					...server
+				});
+			}
+			if (!(tag in tags))
+				push(tags, tag);
+		}
+
+		const timeout = `${strToInt(uci.get(uciconfig, pool_section, pool_prefix + 'fallback_timeout')) || 2}s`;
+
+		if (length(tags) < 2) {
+			foreign_warn('Backup DNS servers', 'none is set, only the DNS server is used');
+		} else {
+			let rules = [];
+			for (let i, tag in tags) {
+				if (pool_mode === 'fallback' && i === length(tags) - 1)
+					break;
+
+				push(rules, { action: 'evaluate', server: tag, tag: `dns-pool-${i + 1}`, timeout: timeout });
+				if (pool_mode === 'fallback')
+					for (let rcode in [ 'NOERROR', 'NXDOMAIN' ])
+						push(rules, { match_response: `dns-pool-${i + 1}`, response_rcode: rcode, action: 'respond' });
+			}
+			if (pool_mode === 'race')
+				for (let rcode in [ 'NOERROR', 'NXDOMAIN' ])
+					for (let i = 0; i < length(tags); i++)
+						push(rules, { match_response: `dns-pool-${i + 1}`, response_rcode: rcode, action: 'respond', race: true });
+
+			dns_pool = {
+				servers: config.dns.servers,
+				rules: config.dns.rules,
+				final: config.dns.final
+			};
+			config.dns.servers = [ ...config.dns.servers, ...servers ];
+			config.dns.rules = [ ...(config.dns.rules || []), ...rules ];
+			if (pool_mode === 'fallback')
+				config.dns.final = tags[length(tags) - 1];
+			dns_pool.message = `${join(', ', tags)}, ${pool_mode}, ${timeout} each`;
+		}
+	}
+}
 /* DNS end */
 
 /* Inbound start */
@@ -1106,4 +1191,44 @@ if (length(blocked_tags))
 		}
 
 system('mkdir -p ' + RUN_DIR);
+
+/* With the evaluate and respond rules sing-box uses its new DNS rule mode,
+ * which refuses some older DNS rules: one with a strategy (as in the bypass
+ * mainland China mode) or an IP match without match_response. So sing-box
+ * is asked: if it refuses the configuration with the backup DNS servers but
+ * not the one without them, they are left out and the log says why. */
+function sing_box_check() {
+	const bin = '/usr/bin/sing-box', file = RUN_DIR + '/sing-box-c.check.json';
+	writefile(file, sprintf('%.J\n', removeBlankAttrs(config)));
+	const fd = popen(`${bin} check -c ${file} 2>&1`);
+	const out = fd ? fd.read('all') : '';
+	const code = fd ? fd.close() : 1;
+	unlink(file);
+	if (code === 0)
+		return null;
+
+	const lines = filter(split(replace(out || '', /\x1b\[[0-9;]*m/g, ''), '\n'), (l) => length(trim(l)));
+	return replace(trim(lines[-1] || 'unknown error'), /^FATAL\[[0-9]+\] */, '');
+}
+
+if (dns_pool) {
+	const err = sing_box_check();
+	if (err) {
+		const with_pool = { servers: config.dns.servers, rules: config.dns.rules, final: config.dns.final };
+		config.dns.servers = dns_pool.servers;
+		config.dns.rules = dns_pool.rules;
+		config.dns.final = dns_pool.final;
+		if (sing_box_check() === null) {
+			foreign_warn('Backup DNS servers', `sing-box does not take them with these settings, only the DNS server is used (${err})`);
+			dns_pool = null;
+		} else {
+			config.dns.servers = with_pool.servers;
+			config.dns.rules = with_pool.rules;
+			config.dns.final = with_pool.final;
+		}
+	}
+	if (dns_pool)
+		warn(`${getTime()} [DAEMON] Backup DNS servers: ${dns_pool.message}\n`);
+}
+
 writefile(RUN_DIR + '/sing-box-c.json', sprintf('%.J\n', removeBlankAttrs(config)));
