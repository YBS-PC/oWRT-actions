+		o.value('wan', _('WAN DNS (read from interface)'));
+		o.value('1.1.1.1', _('CloudFlare Public DNS (1.1.1.1)'));
+		o.value('208.67.222.222', _('Cisco Public DNS (208.67.222.222)'));
+		o.value('8.8.8.8', _('Google Public DNS (8.8.8.8)'));
+		o.validate = function(section_id, value) {
+			for (let v of (Array.isArray(value) ? value : [ value ])) {
+				const res = v ? dns_server_validate.call(this, section_id, v) : true;
+				if (res !== true)
+					return res;
+			}
+
+			return true;
+		}
+		o.depends('dns_fallback_mode', 'fallback');
+		o.depends('dns_fallback_mode', 'race');
+
+		o = s.taboption('routing', form.Flag, 'dns_fallback_direct', _('Backup DNS servers directly'),
+			_('Ask the backup DNS servers directly, not through the main node: they also work when the main node does not, but these queries are not hidden from the provider.'));
+		o.depends('dns_fallback_mode', 'fallback');
+		o.depends('dns_fallback_mode', 'race');
+
+		o = s.taboption('routing', form.Value, 'dns_fallback_timeout', _('DNS server timeout'),
+			_('How long to wait for each DNS server, in seconds.'));
+		o.datatype = 'range(1, 30)';
+		o.placeholder = '2';
+		o.depends('dns_fallback_mode', 'fallback');
+		o.depends('dns_fallback_mode', 'race');
 
 		o = s.taboption('routing', form.Value, 'china_dns_server', _('China DNS server'),
 			_('The dns server for resolving China domains. Support UDP, TCP, DoH, DoQ, DoT.'));
@@ -891,6 +931,44 @@ return view.extend({
 		so.default = 'default-dns';
 		so.rmempty = false;
 
+		so = ss.option(form.ListValue, 'fallback_mode', _('Backup DNS servers'),
+			_('Ask more DNS servers when the default DNS server does not answer in time or answers with an error. Only for the queries no DNS rule answers. Needs sing-box 1.14 or newer; with DNS rules that set a strategy or match an IP address sing-box does not take them, the log then says so.'));
+		so.value('', _('None'));
+		so.value('fallback', _('One after another'));
+		so.value('race', _('All at once, the first answer wins'));
+
+		so = ss.option(form.DynamicList, 'fallback_server', _('Backup DNS server'),
+			_('Asked in this order, after the default DNS server.'));
+		so.load = function(section_id) {
+			delete this.keylist;
+			delete this.vallist;
+
+			this.value('default-dns', _('Default DNS (issued by WAN)'));
+			this.value('system-dns', _('System DNS'));
+			uci.sections(data[0], 'dns_server', (res) => {
+				if (res.enabled === '1')
+					this.value(res['.name'], res.label);
+			});
+
+			return this.super('load', section_id);
+		}
+		so.validate = function(section_id, value) {
+			for (let v of (Array.isArray(value) ? value : [ value ]))
+				if (section_id && v && !this.keylist.includes(v))
+					return _('Expecting: %s').format(_('a DNS server from the list'));
+
+			return true;
+		}
+		so.depends('fallback_mode', 'fallback');
+		so.depends('fallback_mode', 'race');
+
+		so = ss.option(form.Value, 'fallback_timeout', _('DNS server timeout'),
+			_('How long to wait for each DNS server, in seconds.'));
+		so.datatype = 'range(1, 30)';
+		so.placeholder = '2';
+		so.depends('fallback_mode', 'fallback');
+		so.depends('fallback_mode', 'race');
+
 		so = ss.option(form.Flag, 'disable_cache', _('Disable DNS cache'));
 
 		so = ss.option(form.Flag, 'disable_cache_expire', _('Disable cache expire'));
