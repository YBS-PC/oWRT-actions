From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 13:36:00 +0000
Subject: [PATCH] fix(client): a removed node does not stop the configuration

A node can be gone while the settings still name it: removed by hand, or
by a subscription update in the custom routing mode, which fixes the main
node but leaves the routing nodes alone. generate_client.uc then dies with
"Type error: attempt to set property on null value", no configuration is
written and homeproxy does not start.

Now:
- a URLTest group (main, main UDP, routing node) leaves such a node out;
  a group with no node left becomes a block outbound;
- the main node, the main UDP node and a routing node that name a removed
  node become a block outbound with the same tag, so rules, detours and
  DNS servers that use it stay valid and its traffic is dropped, not sent
  direct;
- each case is a line in the log with the name of the setting and of the
  node.

Without removed nodes the configuration is byte-identical to before
(13 test configurations: all routing modes, main and UDP URLTest groups,
a dedicated UDP node, WireGuard, routing nodes with detour,
domain_resolver and URLTest). Six configurations with removed nodes that
crashed before now pass "sing-box check" on 1.12.22, 1.13.21, 1.14.2 and
1.14.1-extended-2.7.2, as do all the others.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011cyCFAA9hPeqN8wsgkxbrJ
---
 root/etc/homeproxy/scripts/generate_client.uc | 86 +++++++++++++++----
 1 file changed, 67 insertions(+), 19 deletions(-)

diff --git a/root/etc/homeproxy/scripts/generate_client.uc b/root/etc/homeproxy/scripts/generate_client.uc
index c2b1621..9058130 100755
--- a/root/etc/homeproxy/scripts/generate_client.uc
+++ b/root/etc/homeproxy/scripts/generate_client.uc
@@ -13,7 +13,7 @@ import { connect } from 'ubus';
 import { cursor } from 'uci';
 
 import {
-	isEmpty, parseURL, strToBool, strToInt, strToTime,
+	getTime, isEmpty, parseURL, strToBool, strToInt, strToTime,
 	removeBlankAttrs, validation, HP_DIR, RUN_DIR
 } from 'homeproxy';
 
@@ -697,19 +697,64 @@ config.outbounds = [
 	}
 ];
 
+/* A node can be gone while settings still name it: removed by hand, or by
+ * a subscription update in the custom routing mode, which leaves the routing
+ * nodes alone. It must not stop the whole configuration: a URLTest group
+ * drops it, anything else gets a block outbound in its place, so its
+ * traffic is dropped, not sent direct, and the log says what to fix. */
+let missing_tags = [];
+
+function node_missing(user, msg) {
+	warn(`${getTime()} [DAEMON] ${user}: ${msg}, check the settings\n`);
+}
+
+function missing_outbound(tag, node, user) {
+	node_missing(user, `node "${node}" does not exist, its traffic is blocked`);
+	if (tag in missing_tags)
+		return;
+
+	push(missing_tags, tag);
+	push(config.outbounds, { type: 'block', tag: tag });
+}
+
+function existing_nodes(nodes, user) {
+	return filter(nodes || [], (k) => {
+		if (uci.get(uciconfig, k) === 'node')
+			return true;
+
+		node_missing(user, `node "${k}" does not exist and is left out`);
+		return false;
+	});
+}
+
+function urltest_outbound(tag, nodes, user, options) {
+	if (!length(nodes)) {
+		node_missing(user, 'no existing nodes, its traffic is blocked');
+		if (!(tag in missing_tags)) {
+			push(missing_tags, tag);
+			push(config.outbounds, { type: 'block', tag: tag });
+		}
+		return;
+	}
+
+	push(config.outbounds, {
+		type: 'urltest',
+		tag: tag,
+		outbounds: map(nodes, (k) => `cfg-${k}-out`),
+		...options
+	});
+}
+
 /* Main outbounds */
 if (!isEmpty(main_node)) {
 	let urltest_nodes = [];
 
 	if (main_node === 'urltest') {
-		const main_urltest_nodes = uci.get(uciconfig, ucimain, 'main_urltest_nodes') || [];
+		const main_urltest_nodes = existing_nodes(uci.get(uciconfig, ucimain, 'main_urltest_nodes'), 'Main URLTest');
 		const main_urltest_interval = uci.get(uciconfig, ucimain, 'main_urltest_interval');
 		const main_urltest_tolerance = uci.get(uciconfig, ucimain, 'main_urltest_tolerance');
 
-		push(config.outbounds, {
-			type: 'urltest',
-			tag: 'main-out',
-			outbounds: map(main_urltest_nodes, (k) => `cfg-${k}-out`),
+		urltest_outbound('main-out', main_urltest_nodes, 'Main URLTest', {
 			interval: strToTime(main_urltest_interval),
 			tolerance: strToInt(main_urltest_tolerance),
 			idle_timeout: (strToInt(main_urltest_interval) > 1800) ? `${main_urltest_interval * 2}s` : null,
@@ -717,7 +762,9 @@ if (!isEmpty(main_node)) {
 		urltest_nodes = main_urltest_nodes;
 	} else {
 		const main_node_cfg = uci.get_all(uciconfig, main_node) || {};
-		if (main_node_cfg.type === 'wireguard') {
+		if (main_node_cfg['.type'] !== 'node') {
+			missing_outbound('main-out', main_node, 'Main node');
+		} else if (main_node_cfg.type === 'wireguard') {
 			push(config.endpoints, generate_endpoint(main_node_cfg));
 			config.endpoints[length(config.endpoints)-1].tag = 'main-out';
 		} else {
@@ -727,14 +774,11 @@ if (!isEmpty(main_node)) {
 	}
 
 	if (main_udp_node === 'urltest') {
-		const main_udp_urltest_nodes = uci.get(uciconfig, ucimain, 'main_udp_urltest_nodes') || [];
+		const main_udp_urltest_nodes = existing_nodes(uci.get(uciconfig, ucimain, 'main_udp_urltest_nodes'), 'Main UDP URLTest');
 		const main_udp_urltest_interval = uci.get(uciconfig, ucimain, 'main_udp_urltest_interval');
 		const main_udp_urltest_tolerance = uci.get(uciconfig, ucimain, 'main_udp_urltest_tolerance');
 
-		push(config.outbounds, {
-			type: 'urltest',
-			tag: 'main-udp-out',
-			outbounds: map(main_udp_urltest_nodes, (k) => `cfg-${k}-out`),
+		urltest_outbound('main-udp-out', main_udp_urltest_nodes, 'Main UDP URLTest', {
 			interval: strToTime(main_udp_urltest_interval),
 			tolerance: strToInt(main_udp_urltest_tolerance),
 			idle_timeout: (strToInt(main_udp_urltest_interval) > 1800) ? `${main_udp_urltest_interval * 2}s` : null,
@@ -742,7 +786,9 @@ if (!isEmpty(main_node)) {
 		urltest_nodes = [...urltest_nodes, ...filter(main_udp_urltest_nodes, (l) => !~index(urltest_nodes, l))];
 	} else if (dedicated_udp_node) {
 		const main_udp_node_cfg = uci.get_all(uciconfig, main_udp_node) || {};
-		if (main_udp_node_cfg.type === 'wireguard') {
+		if (main_udp_node_cfg['.type'] !== 'node') {
+			missing_outbound('main-udp-out', main_udp_node, 'Main UDP node');
+		} else if (main_udp_node_cfg.type === 'wireguard') {
 			push(config.endpoints, generate_endpoint(main_udp_node_cfg));
 			config.endpoints[length(config.endpoints)-1].tag = 'main-udp-out';
 		} else {
@@ -770,20 +816,22 @@ if (!isEmpty(main_node)) {
 			return;
 
 		if (cfg.node === 'urltest') {
-			push(config.outbounds, {
-				type: 'urltest',
-				tag: 'cfg-' + cfg['.name'] + '-out',
-				outbounds: map(cfg.urltest_nodes, (k) => `cfg-${k}-out`),
+			const user = `Routing node "${cfg.label || cfg['.name']}"`;
+			const existing_urltest_nodes = existing_nodes(cfg.urltest_nodes, user);
+
+			urltest_outbound('cfg-' + cfg['.name'] + '-out', existing_urltest_nodes, user, {
 				url: cfg.urltest_url,
 				interval: strToTime(cfg.urltest_interval),
 				tolerance: strToInt(cfg.urltest_tolerance),
 				idle_timeout: strToTime(cfg.urltest_idle_timeout),
 				interrupt_exist_connections: strToBool(cfg.urltest_interrupt_exist_connections)
 			});
-			urltest_nodes = [...urltest_nodes, ...filter(cfg.urltest_nodes, (l) => !~index(urltest_nodes, l))];
+			urltest_nodes = [...urltest_nodes, ...filter(existing_urltest_nodes, (l) => !~index(urltest_nodes, l))];
 		} else {
 			const outbound = uci.get_all(uciconfig, cfg.node) || {};
-			if (outbound.type === 'wireguard') {
+			if (outbound['.type'] !== 'node') {
+				missing_outbound('cfg-' + cfg.node + '-out', cfg.node, `Routing node "${cfg.label || cfg['.name']}"`);
+			} else if (outbound.type === 'wireguard') {
 				push(config.endpoints, generate_endpoint(outbound));
 				config.endpoints[length(config.endpoints)-1].bind_interface = cfg.bind_interface;
 				config.endpoints[length(config.endpoints)-1].detour = get_outbound(cfg.outbound);
