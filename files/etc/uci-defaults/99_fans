#!/bin/sh

# Датчик вентилятора для fancontrol (GL.iNet Slate AX: фид fancontrol
# подключается только для slateax, см. sh/WRT-part1.sh). Признак пакета —
# его конфиг: так не зависит от менеджера пакетов (apk / opkg) и от формата
# их вывода.
if [ -f /etc/config/fancontrol ]; then
    uci set fancontrol.settings.fan_file='/sys/devices/virtual/thermal/cooling_device1/cur_state'
    uci commit fancontrol
    logger -t "99_fans" "Fancontrol configuration updated"
else
    logger -t "99_fans" "Fancontrol is not installed, skipping configuration"
fi

# Всегда завершаем успешно, чтобы скрипт удалился
exit 0
