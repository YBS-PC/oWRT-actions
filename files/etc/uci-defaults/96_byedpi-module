#!/bin/sh

# ByeDPI (пакет byedpi) в образе — модуль tachyon, Re:HomeProxy или forkop-mod
# (поле ytb = нет): ciadpi они запускают сами, со своими портами и
# параметрами. Отдельная служба пакета включена по умолчанию и слушает
# 0.0.0.0:1080: у forkop-mod этот порт занят его первым экземпляром ciadpi,
# tachyon и forkop-mod предупреждают о ней в журнале. Поэтому её автозапуск
# выключается; /etc/config/byedpi не меняется, службу можно включить вручную.
# В сборках без ByeDPI этого файла нет (его убирает sh/WRT-part3.sh).
[ -x /etc/init.d/byedpi ] || exit 0
if /etc/init.d/byedpi enabled; then
    /etc/init.d/byedpi stop >/dev/null 2>&1
    /etc/init.d/byedpi disable
    logger -t "96_byedpi-module" "автозапуск отдельной службы byedpi выключен"
fi
exit 0
